#!/usr/bin/env python3
"""A fake `gh`, so no test ever reaches GitHub. `gh pr view <url> --json ...` answers from `$FAKE_HERDR_DIR/prs.json`
({url: {"state": "OPEN", "reviews": [], "comments": [], "statusCheckRollup": []}}); anything else fails."""
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
prs_path = Path(os.environ.get("FAKE_HERDR_DIR", "")) / "prs.json"
prs = json.loads(prs_path.read_text()) if prs_path.is_file() else {}
if args[:2] == ["pr", "view"] and len(args) > 2 and args[2] in prs:
    print(json.dumps(prs[args[2]]))
    sys.exit(0)
print("fake gh: no such pull request or unsupported command: " + " ".join(args), file=sys.stderr)
sys.exit(1)
