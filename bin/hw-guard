#!/usr/bin/env python3
"""hw-guard — enforce the user's git rules for worker worktrees in git itself, not in prompts.

Ported from firstmate's fm-git-push-guard / fm-tangle-lib / fm-lock-lib / fm-guard. The rules (profile rules.md):
never commit to, push to, or rebase base/release/deploy branches; never force-push; commits follow
the user's format (default `TICKET-ID | Description`). Everything here is local; nothing is sent anywhere.
firstmate: Copyright (c) 2026 Kun Chen, MIT licence, see THIRD_PARTY_LICENSES.md.

Usage
  hw-guard install <worktree> [--ticket ABC-123 | --no-commit-format] [--protected a,b,...] [--repo NAME --base BRANCH]
      writes pre-commit, commit-msg and pre-push hooks into the worktree only (per-worktree core.hooksPath),
      chaining to whatever hooks the repo already uses (husky, Herdwright's own hooks/). Protected branches are the
      defaults (main master releases/*) plus --protected, plus `guard.protected` in the profile's config/settings.json, plus the
      repo's branches in profile projects.json, plus --base. `guard.commit_format` (regex) and `guard.commit_example` in the
      same file replace the default `ABC-123 | Description` format.
      Sets `extensions.worktreeConfig true` in the repo's shared config (needed for a per-worktree core.hooksPath).
      pre-commit   refuses a commit while a protected branch is checked out
      commit-msg   refuses a message not starting `<TICKET-ID> | ` (the given --ticket), or not matching the format (default `ABC-123 | `)
      pre-push     refuses pushes to protected branches, force-pushes (non-fast-forward) and branch deletion; with --gate
                   also any push of a head that lacks a clean review and qa by non-authors (`bin/hw gate check`)
  hw-guard remove <worktree>        undo install
  hw-guard audit [--primary] [--json]
                                     live sessions: hooks installed? worker on a protected/other branch? stale
                                     git locks? --primary: project clones sitting on a feature branch (worktree
                                     tangle; opt-in because the user works in their clones too and Herdwright's own
                                     clone sits on the profile branch). exit 0 clean, 1 findings
  hw-guard hook <pre-commit|commit-msg|pre-push> [args]   (called by the installed hooks)

`git push --no-verify` skips hooks; the worker rules still forbid it.
"""
import argparse
import fnmatch
import json
import os
import re
import stat
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import hwgates  # noqa: E402
import hwlib  # noqa: E402

DEFAULT_PROTECTED = ["main", "master", "releases/*"]
GENERIC_COMMIT = r"^[A-Z][A-Z0-9]*-\d+ \| \S"
SKIP_COMMIT = re.compile(r"^(Merge |Revert |fixup! |squash! |amend! )")
ZERO = "0" * 40
STALE_LOCK_SECONDS = 300
HOOKS = ("pre-commit", "commit-msg", "pre-push")


def is_protected(branch, patterns):
    return any(fnmatch.fnmatchcase(branch, p) for p in patterns)


def commit_message_problem(first_line, ticket=None, enforce=True, pattern=None, example=None):
    if not enforce or SKIP_COMMIT.match(first_line):
        return None
    prefix = f"{ticket} | " if ticket else None
    if prefix and not first_line.startswith(prefix):
        return f"commit message must start with '{prefix}' (rule: `TICKET-ID | Description`), got: {first_line!r}"
    if not prefix and not re.match(pattern or GENERIC_COMMIT, first_line):
        return f"commit message must match the commit format (e.g. {example or 'ABC-123 | Add the thing'}), got: {first_line!r}"
    return None


def push_problems(lines, patterns, is_ancestor, gate=None):
    """lines: git's pre-push stdin ('<local-ref> <local-sha> <remote-ref> <remote-sha>'); is_ancestor(old, new) -> bool;
    gate(sha) -> the reason that commit may not leave the worktree yet, or None (the merge gate: clean review and qa)."""
    problems = []
    for ln in lines:
        parts = ln.split()
        if len(parts) != 4:
            continue
        _, local_sha, remote_ref, remote_sha = parts
        branch = remote_ref.removeprefix("refs/heads/")
        if not remote_ref.startswith("refs/heads/"):
            continue  # tags etc. are not branches
        if is_protected(branch, patterns):
            problems.append(f"push to protected branch '{branch}' is forbidden (only the user merges)")
        elif local_sha == ZERO:
            problems.append(f"deleting remote branch '{branch}' is forbidden")
        elif remote_sha != ZERO and not is_ancestor(remote_sha, local_sha):
            problems.append(f"force-push to '{branch}' is forbidden (the push is not a fast-forward)")
        elif gate and (reason := gate(local_sha)):
            problems.append(f"push of '{branch}' refused: {reason}")
    return problems


def stale_lock(age_s, git_running):
    """firstmate's proof a lock is abandoned: old enough and no git process alive to own it."""
    return age_s >= STALE_LOCK_SECONDS and not git_running


# ------------------------------------------------------------------ hooks

def worktree_git(wt, *a):
    return hwlib.git(wt, *a)


def hook_dir(wt):
    return Path(worktree_git(wt, "rev-parse", "--absolute-git-dir").stdout.strip()) / "hw-hooks"


def effective_hooks_path(wt):
    """Where git looks for hooks in this worktree before we install (to chain to it)."""
    configured = worktree_git(wt, "config", "--get", "core.hooksPath").stdout.strip()
    top = worktree_git(wt, "rev-parse", "--show-toplevel").stdout.strip()
    if configured:
        return str(Path(configured) if os.path.isabs(configured) else Path(top) / configured)
    return str(Path(worktree_git(wt, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()) / "hooks")


HOOK_TEMPLATE = """#!/bin/sh
# Installed by hw-guard; `hw-guard remove` undoes it.
input=$(cat)
printf '%s\\n' "$input" | "{guard}" hook {name} "$@" || exit $?
[ -x "{chain}" ] && {{ printf '%s\\n' "$input" | "{chain}" "$@"; exit $?; }}
exit 0
"""


def cmd_install(a):
    wt = Path(a.worktree).resolve()
    if not worktree_git(wt, "rev-parse", "--git-dir").ok:
        print(f"hw-guard: {wt} is not a git worktree", file=sys.stderr)
        return 2
    patterns = list(DEFAULT_PROTECTED)
    patterns += [p for p in (a.protected or "").split(",") if p]
    rules = hwlib.settings().get("guard") or {}
    patterns += list(rules.get("protected") or [])
    if a.repo:
        patterns += list((hwlib.projects().get(a.repo) or {}).get("branches") or {})
    if a.base:
        patterns.append(a.base)
    try:
        if not isinstance(rules.get("commit_format") or "", str):
            raise re.error("must be a string")
        re.compile(rules.get("commit_format") or "")
    except re.error as e:
        print(f"hw-guard: guard.commit_format in the profile settings is not a valid regex: {e}", file=sys.stderr)
        return 2
    prev = effective_hooks_path(wt)
    d = hook_dir(wt)
    if str(d) == prev:
        cfg = read_config(wt)
        if cfg and a.gate and not cfg.get("gate"):  # the hooks stay; a refused reinstall may turn the gate on, never off
            cfg["gate"] = True
            (d / "config.json").write_text(json.dumps(cfg))
        print("hw-guard: already pointing at its own hooks; run `remove` first", file=sys.stderr)
        return 2
    d.mkdir(parents=True, exist_ok=True)
    guard = Path(__file__).resolve()
    for name in HOOKS:
        f = d / name
        f.write_text(HOOK_TEMPLATE.format(guard=guard, name=name, chain=Path(prev) / name))
        f.chmod(f.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    (d / "config.json").write_text(json.dumps(
        {"protected": patterns, "ticket": a.ticket, "commit_format": not a.no_commit_format,
         "commit_pattern": rules.get("commit_format"), "commit_example": rules.get("commit_example"), "chain": prev, "gate": a.gate}))
    worktree_git(wt, "config", "extensions.worktreeConfig", "true")  # shared repo config: set for every guarded worktree
    r = worktree_git(wt, "config", "--worktree", "core.hooksPath", str(d))
    if not r.ok:
        print(f"hw-guard: could not set core.hooksPath: {r.stderr.strip()}", file=sys.stderr)
        return 2
    print(f"installed in {wt}: hooks {', '.join(HOOKS)}; protected: {', '.join(patterns)}; chaining to {prev}")
    return 0


def cmd_remove(a):
    wt = Path(a.worktree).resolve()
    d = hook_dir(wt)
    worktree_git(wt, "config", "--worktree", "--unset", "core.hooksPath")
    for f in list(d.glob("*")) if d.exists() else []:
        f.unlink()
    if d.exists():
        d.rmdir()
    print(f"removed from {wt}")
    return 0


def read_config(wt):
    return hwlib.read_json(hook_dir(wt) / "config.json", {}) or {}


def cmd_hook(a):
    wt = Path.cwd()
    cfg = read_config(wt)
    if not cfg:
        return 0  # not installed here; never block
    if a.name == "pre-commit":
        branch = worktree_git(wt, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        if is_protected(branch, cfg["protected"]):
            print(f"hw-guard: refusing to commit on protected branch '{branch}'. Commit on your own task branch.", file=sys.stderr)
            return 1
    elif a.name == "commit-msg":
        lines = Path(a.args[0]).read_text().splitlines() if a.args and Path(a.args[0]).exists() else []
        ticket = cfg.get("ticket") or cfg.get("jira")  # "jira": the key a guard installed before the rename wrote
        msg = commit_message_problem((lines or [""])[0].strip(), ticket, cfg.get("commit_format", True),
                                     cfg.get("commit_pattern"), cfg.get("commit_example"))
        if msg:
            print(f"hw-guard: {msg}", file=sys.stderr)
            return 1
    elif a.name == "pre-push":
        anc = lambda old, new: worktree_git(wt, "merge-base", "--is-ancestor", old, new).returncode == 0
        problems = push_problems(sys.stdin.read().splitlines(), cfg["protected"], anc, (lambda sha: hwgates.gate_reason(wt, sha)) if cfg.get("gate") else None)
        for p in problems:
            print(f"hw-guard: {p}", file=sys.stderr)
        return 1 if problems else 0
    return 0


# ------------------------------------------------------------------ audit

def git_running():
    return subprocess.run(["pgrep", "-x", "git"], capture_output=True).returncode == 0


def audit_worktree(s, running, now):
    wt = Path(s["worktree"])
    tag = f"S{s['id']} {s['agent']}"
    out = []
    if not wt.exists():
        return out
    cfg = read_config(wt)
    if not cfg:
        out.append(f"{tag}: hw-guard hooks not installed")
    branch = worktree_git(wt, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    patterns = cfg.get("protected") or DEFAULT_PROTECTED
    in_place = (hwlib.projects().get(s["repo"]) or {}).get("worktrees") is False
    if not in_place:
        if is_protected(branch, patterns + [s["base"]]):
            out.append(f"{tag}: on protected branch '{branch}'")
        elif branch != s["branch"]:
            out.append(f"{tag}: on '{branch}', expected '{s['branch']}'")
    gitdir = Path(worktree_git(wt, "rev-parse", "--absolute-git-dir").stdout.strip())
    for lock in gitdir.glob("*.lock"):
        age = now - lock.stat().st_mtime
        if stale_lock(age, running):
            out.append(f"{tag}: stale lock {lock} ({int(age // 60)} min old, no git running); remove it if the worker is stuck")
    return out


def audit_primary_clones(seen):
    out = []
    for name, p in hwlib.projects().items():
        path = hwlib.expand(p.get("path", ""))
        if p.get("worktrees") is False or not (path / ".git").exists() or str(path) in seen:
            continue
        seen.add(str(path))
        branch = hwlib.git(path, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        default = p.get("dev_base")
        if default and branch not in (default, "HEAD") and not is_protected(branch, DEFAULT_PROTECTED):
            out.append(f"primary clone of {name} is on '{branch}', its dev base is '{default}' (worktree tangle? a worker may have committed here)")
    return out


def cmd_audit(a):
    conn = hwlib.db_readonly()
    findings, now, running = [], time.time(), git_running()
    rows = conn.execute("SELECT * FROM sessions WHERE status IN ('running','waiting_user','finished') AND external=0 AND base!='-'").fetchall() if conn else []
    for s in rows:
        findings += audit_worktree(dict(s), running, now)
    if a.primary:
        findings += audit_primary_clones(set())
    hwlib.emit({"findings": findings}, a.json, lambda d: hwlib.cap_lines(d["findings"], 40, 260) or ["clean: hooks installed, branches as expected, no stale locks"])
    return 1 if findings else 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="hw-guard", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    i = sub.add_parser("install")
    i.add_argument("worktree")
    g = i.add_mutually_exclusive_group()
    g.add_argument("--ticket")
    g.add_argument("--no-commit-format", action="store_true")
    i.add_argument("--protected")
    i.add_argument("--repo")
    i.add_argument("--base")
    i.add_argument("--gate", action="store_true", help="pre-push also needs `bin/hw gate check` to pass (clean review and qa at that sha)")
    sub.add_parser("remove").add_argument("worktree")
    au = sub.add_parser("audit")
    au.add_argument("--json", action="store_true")
    au.add_argument("--primary", action="store_true", help="also report project clones sitting on a non-dev-base branch")
    h = sub.add_parser("hook")
    h.add_argument("name", choices=HOOKS)
    h.add_argument("args", nargs="*")
    a = ap.parse_args(argv)
    return {"install": cmd_install, "remove": cmd_remove, "audit": cmd_audit, "hook": cmd_hook}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
