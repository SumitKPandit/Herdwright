#!/usr/bin/env python3
"""zed-xref — find every use of a symbol or path across all repos in config/projects.json, no model.

A contract change (an API field, a function, an event name, a file) shows its other consumers before it ships.
Searches each repo's working folder with `git grep` (tracked files, respects .gitignore); a repo that is not a git
folder is searched with plain grep. Read-only.

Usage
  zed-xref <symbol|path> [--repo NAME[,NAME]] [--fixed|--regex] [--max N] [--json]
      matches are grouped per repo as file:line: text. A value that looks like a path (has a '/' or a file
      extension) also lists files whose name matches it. --fixed (default) matches the text literally, --regex treats
      it as an extended regular expression. exit 0 found, 1 nothing found, 2 usage error
"""
import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedlib  # noqa: E402

PER_REPO_DEFAULT = 8
PATH_LIKE = re.compile(r"/|\.\w{1,6}$")


def grep_repo(path, pattern, regex):
    flags = ["-E"] if regex else ["-F"]
    if (Path(path) / ".git").exists():
        cmd = ["git", "-C", str(path), "grep", "-nI", "--no-color", *flags, "-e", pattern]
    else:
        cmd = ["grep", "-rnI", *flags, "-e", pattern, str(path)]
    r = zedlib.run_bounded(cmd, timeout=60)
    hits = []
    for line in r.stdout.splitlines():
        m = re.match(r"(.+?):(\d+):(.*)$", line)
        if m:
            hits.append({"file": m.group(1), "line": int(m.group(2)), "text": m.group(3).strip()[:160]})
    return hits


def files_named(path, needle):
    if not (Path(path) / ".git").exists():
        return []
    r = zedlib.run_bounded(["git", "-C", str(path), "ls-files"], timeout=30)
    return [f for f in r.stdout.splitlines() if needle in f]


def search(needle, repos, regex=False, want=None):
    """{repo: {'hits': [...], 'files': [...]}} for the repos whose folder exists and (when given) are in `want`."""
    out = {}
    for name, cfg in repos.items():
        path = zedlib.expand(cfg.get("path", ""))
        if (want and name not in want) or not path.is_dir():
            continue
        hits = grep_repo(path, needle, regex)
        files = files_named(path, needle) if PATH_LIKE.search(needle) and not regex else []
        if hits or files:
            out[name] = {"hits": hits, "files": files}
    return out


def render(found, limit):
    if not found:
        return ["not found in any repo"]
    lines = []
    for name, r in found.items():
        lines.append(f"{name}: {len(r['hits'])} match(es)" + (f", {len(r['files'])} file(s) named so" if r["files"] else ""))
        lines += [f"  file {f}" for f in r["files"][:limit]]
        lines += [f"  {h['file']}:{h['line']}: {h['text']}" for h in r["hits"][:limit]]
        more = len(r["hits"]) - limit
        if more > 0:
            lines.append(f"  ... {more} more in {name}")
    return zedlib.cap_lines(lines, limit=120)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="zed-xref", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("needle")
    ap.add_argument("--repo")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--fixed", action="store_true")
    mode.add_argument("--regex", action="store_true")
    ap.add_argument("--max", type=int, default=PER_REPO_DEFAULT)
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    repos = zedlib.projects()
    want = set(a.repo.split(",")) if a.repo else None
    if want and want - set(repos):
        print(f"zed-xref: unknown repo(s): {', '.join(sorted(want - set(repos)))}", file=sys.stderr)
        return 2
    found = search(a.needle, repos, a.regex, want)
    zedlib.emit(found, a.json, lambda d: render(d, a.max))
    return 0 if found else 1


if __name__ == "__main__":
    sys.exit(main())
