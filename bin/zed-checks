#!/usr/bin/env python3
"""zed-checks — run a repo's lint, type check and tests from its `checks` block in config/projects.json.

One command instead of remembering each repo's toolchain; prints pass/fail per check and the tail of any failure.
No model. Needs a `checks` block (ordered name -> command) on the repo in projects.json, for example:

  "checks": {"lint": "npm run lint", "types": "npx tsc --noEmit", "test": "npm test -- --run"}

A value may also be {"cmd": "...", "cwd": "subfolder", "timeout": 900}. Commands run through the shell in the repo's
folder, or in --dir (a worktree of it).

Usage
  zed-checks run <repo> [--dir PATH] [--only NAME[,NAME]] [--keep-going] [--tail N] [--timeout SEC] [--json]
      exit 0 all passed · 1 a check failed (stops at the first failure unless --keep-going) · 2 unknown repo,
      no `checks` block or bad usage
  zed-checks show <repo> [--json]
      the configured checks, without running them
"""
import argparse
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedlib  # noqa: E402

DEFAULT_TIMEOUT = 600  # per check; the Bash tool's own limit is the same


class ChecksError(Exception):
    pass


def configured(repo, repos=None):
    """The repo's checks as [{'name', 'cmd', 'cwd', 'timeout'}], in config order."""
    repos = zedlib.projects() if repos is None else repos
    if repo not in repos:
        raise ChecksError(f"unknown repo '{repo}'. Known: {', '.join(repos)}")
    block = repos[repo].get("checks")
    if not block:
        raise ChecksError(f"repo '{repo}' has no `checks` block in config/projects.json (see profile.template/config/)")
    out = []
    for name, spec in block.items():
        spec = {"cmd": spec} if isinstance(spec, str) else dict(spec)
        if not spec.get("cmd"):
            raise ChecksError(f"check '{name}' of '{repo}' has no command")
        out.append({"name": name, "cmd": spec["cmd"], "cwd": spec.get("cwd"), "timeout": spec.get("timeout")})
    return out


def run_check(check, base, default_timeout, tail):
    cwd = Path(base) / check["cwd"] if check["cwd"] else Path(base)
    started = time.monotonic()
    if not cwd.is_dir():
        return {"name": check["name"], "cmd": check["cmd"], "ok": False, "seconds": 0, "exit": None,
                "tail": [f"working directory not found: {cwd}"]}
    r = zedlib.run_bounded(["/bin/sh", "-c", check["cmd"]], timeout=check["timeout"] or default_timeout, cwd=cwd)
    lines = (r.stdout + ("\n" if r.stdout and r.stderr else "") + r.stderr).strip().splitlines()
    note = [f"timed out after {check['timeout'] or default_timeout}s"] if r.timed_out else []
    return {"name": check["name"], "cmd": check["cmd"], "ok": r.ok, "exit": r.returncode,
            "seconds": round(time.monotonic() - started, 1), "tail": note + lines[-tail:]}


def run_all(checks, base, default_timeout=DEFAULT_TIMEOUT, tail=15, keep_going=False):
    results = []
    for check in checks:
        res = run_check(check, base, default_timeout, tail)
        results.append(res)
        if not res["ok"] and not keep_going:
            break
    skipped = [c["name"] for c in checks[len(results):]]
    return {"passed": all(r["ok"] for r in results) and not skipped, "results": results, "skipped": skipped}


def render(report):
    lines = []
    for r in report["results"]:
        lines.append(f"{'PASS' if r['ok'] else 'FAIL'} {r['name']} ({r['seconds']}s): {r['cmd']}")
        if not r["ok"]:
            lines += ["    " + ln for ln in r["tail"]]
    if report["skipped"]:
        lines.append("skipped after the first failure: " + ", ".join(report["skipped"]))
    lines.append("all checks passed" if report["passed"] else "CHECKS FAILED")
    return zedlib.cap_lines(lines, limit=80)


def build_parser():
    ap = argparse.ArgumentParser(prog="zed-checks", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    run = sub.add_parser("run")
    run.add_argument("repo")
    run.add_argument("--dir")
    run.add_argument("--only")
    run.add_argument("--keep-going", action="store_true")
    run.add_argument("--tail", type=int, default=15)
    run.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    run.add_argument("--json", action="store_true")
    show = sub.add_parser("show")
    show.add_argument("repo")
    show.add_argument("--json", action="store_true")
    return ap


def main(argv=None):
    a = build_parser().parse_args(argv)
    try:
        checks = configured(a.repo)
        if a.cmd == "show":
            zedlib.emit(checks, a.json, lambda d: [f"{c['name']}: {c['cmd']}" + (f"  (in {c['cwd']})" if c["cwd"] else "") for c in d])
            return 0
        if a.only:
            wanted = a.only.split(",")
            unknown = [w for w in wanted if w not in {c["name"] for c in checks}]
            if unknown:
                raise ChecksError(f"no such check: {', '.join(unknown)}. Configured: {', '.join(c['name'] for c in checks)}")
            checks = [c for c in checks if c["name"] in wanted]
    except ChecksError as e:
        print(f"zed-checks: {e}", file=sys.stderr)
        return 2
    base = Path(a.dir).expanduser() if a.dir else zedlib.expand(zedlib.projects()[a.repo]["path"])
    report = run_all(checks, base, a.timeout, a.tail, a.keep_going)
    zedlib.emit(report, a.json, render)
    return 0 if report["passed"] else 1


if __name__ == "__main__":
    sys.exit(main())
