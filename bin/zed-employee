#!/usr/bin/env python3
"""zed-employee — what a hat session (build, review, qa) uses: its skills and `finish` (no model).

Usage
  zed-employee skill list|show <name> [--hat H]   print a skill (the hat's, then the shared ones; the hat defaults to $ZED_HAT)
  zed-employee hats                               the hats and the problems, if any, in their manifests
  zed-employee finish [--verdict clean|blockers] [--draft FILE] [--as-zed --session S<id>]
      end the session before ZED:DONE: ticks the plan's last step, stores the verdict of a review/qa with the code it
      is about (`blockers` needs the findings --draft) and records the draft for whoever fixes. Refuses an incomplete
      plan, a missing verdict, a review/qa that changed the code, a second finish. A hat session finishes only itself (known
      from its herdr pane); `--as-zed --session S<id>` is Zed's own shell finishing a stuck worker, refused in a hat session.
  zed-employee stop-guard
      the worker's Stop hook (spawn renders it into the session's settings): blocks the end of a turn that reported `done:` in
      its status file without having run `finish`; reads the hook JSON on stdin; prints {"decision":"block",...}

Exit codes: 0 ok · 1 refused (the reason is printed) · 2 usage or unknown hat
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedemployee as emp  # noqa: E402


def cmd_skill(args):
    if args.action == "list":
        print("\n".join(emp.skill_names(args.hat or os.environ.get("ZED_HAT"))))
        return
    if not args.name:
        raise emp.HatError("skill show needs a skill name")
    path = emp.skill_path(args.name, args.hat or os.environ.get("ZED_HAT"))
    if not path:
        raise emp.HatError(f"no skill {args.name!r}; try `zed-employee skill list`")
    print(path.read_text().rstrip())


def cmd_hats(args):
    bad = 0
    for hat in emp.hat_names():
        problems = emp.validate_manifest(emp.load_manifest(hat), emp.HATS / hat)
        print(f"{hat}: " + ("ok" if not problems else "; ".join(problems)))
        bad += bool(problems)
    return 1 if bad else 0


def cmd_finish(args):
    with emp.database() as conn:
        session = emp.target_session(conn, args.session, args.as_zed)
    print("\n".join(emp.finish(session, verdict=args.verdict, draft=args.draft)))


def cmd_stop_guard(args):
    """Block the end of a turn that reported done without `finish`. A second Stop in a row (stop_hook_active) is let
    through, so a worker that cannot finish is never stuck: the done path still flags it to Zed."""
    try:
        payload = json.load(sys.stdin)
        if payload.get("stop_hook_active") or not os.environ.get("ZED_HAT"):
            return 0
        reason = emp.stop_problem(os.environ.get("ZED_SESSION"))
    except Exception:  # noqa: BLE001 - fail open
        return 0
    if reason:
        print(json.dumps({"decision": "block", "reason": reason}))
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="zed-employee", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn):
        s = sub.add_parser(name)
        s.set_defaults(fn=fn)
        return s

    s = add("skill", cmd_skill)
    s.add_argument("action", choices=["list", "show"])
    s.add_argument("name", nargs="?")
    s.add_argument("--hat")
    add("hats", cmd_hats)
    add("stop-guard", cmd_stop_guard)
    s = add("finish", cmd_finish)
    s.add_argument("--verdict", choices=emp.VERDICTS)
    s.add_argument("--draft")
    s.add_argument("--session")
    s.add_argument("--as-zed", action="store_true")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args) or 0
    except emp.FinishRefused as e:
        print(f"zed-employee: refused: {e}", file=sys.stderr)
        return 1
    except emp.HatError as e:
        print(f"zed-employee: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
