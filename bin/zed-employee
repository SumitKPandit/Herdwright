#!/usr/bin/env python3
"""zed-employee — Zed's named employees: records, memory and the memory pack (no model).

An employee is files under profile/employees/<name>/, not a process. Design: docs/design/employees.md, section 5.
This is build step 2 (record + memory); `finish`, `suggest`, `board`, `report` and `postmortem` come with later steps.

Usage
  zed-employee hire <name> [--voice TEXT] [--strengths a,b] [--senior|--no-senior]
      from the roster card in templates/employees/roster/ (or a blank card with --voice); registers the DB row
  zed-employee list [--json]                      hired employees, from the files
  zed-employee show <name>                        the record and how much each memory kind holds
  zed-employee intro <name> [--record]            the introduction card; --record stamps introduced_at
  zed-employee skill list|show <name> [--hat H]   print a skill (the employee's own, the hat's, then the shared ones)
  zed-employee hats                               the hats and the problems, if any, in their manifests

  Memory (the employee defaults to $ZED_EMPLOYEE; every write goes through these):
  zed-employee remember --kind fact|preference|lesson|work|heard --src SRC [--repo R] [--hat H] [--tags a,b]
                        [--anchor TEXT] [--ttl DAYS] [-e NAME] "<text>"
      refuses: no src, a fact without an anchor that exists in the file on the repo's base branch now, over 120
      words, a secret, a duplicate. The date is stamped here; a same-src entry with different text is flagged
  zed-employee refresh <id> [--text T] [--src S] [--anchor A] [--repo R] [-e NAME]   re-check and re-stamp
  zed-employee drop <id> --reason TEXT [-e NAME]  archive an entry with the reason
  zed-employee verify --repo R [-e NAME]          anchors vs origin/<base>: marks stale, archives old work entries
  zed-employee pack [-e NAME] --repo R --hat H [--tags a,b] [--session S] [--memory-words N] [--dry-run] [--print]
      verify, then the deterministic memory pack, written to profile/.cache/employees/<name>/<session>-pack.md

Exit codes: 0 ok · 1 refused (the reason is printed) · 2 usage or unknown employee/hat
"""
import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedemployee as emp  # noqa: E402
import zedlib  # noqa: E402
import zedmem  # noqa: E402


def csv(value):
    return [v.strip() for v in value.split(",") if v.strip()] if value else []


def employee_name(args):
    name = args.employee or os.environ.get("ZED_EMPLOYEE")
    if not name:
        raise emp.EmployeeError("which employee? pass -e NAME or set ZED_EMPLOYEE")
    emp.load_employee(name)
    return name


def cmd_hire(args):
    senior = True if args.senior else False if args.no_senior else None
    emp.hire(args.name, voice=args.voice, strengths=csv(args.strengths) if args.strengths else None, senior=senior)
    print(f"hired {args.name}: {emp.employee_dir(args.name)}")


def cmd_list(args):
    rows = emp.list_employees()
    zedlib.emit(rows, args.json, lambda r: [f"{x['name']:<8} {'senior' if x['senior'] else '      '}  hired {x['hired']}  "
                                            f"memory {x['memory']}  {'introduced ' + x['introduced'] if x['introduced'] else 'not introduced'}"
                                            for x in r] or ["nobody hired"])


def cmd_show(args):
    emp.load_employee(args.name)  # unknown name -> error
    print((emp.employee_dir(args.name) / "employee.md").read_text().rstrip())
    print("\nmemory: " + ", ".join(f"{k} {v}" for k, v in emp.memory_counts(args.name).items()))


def cmd_intro(args):
    print("\n".join(emp.intro_card(args.name)))
    if args.record:
        emp.record_intro(args.name)


def cmd_skill(args):
    if args.action == "list":
        print("\n".join(emp.skill_names(args.hat)))
        return
    if not args.name:
        raise emp.EmployeeError("skill show needs a skill name")
    path = emp.skill_path(args.name, os.environ.get("ZED_EMPLOYEE"), args.hat or os.environ.get("ZED_HAT"))
    if not path:
        raise emp.EmployeeError(f"no skill {args.name!r}; try `zed-employee skill list`")
    print(path.read_text().rstrip())


def cmd_hats(args):
    bad = 0
    for hat in emp.hat_names():
        problems = emp.validate_manifest(emp.load_manifest(hat), emp.TEMPLATES / "hats" / hat)
        print(f"{hat}: " + ("ok" if not problems else "; ".join(problems)))
        bad += bool(problems)
    return 1 if bad else 0


def cmd_remember(args):
    entry = zedmem.remember(emp.employee_dir(employee_name(args)), args.kind, args.text, args.src, repo=args.repo,
                            hat=args.hat, tags=csv(args.tags), anchor=args.anchor, ttl=args.ttl)
    print(f"remembered {entry.id}" + (f" (conflicts with {entry.get('conflicts')}: merge them)" if entry.get("conflicts") else ""))


def cmd_refresh(args):
    entry = zedmem.refresh(emp.employee_dir(employee_name(args)), args.id, text=args.text, src=args.src, anchor=args.anchor)
    print(f"refreshed {entry.id} ({entry.kind})")


def cmd_drop(args):
    entry = zedmem.drop(emp.employee_dir(employee_name(args)), args.id, args.reason)
    print(f"dropped {entry.id} to archive.md")


def cmd_verify(args):
    report = zedmem.verify(emp.employee_dir(employee_name(args)), args.repo)
    print(", ".join(f"{k} {len(v)}" + (f" ({' '.join(v)})" if v and k != "ok" else "") for k, v in report.items()))
    return 1 if report["stale"] else 0


def cmd_pack(args):
    name = employee_name(args)
    text, path, used, archived = emp.make_pack(name, args.repo, args.hat, csv(args.tags), args.session, args.memory_words, args.dry_run)
    if args.dry_run:
        print(text)
        return
    print(text if args.print else f"{path} ({len(used)} entries" + (f", archived {' '.join(archived)}" if archived else "") + ")")


def build_parser():
    p = argparse.ArgumentParser(prog="zed-employee", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, **kw):
        s = sub.add_parser(name, **kw)
        s.set_defaults(fn=fn)
        return s

    def emp_arg(s):
        s.add_argument("-e", "--employee")

    s = add("hire", cmd_hire)
    s.add_argument("name")
    s.add_argument("--voice")
    s.add_argument("--strengths")
    s.add_argument("--senior", action="store_true")
    s.add_argument("--no-senior", action="store_true")
    s = add("list", cmd_list)
    s.add_argument("--json", action="store_true")
    s = add("show", cmd_show)
    s.add_argument("name")
    s = add("intro", cmd_intro)
    s.add_argument("name")
    s.add_argument("--record", action="store_true")
    s = add("skill", cmd_skill)
    s.add_argument("action", choices=["list", "show"])
    s.add_argument("name", nargs="?")
    s.add_argument("--hat")
    add("hats", cmd_hats)
    s = add("remember", cmd_remember)
    emp_arg(s)
    s.add_argument("--kind", required=True)
    s.add_argument("--src", default="")
    s.add_argument("--repo")
    s.add_argument("--hat")
    s.add_argument("--tags")
    s.add_argument("--anchor")
    s.add_argument("--ttl", type=int)
    s.add_argument("text")
    s = add("refresh", cmd_refresh)
    emp_arg(s)
    s.add_argument("id")
    s.add_argument("--text")
    s.add_argument("--src")
    s.add_argument("--anchor")
    s = add("drop", cmd_drop)
    emp_arg(s)
    s.add_argument("id")
    s.add_argument("--reason", default="")
    s = add("verify", cmd_verify)
    emp_arg(s)
    s.add_argument("--repo", required=True)
    s = add("pack", cmd_pack)
    emp_arg(s)
    s.add_argument("--repo", required=True)
    s.add_argument("--hat", required=True)
    s.add_argument("--tags")
    s.add_argument("--session")
    s.add_argument("--memory-words", type=int)
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--print", action="store_true")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args) or 0
    except zedmem.MemoryRefused as e:
        print(f"zed-employee: refused: {e}", file=sys.stderr)
        return 1
    except emp.EmployeeError as e:
        print(f"zed-employee: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
