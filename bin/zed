#!/usr/bin/env python3
"""zed — Zed's task tracker and herdr session driver.

Everything Zed knows about ongoing work lives in the user's profile: <profile>/db/zed.db (SQLite),
and <profile>/STATUS.md is regenerated from it on every write. The profile is `profile/` in Zed's
home, or $ZED_PROFILE_DIR if set (e.g. a throwaway profile for testing).

Concepts
  task     a unit of work the user asked for (usually one Jira ticket)
  session  one worker (Claude Code or GitHub Copilot CLI) running in herdr, in its own git
           worktree, on one repo
  runtime  the agent CLI a session runs on: `claude` or `copilot` (see RUNTIMES). Which ones the
           user has, their order of preference and the model policy live in
           <profile>/config/runtimes.json
  question something a worker (or Zed) needs the user to decide
  event    timestamped log line attached to a task (or global if no task)

One active Zed per profile: the agent session (either runtime) that holds the profile's lock
(<profile>/.cache/zed.lock) is Zed. Other sessions get read-only access (status, list, show);
mutating commands and `watch` refuse. See `zed lock`.

Run `zed help` for commands.
"""
import atexit
import fcntl
import json
import math
import os
import re
import shutil
import sqlite3
import statistics
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

ZED_HOME = Path(__file__).resolve().parent.parent
PROFILE_DIR = Path(os.environ.get("ZED_PROFILE_DIR") or ZED_HOME / "profile").expanduser().resolve()
DB_PATH = PROFILE_DIR / "db" / "zed.db"
STATUS_PATH = PROFILE_DIR / "STATUS.md"
PROJECTS_PATH = PROFILE_DIR / "config" / "projects.json"
CORE_WORKER_RULES = ZED_HOME / "templates" / "worker-rules.md"
PROFILE_RULES = PROFILE_DIR / "rules.md"
GENERATED_WORKER_RULES = PROFILE_DIR / ".cache" / "worker-rules.md"
LOCK_PATH = PROFILE_DIR / ".cache" / "zed.lock"
RUNTIMES_PATH = PROFILE_DIR / "config" / "runtimes.json"
MODEL_RANKING_PATH = PROFILE_DIR / "config" / "model-ranking.json"
RUNTIME_STATE_PATH = PROFILE_DIR / ".cache" / "runtime-state.json"
WATCH_STATE_PATH = PROFILE_DIR / ".cache" / "watch-state.json"
WATCHER_PID_PATH = PROFILE_DIR / ".cache" / "watch.pid"
COPILOT_INSTRUCTIONS_DIR = PROFILE_DIR / ".cache" / "copilot-instructions"

# What Zed needs to know about each agent CLI it can run on. Everything user-specific (which ones
# they have, preference order, model policy, permission mode) is in <profile>/config/runtimes.json.
RUNTIMES = {
    "claude": {
        "cli": "claude",
        "session_env": "CLAUDE_CODE_SESSION_ID",  # set in the shell of every Claude Code session
        "pid_env": "CLAUDE_PID",
        "efforts": ["low", "medium", "high", "xhigh", "max"],
        "trust_prompt": "Yes, I trust this folder",
        "trust_keys": ["down", "enter"],
        # e.g. "You've hit your session limit · resets 3pm", "Usage limit reached · continuing automatically at …"
        "limit_patterns": [r"hit your \w+ limit", r"usage limit reached", r"limit reached\b.*\breset"],
    },
    "copilot": {
        "cli": "copilot",
        "session_env": "COPILOT_AGENT_SESSION_ID",
        "pid_env": "COPILOT_LOADER_PID",
        "efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max"],
        "trust_prompt": "Do you trust the files in this folder?",
        "trust_keys": ["enter"],  # "1. Yes": trust for this session only
        # e.g. "You've been rate limited on the current model. Would you like to switch to …"
        "limit_patterns": [r"rate.limited", r"rate limit (reached|exceeded)", r"quota (reached|exceeded)",
                           r"out of (ai )?credits", r"no (remaining )?(premium requests|ai credits)"],
        "credits_pattern": r"Session: ([\d.]+) AIC used",
    },
}
PERMISSION_MODE_MENU = {"manual": "1", "assisted": "2", "allow-all": "3"}  # Copilot's /permissions dialog

TASK_STATES = ["intake", "active", "waiting_user", "in_review", "pr_open", "parked", "done", "cancelled"]
SESSION_STATES = ["running", "waiting_user", "finished", "closed"]
OPEN_TASK_STATES = ["intake", "active", "waiting_user", "in_review", "pr_open", "parked"]

SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks (
  id INTEGER PRIMARY KEY,
  title TEXT NOT NULL,
  jira TEXT,
  worktype TEXT,
  description TEXT,
  status TEXT NOT NULL DEFAULT 'intake',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS sessions (
  id INTEGER PRIMARY KEY,
  task_id INTEGER NOT NULL REFERENCES tasks(id),
  repo TEXT NOT NULL,
  base TEXT NOT NULL,
  branch TEXT NOT NULL,
  worktree TEXT NOT NULL,
  agent TEXT NOT NULL,
  workspace_id TEXT,
  pane_id TEXT,
  claude_session_id TEXT,  -- the agent CLI's own session id, whichever runtime
  pr_url TEXT,
  status TEXT NOT NULL DEFAULT 'running',
  external INTEGER NOT NULL DEFAULT 0,
  runtime TEXT NOT NULL DEFAULT 'claude',
  model TEXT,
  effort TEXT,
  brief TEXT,
  credits REAL,  -- Copilot AI credits used, as last read from the session's footer
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS questions (
  id INTEGER PRIMARY KEY,
  task_id INTEGER REFERENCES tasks(id),
  session_id INTEGER REFERENCES sessions(id),
  question TEXT NOT NULL,
  answer TEXT,
  status TEXT NOT NULL DEFAULT 'open',
  asked_at TEXT NOT NULL,
  answered_at TEXT
);
CREATE TABLE IF NOT EXISTS events (
  id INTEGER PRIMARY KEY,
  task_id INTEGER REFERENCES tasks(id),
  ts TEXT NOT NULL,
  kind TEXT NOT NULL,
  text TEXT NOT NULL
);
"""


def now():
    return datetime.now().strftime("%Y-%m-%d %H:%M")


def require_profile():
    if not (PROFILE_DIR / "profile.md").exists():
        die(f"no profile at {PROFILE_DIR}. Start `claude` or `copilot` in {ZED_HOME} to run onboarding, "
            "or set ZED_PROFILE_DIR.")


def db():
    require_profile()
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=10)  # waits up to 10s if another process is writing
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    cols = [r["name"] for r in conn.execute("PRAGMA table_info(sessions)")]
    # migrate DBs created before these columns existed
    for col, decl in [("external", "INTEGER NOT NULL DEFAULT 0"), ("runtime", "TEXT NOT NULL DEFAULT 'claude'"),
                      ("model", "TEXT"), ("effort", "TEXT"), ("brief", "TEXT"), ("credits", "REAL")]:
        if col not in cols:
            conn.execute(f"ALTER TABLE sessions ADD COLUMN {col} {decl}")
    return conn


def die(msg):
    print(f"zed: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, check=True, cwd=None):
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd)
    if check and r.returncode != 0:
        die(f"command failed: {' '.join(cmd)}\n{r.stdout}{r.stderr}")
    return r


# ---------------------------------------------------------------- lock

def ancestor_pids():
    pids, pid = [], os.getppid()
    while pid > 1 and len(pids) < 50:
        pids.append(pid)
        r = run(["ps", "-o", "ppid=", "-p", str(pid)], check=False)
        pid = int(r.stdout.strip() or 0)
    return pids


def me():
    """Identity of the agent session running this command (falls back to the parent shell).
    Env vars are inherited, so when both runtimes' vars are set, the nearest ancestor process wins."""
    found = {name: int(os.environ[rt["pid_env"]]) for name, rt in RUNTIMES.items()
             if os.environ.get(rt["pid_env"], "").isdigit()}
    runtime = None
    if len(found) > 1:
        order = ancestor_pids()
        runtime = min(found, key=lambda n: order.index(found[n]) if found[n] in order else len(order))
    elif found:
        runtime = next(iter(found))
    rt = RUNTIMES.get(runtime, {})
    return {"pane": os.environ.get("HERDR_PANE_ID"), "runtime": runtime,
            "agent_session": os.environ.get(rt["session_env"]) if rt else None,
            "pid": found.get(runtime) or os.getppid()}


def session_of(h):
    return h.get("agent_session") or h.get("claude_session")  # claude_session: locks written before runtimes


def same_holder(a, b):
    if session_of(a) and session_of(b):
        return session_of(a) == session_of(b)
    return a.get("pid") == b.get("pid")


def holder_alive(h):
    """False once the holder's process is gone, or its herdr pane is gone or runs another session."""
    try:
        os.kill(h["pid"], 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    if h.get("pane"):
        r = run(["herdr", "pane", "get", h["pane"]], check=False)
        if "pane_not_found" in r.stdout + r.stderr:
            return False
        if r.returncode == 0 and session_of(h):
            session = (json.loads(r.stdout)["result"]["pane"].get("agent_session") or {}).get("value")
            if session and session != session_of(h):
                return False
    return True


def read_lock():
    try:
        return json.loads(LOCK_PATH.read_text())
    except (FileNotFoundError, ValueError):
        return None


def holds_lock():
    h = read_lock()
    return bool(h) and same_holder(h, me())


def describe(h):
    return (f"pane {h.get('pane') or '-'}, {h.get('runtime') or 'claude'} session {session_of(h) or '-'}, "
            f"pid {h.get('pid')}, since {h.get('acquired_at')}")


def require_lock():
    if holds_lock():
        return
    h = read_lock()
    if h and holder_alive(h):
        die(f"another session is acting as Zed for this profile ({describe(h)}). This session is "
            "read-only: status/list/show work; to become Zed run `bin/zed lock acquire --take-over`.")
    die("this session doesn't hold the Zed lock for this profile; run `bin/zed lock acquire` first.")


def cmd_lock(args):
    """lock status | lock acquire [--take-over] | lock release"""
    sub = args[0] if args else "status"
    require_profile()
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK_PATH.with_suffix(".guard"), "w") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)  # serialise read-modify-write of the lock file
        h, caller = read_lock(), me()
        alive = bool(h) and holder_alive(h)
        if h and not alive and not same_holder(h, caller):
            LOCK_PATH.unlink(missing_ok=True)
            print(f"cleared stale lock ({describe(h)})")
            h = None
        if sub == "status":
            print(json.dumps({"holder": h, "holder_alive": alive if h else None,
                              "you_hold_it": bool(h) and same_holder(h, caller), "you": caller}, indent=2))
        elif sub == "acquire":
            if h and not same_holder(h, caller) and "--take-over" not in args:
                print(f"zed: the lock is held by a live session ({describe(h)}). Choose: stay read-only, "
                      "or `bin/zed lock acquire --take-over` (its watcher will exit and it must step down).",
                      file=sys.stderr)
                sys.exit(2)
            if h and same_holder(h, caller):
                print("you already hold the lock")
                return
            LOCK_PATH.write_text(json.dumps(caller | {"acquired_at": now()}, indent=2) + "\n")
            print("took over the lock from " + describe(h) if h else "acquired the lock")
        elif sub == "release":
            if not (h and same_holder(h, caller)):
                die("you don't hold the lock")
            LOCK_PATH.unlink()
            print("released the lock")
        else:
            die("lock status | lock acquire [--take-over] | lock release")


def herdr_json(args):
    r = run(["herdr", *args], check=False)
    if r.returncode != 0:
        die(f"herdr {' '.join(args)} failed:\n{r.stderr or r.stdout}")
    return json.loads(r.stdout)


# ---------------------------------------------------------------- runtimes

def runtime_config():
    """The profile's runtimes.json; a profile without one is Claude-only (as before runtimes existed)."""
    if not RUNTIMES_PATH.exists():
        return {"order": ["claude"], "runtimes": {"claude": {"enabled": True}}}
    return json.loads(RUNTIMES_PATH.read_text())


def runtime_settings(name):
    return runtime_config().get("runtimes", {}).get(name, {})


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as e:
        die(f"invalid JSON in {path}: {e}")


def runtime_state():
    return read_json(RUNTIME_STATE_PATH, {})


def runtime_report(name):
    """installed / enabled / limited for one runtime, as a dict."""
    if name not in RUNTIMES:
        die(f"unknown runtime '{name}'. Known: {', '.join(RUNTIMES)}")
    cfg = runtime_config()
    return {"runtime": name, "installed": bool(shutil.which(RUNTIMES[name]["cli"])),
            "enabled": name in cfg.get("order", []) and cfg.get("runtimes", {}).get(name, {}).get("enabled", True),
            "limited": runtime_state().get(name)}


def choose_runtime(requested="auto", exclude=()):
    """The runtime to start a session on: the one asked for, or the first usable one in the profile's order."""
    if requested and requested != "auto":
        rep = runtime_report(requested)
        if not (rep["installed"] and rep["enabled"]) or rep["limited"]:
            die(f"runtime '{requested}' is not usable here: {rep}")
        return requested
    order = [r for r in runtime_config().get("order", []) if r not in exclude]
    for name in order:
        rep = runtime_report(name)
        if rep["installed"] and rep["enabled"] and not rep["limited"]:
            return name
    die("no runtime available: " + "; ".join(json.dumps(runtime_report(n)) for n in order)
        + ". Wait for a limit to reset, or `bin/zed runtime ok <runtime>` if it already has.")


def cmd_runtime(args):
    """runtime status | runtime limited <rt> [until=<when>] [note...] | runtime ok <rt>"""
    sub = args[0] if args else "status"
    require_profile()
    if sub == "status":
        for name in RUNTIMES:
            rep = runtime_report(name)
            model, effort, why = pick_model(name)
            print(json.dumps(rep | {"model": model, "effort": effort, "model_choice": why}))
        print("order: " + " → ".join(runtime_config().get("order", [])))
        return
    if len(args) < 2:
        die("runtime limited <runtime> [until=<when>] [note...] | runtime ok <runtime>")
    name = args[1]
    runtime_report(name)
    conn = db()
    require_lock()
    state = runtime_state()
    if sub == "limited":
        until = next((a[6:] for a in args[2:] if a.startswith("until=")), None)
        note = " ".join(a for a in args[2:] if not a.startswith("until="))
        state[name] = {"since": now(), "until": until, "note": note}
        log_event(conn, None, "runtime", f"{name} limited" + (f" until {until}" if until else "") + (f": {note}" if note else ""))
    elif sub == "ok":
        state.pop(name, None)
        log_event(conn, None, "runtime", f"{name} available again")
    else:
        die(f"unknown runtime subcommand {sub}")
    RUNTIME_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    RUNTIME_STATE_PATH.write_text(json.dumps(state, indent=2) + "\n")
    conn.commit()
    write_status(conn)
    print(json.dumps(runtime_report(name)))


# ---------------------------------------------------------------- models

def norm_model(name):
    return re.sub(r"[^a-z0-9]", "", name.lower())


def available_models(runtime):
    """Model ids this runtime accepts, as {normalised: id}. The profile may pin a list per runtime."""
    pinned = runtime_settings(runtime).get("models")
    if pinned is not None:
        return {norm_model(m): m for m in pinned}
    if runtime == "copilot":  # `copilot help config` lists the models this account can use
        if not shutil.which("copilot"):
            return {}
        text = run(["copilot", "help", "config"], check=False).stdout
        section = text.split("`model`", 1)[1].split("\n\n", 1)[0] if "`model`" in text else ""
        return {norm_model(m): m for m in re.findall(r'-\s+"([^"]+)"', section)}
    if runtime == "claude":  # Claude Code has no listing; it accepts any Claude model's full name
        return None
    return {}


def runtime_model_id(runtime, model, available):
    if available is None:  # claude: Anthropic model ids use dashes (claude-opus-5-5)
        return model.replace(".", "-") if norm_model(model).startswith("claude") else None
    return available.get(norm_model(model))


def model_ranking():
    return read_json(MODEL_RANKING_PATH, None)


def pick_model(runtime):
    """(model, effort, reason) for a new session on `runtime`, per the profile's model policy.
    model/effort None = let the CLI use its own default."""
    rs = runtime_settings(runtime)
    if rs.get("model"):  # an explicit choice in the profile always wins
        return rs["model"], rs.get("effort"), "fixed in runtimes.json"
    policy = runtime_config().get("model_policy", {"method": "default"})
    method = policy.get("method", "default")
    if method == "default":
        return None, None, "CLI default (model_policy.method=default)"
    if method != "attractive-quadrant":
        die(f"unknown model_policy.method '{method}' (default | attractive-quadrant)")
    ranking = model_ranking()
    if not ranking or not ranking.get("entries"):
        return None, None, f"CLI default: no model ranking yet ({MODEL_RANKING_PATH.name}; see the `models` skill)"
    age = (datetime.now() - datetime.strptime(ranking["imported_at"][:10], "%Y-%m-%d")).days
    stale = f"; ranking is {age} days old, refresh it (`models` skill)" if age > policy.get("max_age_days", 14) else ""
    entries = [e for e in ranking["entries"] if e.get("intelligence") is not None and e.get("cost_per_task") is not None]
    available = available_models(runtime)
    offered = [(runtime_model_id(runtime, e["model"], available), e) for e in entries]
    offered = [(mid, e) for mid, e in offered if mid]
    if not offered:
        return None, None, f"CLI default: no ranked model is offered by {runtime}{stale}"

    def quadrant(population):
        # The "most attractive quadrant" of Intelligence vs Cost per task: at least the median intelligence
        # and at most the median cost of `population`. The most intelligent offered model there (cheaper on ties).
        mid_i = statistics.median(e["intelligence"] for e in population)
        mid_c = statistics.median(e["cost_per_task"] for e in population)
        inside = [(mid, e) for mid, e in offered if e["intelligence"] >= mid_i and e["cost_per_task"] <= mid_c]
        best = max(inside, key=lambda c: (c[1]["intelligence"], -c[1]["cost_per_task"]), default=None)
        return best, f"medians {mid_i:g}/{mid_c:g}"

    best, medians = quadrant(entries)
    scope = "all ranked models"
    if not best:  # none of this runtime's models is in the overall quadrant: use its own models' quadrant
        best, medians = quadrant([e for _, e in offered])
        scope = f"{runtime}'s own models (none in the overall quadrant)"
    if not best:  # still empty: the cheapest of its models with at least their median intelligence
        mid_i = statistics.median(e["intelligence"] for _, e in offered)
        best = min(((m, e) for m, e in offered if e["intelligence"] >= mid_i),
                   key=lambda c: (c[1]["cost_per_task"], -c[1]["intelligence"]))
        scope, medians = f"{runtime}'s own models (empty quadrant), cheapest at or above", f"median intelligence {mid_i:g}"
    mid, e = best
    efforts = RUNTIMES[runtime]["efforts"]
    effort = e.get("effort") if e.get("effort") in efforts else None
    cap, capped = policy.get("max_effort"), ""
    if effort and cap in efforts and efforts.index(effort) > efforts.index(cap):
        effort, capped = cap, f"; effort capped at {cap} (model_policy.max_effort)"
    return mid, effort, (f"{e.get('name', e['model'])}: intelligence {e['intelligence']}, cost/task {e['cost_per_task']} "
                         f"(quadrant of {scope}, {medians}; ranking of {ranking['imported_at'][:10]}){stale}{capped}")


def apply_ceiling(runtime, model, effort, why):
    """Enforce the profile's per-runtime ceiling ({"model", "effort"} in runtimes.json): no model that
    costs more per task than the ceiling model, no effort above the ceiling effort. Applies to overrides too."""
    ceiling = runtime_settings(runtime).get("ceiling")
    if not ceiling:
        return model, effort, why
    efforts = RUNTIMES[runtime]["efforts"]
    cap = ceiling.get("effort")
    if cap in efforts and (effort is None or efforts.index(effort) > efforts.index(cap)):
        effort, why = cap, why + f"; effort set to the ceiling ({cap})"
    if model is None:
        return ceiling["model"], effort, why + f"; model set to the ceiling ({ceiling['model']})"
    costs = {norm_model(e["model"]): e["cost_per_task"] for e in (model_ranking() or {}).get("entries", [])
             if e.get("cost_per_task") is not None}
    mine, top = costs.get(norm_model(model)), costs.get(norm_model(ceiling["model"]))
    if norm_model(model) != norm_model(ceiling["model"]) and (mine is None or top is None or mine > top):
        die(f"{model} is not known to cost less per task than the ceiling {ceiling['model']} "
            f"(runtimes.json {runtime}.ceiling); refusing to spawn")
    return model, effort, why


def cmd_models(args):
    """models show | models import <ranking.json>"""
    sub = args[0] if args else "show"
    require_profile()
    if sub == "show":
        r = model_ranking()
        print(f"ranking: {MODEL_RANKING_PATH} " + (f"({len(r.get('entries', []))} entries, imported {r.get('imported_at')}, "
                                                  f"source: {r.get('source')})" if r else "(none)"))
        print("policy: " + json.dumps(runtime_config().get("model_policy", {"method": "default"})))
        for name in runtime_config().get("order", []):
            print(f"{name}: " + json.dumps(dict(zip(("model", "effort", "reason"), pick_model(name)))))
    elif sub == "import":
        if len(args) < 2:
            die("models import <ranking.json>")
        require_lock()
        data = json.loads(Path(args[1]).read_text())
        for e in data.get("entries", []):
            missing = [k for k in ("model", "intelligence", "cost_per_task") if k not in e]
            if missing:
                die(f"ranking entry {e} lacks {missing}")
            if not isinstance(e["model"], str) or not e["model"].strip():
                die("ranking entries need a non-empty model id")
            for k in ("intelligence", "cost_per_task"):
                if (type(e[k]) not in (int, float) or not math.isfinite(e[k]) or e[k] < 0):
                    die(f"ranking entry {e['model']} needs a finite, non-negative number for {k}")
            if e.get("effort") and not any(e["effort"] in rt["efforts"] for rt in RUNTIMES.values()):
                die(f"unknown reasoning effort '{e['effort']}' for {e['model']}")
        if not data.get("entries"):
            die("ranking has no entries")
        data["imported_at"] = datetime.now().strftime("%Y-%m-%d %H:%M")
        MODEL_RANKING_PATH.parent.mkdir(parents=True, exist_ok=True)
        MODEL_RANKING_PATH.write_text(json.dumps(data, indent=2) + "\n")
        print(f"imported {len(data['entries'])} entries")
        cmd_models(["show"])
    else:
        die("models show | models import <ranking.json>")


def projects():
    if not PROJECTS_PATH.exists():
        die(f"{PROJECTS_PATH} is missing; add the user's repos there (see profile.template/config/).")
    return json.loads(PROJECTS_PATH.read_text())


def project(repo):
    p = projects()["repos"].get(repo)
    if not p:
        die(f"unknown repo '{repo}'. Known: {', '.join(projects()['repos'])}")
    return p


def expand(path):
    return Path(os.path.expandvars(os.path.expanduser(path)))


def parse_kv(args):
    out = {}
    for a in args:
        if "=" not in a:
            die(f"expected key=value, got '{a}'")
        k, v = a.split("=", 1)
        out[k] = v
    return out


def log_event(conn, task_id, kind, text):
    conn.execute("INSERT INTO events(task_id, ts, kind, text) VALUES (?,?,?,?)", (task_id, now(), kind, text))


def touch_task(conn, task_id):
    conn.execute("UPDATE tasks SET updated_at=? WHERE id=?", (now(), task_id))


def get_task(conn, tid):
    t = conn.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
    if not t:
        die(f"no task {tid}")
    return t


def resolve_session(conn, ref):
    """Session by numeric id or agent name."""
    if str(ref).isdigit():
        s = conn.execute("SELECT * FROM sessions WHERE id=?", (int(ref),)).fetchone()
    else:
        s = conn.execute("SELECT * FROM sessions WHERE agent=? ORDER BY id DESC", (ref,)).fetchone()
    if not s:
        die(f"no session '{ref}'")
    return s


# ---------------------------------------------------------------- status

def live_agents():
    r = run(["herdr", "agent", "list"], check=False)
    if r.returncode != 0:
        return {}
    try:
        agents = json.loads(r.stdout)["result"]["agents"]
    except (ValueError, KeyError):
        return {}
    return {a["pane_id"]: a for a in agents}


STALL_MINUTES = 30          # running with no plan progress for this long → watch event
USAGE_ALERT_OUTPUT = 500_000  # report every time a Claude session passes another multiple of this many output tokens


def note_session_id(conn, s, a):
    """Remember the agent CLI's own session id (needed to find its transcript after it closes)."""
    sid = (a or {}).get("agent_session", {}).get("value")
    if sid and s["claude_session_id"] != sid:
        conn.execute("UPDATE sessions SET claude_session_id=? WHERE id=?", (sid, s["id"]))
        return sid
    return s["claude_session_id"]


def claude_usage(worktree, sid):
    """Tokens a Claude Code session used, including its sub-agents and workflows, from its transcripts
    (~/.claude/projects/<cwd>/<sid>.jsonl and <sid>/**). None if not found."""
    if not worktree or not sid:
        return None
    root = Path.home() / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(worktree)) / sid
    files = [root.with_suffix(".jsonl")] + sorted(root.glob("**/*.jsonl"))
    if not files[0].exists():
        return None
    total, seen = {"output": 0, "input": 0, "cache_read": 0, "cache_write": 0}, set()
    for f in files:
        for line in f.read_text(errors="replace").splitlines():
            try:
                r = json.loads(line)
            except ValueError:
                continue
            m = r.get("message")
            u = m.get("usage") if isinstance(m, dict) else None
            if not u or (m.get("id"), r.get("requestId")) in seen:
                continue
            seen.add((m.get("id"), r.get("requestId")))
            total["output"] += u.get("output_tokens") or 0
            total["input"] += u.get("input_tokens") or 0
            total["cache_read"] += u.get("cache_read_input_tokens") or 0
            total["cache_write"] += u.get("cache_creation_input_tokens") or 0
    return total


def fmt_usage(u):
    return (f"{u['output'] / 1e6:.2f}M output, {(u['input'] + u['cache_write']) / 1e6:.1f}M input, "
            f"{u['cache_read'] / 1e6:.0f}M cache-read tokens")


def plan_files(task_id):
    return sorted((PROFILE_DIR / "briefs").glob(f"T{task_id}-*-plan.md"))


def render_status(conn, live=None):
    live = live if live is not None else live_agents()
    lines = ["# Zed status", "", f"_Generated {now()} from the task DB (`bin/zed status`). Do not edit by hand._", ""]

    open_q = conn.execute(
        "SELECT q.*, t.jira, t.title FROM questions q LEFT JOIN tasks t ON t.id=q.task_id "
        "WHERE q.status='open' ORDER BY q.id").fetchall()
    lines.append("## Waiting on you")
    lines.append("")
    if open_q:
        for q in open_q:
            tag = f"T{q['task_id']} {q['jira'] or ''}".strip() if q["task_id"] else "general"
            lines.append(f"- **Q{q['id']}** ({tag}, asked {q['asked_at']}): {q['question']}")
    else:
        lines.append("- Nothing.")
    lines.append("")

    def task_block(t):
        out = [f"### T{t['id']} · {t['jira'] or 'no-jira'} · {t['title']}",
               f"- status: **{t['status']}** · worktype: {t['worktype'] or '-'} · updated {t['updated_at']}"]
        if t["description"]:
            out.append(f"- {t['description']}")
        credits = conn.execute("SELECT SUM(credits) FROM sessions WHERE task_id=?", (t["id"],)).fetchone()[0]
        if credits is not None:
            out.append(f"- Copilot AI credits used: {credits:g}")
        for s in conn.execute("SELECT * FROM sessions WHERE task_id=? ORDER BY id", (t["id"],)):
            state = s["status"]
            if s["status"] in ("running", "waiting_user") and s["pane_id"]:
                a = live.get(s["pane_id"])
                state += f" / agent {a['agent_status']}" if a else " / agent NOT FOUND"
            pr = f" · PR {s['pr_url']}" if s["pr_url"] else ""
            ext = " (external)" if s["external"] else ""
            rt = f" · {s['runtime']}" + (f" {s['model']}" if s["model"] else "") + (f" ({s['effort']})" if s["effort"] else "")
            credits = f" · {s['credits']:g} AI credits" if s["credits"] is not None else ""
            if s["runtime"] == "claude":
                u = claude_usage(s["worktree"], s["claude_session_id"])
                credits += f" · {fmt_usage(u)}" if u else ""
            out.append(f"- S{s['id']}{ext} `{s['agent']}` {s['repo']} `{s['branch']}` ← `{s['base']}` · {state}{rt}{credits}{pr}")
        for plan in plan_files(t["id"]):
            done, todo = plan_progress(plan)
            out.append(f"- plan `{plan.name}`: {done}/{done + todo} steps done")
        last = conn.execute("SELECT * FROM events WHERE task_id=? ORDER BY id DESC LIMIT 3", (t["id"],)).fetchall()
        for e in reversed(last):
            out.append(f"  - {e['ts']} [{e['kind']}] {e['text']}")
        out.append("")
        return out

    for header, states in [("In progress", ["active", "waiting_user", "in_review"]),
                           ("PR open", ["pr_open"]),
                           ("Not started / parked", ["intake", "parked"])]:
        rows = conn.execute(
            f"SELECT * FROM tasks WHERE status IN ({','.join('?'*len(states))}) ORDER BY id", states).fetchall()
        lines.append(f"## {header}")
        lines.append("")
        if not rows:
            lines.append("- None.")
            lines.append("")
        for t in rows:
            lines.extend(task_block(t))

    done = conn.execute(
        "SELECT * FROM tasks WHERE status IN ('done','cancelled') ORDER BY updated_at DESC LIMIT 20").fetchall()
    lines.append("## Recently finished")
    lines.append("")
    if not done:
        lines.append("- None.")
    for t in done:
        prs = [s["pr_url"] for s in conn.execute("SELECT pr_url FROM sessions WHERE task_id=? AND pr_url IS NOT NULL", (t["id"],))]
        credits = conn.execute("SELECT SUM(credits) FROM sessions WHERE task_id=?", (t["id"],)).fetchone()[0]
        lines.append(f"- T{t['id']} {t['jira'] or ''} {t['title']} — {t['status']} {t['updated_at']}"
                     + (f" · {credits:g} Copilot AI credits" if credits is not None else "")
                     + (f" — {', '.join(prs)}" if prs else ""))
    lines.append("")
    return "\n".join(lines)


def write_status(conn):
    if holds_lock():  # read-only sessions never write
        STATUS_PATH.write_text(render_status(conn))


# ---------------------------------------------------------------- commands

def cmd_task(args):
    if not args:
        die("task add|set|show|list")
    sub, rest = args[0], args[1:]
    conn = db()
    if sub in ("add", "set"):
        require_lock()
    if sub == "add":
        kv = parse_kv(rest)
        if "title" not in kv:
            die("task add title=... [jira=<ticket-id>] [worktype=<e.g. story>] [description=...] [status=intake]")
        ts = now()
        cur = conn.execute(
            "INSERT INTO tasks(title,jira,worktype,description,status,created_at,updated_at) VALUES (?,?,?,?,?,?,?)",
            (kv["title"], kv.get("jira"), kv.get("worktype"), kv.get("description"), kv.get("status", "intake"), ts, ts))
        log_event(conn, cur.lastrowid, "created", kv["title"])
        print(f"T{cur.lastrowid}")
    elif sub == "set":
        tid, kv = int(rest[0].lstrip("T")), parse_kv(rest[1:])
        get_task(conn, tid)
        for k, v in kv.items():
            if k not in ("title", "jira", "worktype", "description", "status"):
                die(f"cannot set '{k}' on a task")
            if k == "status" and v not in TASK_STATES:
                die(f"status must be one of {TASK_STATES}")
            conn.execute(f"UPDATE tasks SET {k}=? WHERE id=?", (v, tid))
            log_event(conn, tid, "update", f"{k} → {v}")
        touch_task(conn, tid)
    elif sub == "show":
        tid = int(rest[0].lstrip("T"))
        t = get_task(conn, tid)
        print(json.dumps(dict(t), indent=2))
        print("sessions:")
        for s in conn.execute("SELECT * FROM sessions WHERE task_id=?", (tid,)):
            print("  " + json.dumps(dict(s)))
        print("questions:")
        for q in conn.execute("SELECT * FROM questions WHERE task_id=?", (tid,)):
            print(f"  Q{q['id']} [{q['status']}] {q['question']}" + (f"\n     → {q['answer']}" if q["answer"] else ""))
        print("events:")
        for e in conn.execute("SELECT * FROM events WHERE task_id=? ORDER BY id", (tid,)):
            print(f"  {e['ts']} [{e['kind']}] {e['text']}")
    elif sub == "list":
        allrows = "--all" in rest
        q = "SELECT * FROM tasks" + ("" if allrows else f" WHERE status IN ({','.join('?'*len(OPEN_TASK_STATES))})") + " ORDER BY id"
        for t in conn.execute(q, () if allrows else OPEN_TASK_STATES):
            print(f"T{t['id']:<4} {t['status']:<13} {t['jira'] or '-':<10} {t['title']}")
    else:
        die(f"unknown task subcommand {sub}")
    conn.commit()
    write_status(conn)


def cmd_log(args):
    if len(args) < 2:
        die("log <task-id|-> <text> [kind=note]")
    conn = db()
    require_lock()
    tid = None if args[0] == "-" else int(args[0].lstrip("T"))
    kind = "note"
    text_parts = []
    for a in args[1:]:
        if a.startswith("kind="):
            kind = a[5:]
        else:
            text_parts.append(a)
    log_event(conn, tid, kind, " ".join(text_parts))
    if tid:
        touch_task(conn, tid)
    conn.commit()
    write_status(conn)


def add_question(conn, tid, sid, text):
    """Record an open question for the user; marks the task and session as waiting on them."""
    cur = conn.execute("INSERT INTO questions(task_id,session_id,question,asked_at) VALUES (?,?,?,?)",
                       (tid, sid, text, now()))
    if tid:
        log_event(conn, tid, "question", f"Q{cur.lastrowid}: {text}")
        conn.execute("UPDATE tasks SET status='waiting_user' WHERE id=? AND status='active'", (tid,))
        touch_task(conn, tid)
    if sid:
        conn.execute("UPDATE sessions SET status='waiting_user', updated_at=? WHERE id=?", (now(), sid))
    return cur.lastrowid


def cmd_q(args):
    if not args:
        die("q add <task-id|-> <question> [session=S] | q answer <qid> <answer> | q list")
    sub, rest = args[0], args[1:]
    conn = db()
    if sub in ("add", "answer"):
        require_lock()
    if sub == "add":
        tid = None if rest[0] == "-" else int(rest[0].lstrip("T"))
        sid = None
        parts = []
        for a in rest[1:]:
            if a.startswith("session="):
                sid = int(a[8:].lstrip("S"))
            else:
                parts.append(a)
        print(f"Q{add_question(conn, tid, sid, ' '.join(parts))}")
    elif sub == "answer":
        qid = int(rest[0].lstrip("Q"))
        ans = " ".join(rest[1:])
        q = conn.execute("SELECT * FROM questions WHERE id=?", (qid,)).fetchone()
        if not q:
            die(f"no question {qid}")
        conn.execute("UPDATE questions SET answer=?, status='answered', answered_at=? WHERE id=?", (ans, now(), qid))
        if q["task_id"]:
            log_event(conn, q["task_id"], "answer", f"Q{qid}: {ans}")
            touch_task(conn, q["task_id"])
            still_open = conn.execute("SELECT COUNT(*) FROM questions WHERE task_id=? AND status='open'", (q["task_id"],)).fetchone()[0]
            if not still_open:
                conn.execute("UPDATE tasks SET status='active' WHERE id=? AND status='waiting_user'", (q["task_id"],))
        if q["session_id"]:
            still_open = conn.execute("SELECT COUNT(*) FROM questions WHERE session_id=? AND status='open'", (q["session_id"],)).fetchone()[0]
            if not still_open:
                conn.execute("UPDATE sessions SET status='running', updated_at=? WHERE id=? AND status='waiting_user'", (now(), q["session_id"]))
    elif sub == "list":
        for q in conn.execute("SELECT * FROM questions WHERE status='open' ORDER BY id"):
            print(f"Q{q['id']} T{q['task_id']} S{q['session_id']} {q['asked_at']}: {q['question']}")
    else:
        die(f"unknown q subcommand {sub}")
    conn.commit()
    write_status(conn)


def slugify(s, n=40):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:n].strip("-")


def worker_rules():
    """Core worker rules + the profile's rules.md, with {{ZED_HOME}} / {{PROFILE}} filled in."""
    text = CORE_WORKER_RULES.read_text()
    if PROFILE_RULES.exists():
        text += "\n\n" + PROFILE_RULES.read_text()
    text = text.replace("{{ZED_HOME}}", str(ZED_HOME)).replace("{{PROFILE}}", str(PROFILE_DIR))
    GENERATED_WORKER_RULES.parent.mkdir(parents=True, exist_ok=True)
    GENERATED_WORKER_RULES.write_text(text)
    # Copilot has no system-prompt flag; it loads *.instructions.md from COPILOT_CUSTOM_INSTRUCTIONS_DIRS.
    COPILOT_INSTRUCTIONS_DIR.mkdir(parents=True, exist_ok=True)
    (COPILOT_INSTRUCTIONS_DIR / "zed-worker.instructions.md").write_text(text)
    return GENERATED_WORKER_RULES


def runtime_launch(runtime, agent, model, effort):
    """(env for the herdr workspace, CLI arguments) to start a worker on `runtime`."""
    rules = worker_rules()
    model_args = (["--model", model] if model else [])
    if runtime == "claude":
        # --add-dir: workers read their brief, rules and knowledge from the profile outside their worktree.
        return [], ["--permission-mode", "auto", "-n", agent, "--append-system-prompt-file", str(rules),
                    "--add-dir", str(PROFILE_DIR), *model_args, *(["--effort", effort] if effort else [])]
    rs = runtime_settings("copilot")
    # Interactive mode, never autopilot: in autopilot Copilot answers its own questions with a guess.
    # --experimental: needed for Assisted Permissions (selected after start, see set_copilot_permissions).
    # --add-dir: Copilot limits file access to the worktree; workers read their brief and knowledge
    # in the profile and use Zed's tools (e.g. bin/bb).
    return [f"COPILOT_CUSTOM_INSTRUCTIONS_DIRS={COPILOT_INSTRUCTIONS_DIR}"], [
        "--mode", "interactive", "--experimental", "-n", agent, "--add-dir", str(PROFILE_DIR), "--add-dir", str(ZED_HOME),
        *model_args,
        *(["--reasoning-effort", effort] if effort else []),
        *[f"--allow-tool={a}" for a in rs.get("allow_tools", [])],
        *[f"--deny-tool={d}" for d in rs.get("deny_tools", [])]]


def set_copilot_permissions(agent):
    """Switch a fresh Copilot session to the profile's permission mode via its /permissions dialog
    (Assisted can't be chosen by flag in interactive mode). Returns an error string, or None."""
    mode = runtime_settings("copilot").get("permission_mode", "assisted")
    labels = {"manual": "Manual Approval", "assisted": "Assisted Permissions", "allow-all": "Allow All"}
    if mode not in labels:
        return f"unknown copilot permission_mode '{mode}' ({', '.join(labels)})"
    r = run(["herdr", "agent", "prompt", agent, "/permissions"], check=False)
    if r.returncode:
        return f"could not open /permissions: {r.stderr or r.stdout}"
    for _ in range(30):
        screen = read_screen(agent)
        if all(label in screen for label in labels.values()):
            break
        time.sleep(0.2)
    else:
        return "the /permissions menu did not appear"
    r = run(["herdr", "agent", "send-keys", agent, PERMISSION_MODE_MENU[mode]], check=False)
    if r.returncode:
        return f"could not select {labels[mode]}: {r.stderr or r.stdout}"
    for _ in range(30):
        screen = read_screen(agent)
        # The menu itself contains every label; only accept the selected mode in the footer.
        footer = "\n".join(screen.strip().splitlines()[-4:])
        if labels[mode] in footer and not all(label in screen for label in labels.values()):
            return None
        time.sleep(0.2)
    return f"could not switch to {labels[mode]}; footer: {footer!r}"


def prompt_worker(agent, text):
    before = herdr_json(["agent", "get", agent])["result"]["agent"].get("state_change_seq", 0)
    r = run(["herdr", "agent", "prompt", agent, text,
             "--wait", "--until", "working", "--until", "blocked", "--timeout", "30000"], check=False)
    if r.returncode == 0:
        return True, ""
    if "agent_prompt_stalled" in r.stderr:
        # Herdr's five-second activity gate can expire before Copilot starts its first turn.
        # Observe activity/completion without ever submitting the same brief a second time.
        for _ in range(40):
            a = herdr_json(["agent", "get", agent])["result"]["agent"]
            if a["agent_status"] in ("working", "blocked") or (a.get("state_change_seq") or 0) > (before or 0):
                return True, ""
            time.sleep(0.25)
    return False, r.stderr or r.stdout


def worktree_path(repo, branch):
    return expand(projects()["worktree_root"]) / repo / slugify(branch.split("/")[-1], 60)


FILL = re.compile(r"<FILL\b[^>\n]*>")  # what `zed brief` leaves for the model to write; spawn refuses it


def knowledge_qa_notes(repo, limit=30):
    """How to run and log in, from the repo's knowledge file: its QA/login/run/test sections, capped."""
    path = PROFILE_DIR / "knowledge" / "repos" / f"{repo}.md"
    if not path.exists():
        return f"no notes yet at {path}; ask Zed if unclear"
    keep, on = [], False
    for line in path.read_text().splitlines():
        if line.startswith("#"):
            on = bool(re.search(r"\b(qa|log ?in|run|test|setup|start)", line, re.I))
        if on:
            keep.append(line)
    if not keep:
        return f"see {path}"
    return f"from {path}:\n" + "\n".join(keep[:limit]) + (f"\n… ({len(keep) - limit} more lines in the file)" if len(keep) > limit else "")


def cmd_brief(args):
    """brief <T> repo= base= branch= [force] — scaffold profile/briefs/T<id>-<repo>.md from the task, projects.json,
    the repo's knowledge file and the plan block. The model writes only what is marked <FILL: …>."""
    if not args:
        die("brief <T> repo=<repo> base=<branch> branch=<branch> [force]")
    tid = int(args[0].lstrip("T"))
    kv = parse_kv([a for a in args[1:] if a != "force"])
    for k in ("repo", "base", "branch"):
        if k not in kv:
            die(f"brief needs {k}=")
    conn = db()
    t = get_task(conn, tid)
    p = project(kv["repo"])
    out = PROFILE_DIR / "briefs" / f"T{tid}-{kv['repo']}.md"
    if out.exists() and "force" not in args:
        die(f"{out} exists; pass `force` to overwrite it")
    worktree = expand(p["path"]) if p.get("worktrees") is False else worktree_path(kv["repo"], kv["branch"])
    values = {"TASK": tid, "JIRA": t["jira"] or "no ticket", "TITLE": t["title"], "REPO": kv["repo"],
              "ROLE": p.get("role", "-"), "WORKTREE": worktree, "BRANCH": kv["branch"], "BASE": kv["base"],
              "TICKET": f"{t['jira']} — read it for full details; ask Zed if you can't reach it" if t["jira"] else "none",
              "QA_ENV": knowledge_qa_notes(kv["repo"]), "PLAN_FILE": PROFILE_DIR / "briefs" / f"T{tid}-{kv['repo']}-plan.md"}
    text = (ZED_HOME / "templates" / "brief.md").read_text()
    for k, v in values.items():
        text = text.replace("{{" + k + "}}", str(v))
    if t["description"]:
        text = text.replace("<FILL: what the user wants, in their words where possible>",
                            f"{t['description']}\n<FILL: anything the task description above leaves out, or \"nothing\">")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text)
    print(f"{out}\nfill these, then spawn:")
    for n, line in enumerate(text.splitlines(), 1):
        if FILL.search(line):
            print(f"  line {n}: {FILL.search(line).group(0)}")


def cmd_spawn(args, worktree=None):
    """spawn <task-id> repo=<repo> base=<branch> branch=<branch> brief=<path> [name=<agent>]
    [runtime=auto|claude|copilot] [model=] [effort=] [handoff=<note>]"""
    if not args:
        die("spawn <task-id> repo=... base=... branch=... brief=<file> [name=...] [runtime=auto|claude|copilot] "
            "[model=] [effort=] [from=] [handoff=<note>]")
    tid = int(args[0].lstrip("T"))
    kv = parse_kv(args[1:])
    for k in ("repo", "base", "branch", "brief"):
        if k not in kv:
            die(f"spawn needs {k}=")
    conn = db()
    require_lock()
    t = get_task(conn, tid)
    p = project(kv["repo"])
    repo_path = expand(p["path"])
    brief = Path(kv["brief"]).resolve()
    if not brief.exists():
        die(f"brief not found: {brief}")
    left = FILL.findall(brief.read_text())
    if left:
        die(f"brief {brief.name} still has {len(left)} unfilled placeholder(s), e.g. {left[0]}; fill them before spawning")
    missing = [h for h in ("## Plan", "## Definition of done") if h not in brief.read_text()]
    if missing:
        die(f"brief {brief.name} lacks {', '.join(missing)} (templates/brief.md); no worker starts without a plan")
    runtime = choose_runtime(kv.get("runtime", "auto"))
    model, effort, model_why = pick_model(runtime)
    if "model" in kv:  # the policy's effort belongs to the policy's model
        model, effort, model_why = kv["model"], kv.get("effort"), "given to spawn"
    elif "effort" in kv:
        effort, model_why = kv["effort"], model_why + "; effort given to spawn"
    if effort and effort not in RUNTIMES[runtime]["efforts"]:
        die(f"invalid effort '{effort}' for {runtime}: {RUNTIMES[runtime]['efforts']}")
    model, effort, model_why = apply_ceiling(runtime, model, effort, model_why)
    if runtime == "copilot" and runtime_settings(runtime).get("permission_mode", "assisted") not in PERMISSION_MODE_MENU:
        die("copilot permission_mode must be manual, assisted or allow-all")

    agent = kv.get("name") or f"t{tid}-{slugify(kv['repo'], 12)}"
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", agent):
        die(f"bad agent name '{agent}'")
    reuse_worktree = worktree is not None
    if reuse_worktree and not worktree.is_dir():
        die(f"handoff worktree is missing: {worktree}")
    worktree = worktree or worktree_path(kv["repo"], kv["branch"])

    # 1. worktree (projects with "worktrees": false, e.g. plain doc folders, run in place)
    if p.get("worktrees") is False:
        if not reuse_worktree:
            worktree = repo_path
    elif worktree.exists():
        print(f"reusing existing worktree {worktree}")
    else:
        worktree.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "-C", str(repo_path), "fetch", "origin", kv["base"]])
        branch_exists = run(["git", "-C", str(repo_path), "rev-parse", "--verify", "--quiet", kv["branch"]], check=False).returncode == 0
        if branch_exists:
            run(["git", "-C", str(repo_path), "worktree", "add", str(worktree), kv["branch"]])
        else:
            start = kv.get("from", f"origin/{kv['base']}")
            run(["git", "-C", str(repo_path), "worktree", "add", "-b", kv["branch"], str(worktree), start])
        # Don't let the new branch track the base branch; worker pushes with -u.
        run(["git", "-C", str(worktree), "branch", "--unset-upstream"], check=False)
    if p.get("worktrees") is not False:
        actual = run(["git", "-C", str(worktree), "branch", "--show-current"]).stdout.strip()
        if actual != kv["branch"]:
            die(f"worktree {worktree} is on '{actual}', not '{kv['branch']}'; left untouched")

    # 2. herdr workspace + agent CLI
    require_lock()
    env, cli_args = runtime_launch(runtime, agent, model, effort)
    label = f"T{tid} {t['jira'] or ''} {kv['repo']}".strip()
    ws = herdr_json(["workspace", "create", "--cwd", str(worktree), "--label", label, "--no-focus",
                     *[a for e in env for a in ("--env", e)]])["result"]
    ws_id, pane_id = ws["workspace"]["workspace_id"], ws["root_pane"]["pane_id"]
    time.sleep(1.5)  # let the shell reach its prompt
    r = run(["herdr", "agent", "start", agent, "--kind", runtime, "--pane", pane_id, "--timeout", "60000",
             "--", *cli_args], check=False)
    if r.returncode != 0 and "agent_not_ready" in r.stderr:
        # A fresh worktree triggers the CLI's folder-trust dialog. Zed created this worktree
        # from a configured repo, so accept it; anything else stays blocked for Zed to inspect.
        screen = run(["herdr", "agent", "read", agent, "--source", "visible"], check=False).stdout
        if RUNTIMES[runtime]["trust_prompt"] in screen:  # the pane was opened with cwd=worktree
            run(["herdr", "agent", "send-keys", agent, *RUNTIMES[runtime]["trust_keys"]], check=False)
            r = run(["herdr", "agent", "wait", agent, "--until", "idle", "--timeout", "60000"], check=False)
    perm_error = set_copilot_permissions(agent) if runtime == "copilot" and r.returncode == 0 else None
    ts = now()
    cur = conn.execute(
        "INSERT INTO sessions(task_id,repo,base,branch,worktree,agent,workspace_id,pane_id,status,runtime,model,effort,"
        "brief,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
        (tid, kv["repo"], kv["base"], kv["branch"], str(worktree), agent, ws_id, pane_id, "running",
         runtime, model, effort, str(brief), ts, ts))
    sid = cur.lastrowid
    conn.execute("UPDATE tasks SET status='active' WHERE id=? AND status IN ('intake','parked')", (tid,))
    log_event(conn, tid, "spawn", f"S{sid} {agent} on {kv['repo']} {kv['branch']} ← {kv['base']} ({worktree}); "
              f"{runtime} model {model or 'default'} effort {effort or 'default'} ({model_why})")
    touch_task(conn, tid)
    conn.commit()
    write_status(conn)
    if r.returncode != 0:
        die(f"S{sid}: agent start did not report ready (pane {pane_id}). Inspect with: herdr agent read {agent}\n{r.stderr}")
    if perm_error:
        die(f"S{sid}: {perm_error}. The worker hasn't been given its brief; inspect with: herdr agent read {agent}")

    # 3. hand over the brief
    require_lock()
    text = (f"You are the engineering worker, NOT the Zed coordinator, for session S{sid} / task T{tid}. "
            f"Do not onboard, acquire the coordinator lock, or change the coordinator's task database. "
            f"Zed's home is {ZED_HOME}; the user's profile is {PROFILE_DIR}. "
            f"Read your worker rules at {GENERATED_WORKER_RULES} and your brief at {brief}, then "
            f"{PROFILE_DIR}/knowledge/repos/{kv['repo']}.md if it exists. ")
    if kv.get("handoff"):
        text += (f"You are taking over from an earlier session that stopped (see the handoff note at "
                 f"{Path(kv['handoff']).resolve()}): read it, check the worktree's git state, and continue "
                 f"from where it stopped; don't redo finished work. ")
    prompt_ok, prompt_error = prompt_worker(agent, text + "Then start.")
    print(json.dumps({"task": f"T{tid}", "session": f"S{sid}", "agent": agent, "pane": pane_id,
                      "workspace": ws_id, "worktree": str(worktree), "runtime": runtime, "model": model,
                      "effort": effort, "model_choice": model_why, "prompt_ok": prompt_ok}))
    if not prompt_ok:
        die(f"S{sid}: brief submission did not report activity; inspect before retrying:\n{prompt_error}")
    return sid


def cmd_session(args):
    if not args:
        die("session set <S|agent> key=value... | session list")
    sub, rest = args[0], args[1:]
    conn = db()
    if sub == "set":
        require_lock()
        s = resolve_session(conn, rest[0].lstrip("S") if rest[0].startswith("S") and rest[0][1:].isdigit() else rest[0])
        for k, v in parse_kv(rest[1:]).items():
            if k not in ("status", "pr_url", "claude_session_id", "pane_id", "workspace_id", "base", "brief"):
                die(f"cannot set '{k}' on a session")
            if k == "status" and v not in SESSION_STATES:
                die(f"status must be one of {SESSION_STATES}")
            conn.execute(f"UPDATE sessions SET {k}=?, updated_at=? WHERE id=?", (v, now(), s["id"]))
            log_event(conn, s["task_id"], "session", f"S{s['id']} {k} → {v}")
        touch_task(conn, s["task_id"])
    elif sub == "list":
        live = live_agents()
        for s in conn.execute("SELECT * FROM sessions WHERE status!='closed' ORDER BY id"):
            a = live.get(s["pane_id"])
            print(f"S{s['id']:<3} T{s['task_id']:<3} {s['agent']:<20} {s['status']:<13} "
                  f"agent={a['agent_status'] if a else 'GONE':<8} {s['runtime']:<8} {s['repo']} {s['branch']}")
    else:
        die(f"unknown session subcommand {sub}")
    conn.commit()
    write_status(conn)


def close_workspace(ws_id):
    """Close a herdr workspace; one that is already gone counts as closed. Anything else fails loudly."""
    r = run(["herdr", "workspace", "close", ws_id], check=False)
    if r.returncode and "workspace_not_found" not in r.stdout + r.stderr:
        die(f"could not close herdr workspace {ws_id}:\n{r.stdout}{r.stderr}")


def cmd_close(args):
    """close <S|agent> [keep-worktree] — stop the worker, close its herdr workspace, remove the worktree."""
    if not args:
        die("close <S|agent> [keep-worktree] [force]")
    conn = db()
    require_lock()
    ref = args[0][1:] if args[0].startswith("S") and args[0][1:].isdigit() else args[0]
    s = resolve_session(conn, ref)
    if s["external"]:
        # Not ours: never close the user's pane/workspace or touch their files.
        conn.execute("UPDATE sessions SET status='closed', updated_at=? WHERE id=?", (now(), s["id"]))
        log_event(conn, s["task_id"], "close", f"S{s['id']} external session untracked (left running)")
        conn.commit()
        write_status(conn)
        print(f"untracked S{s['id']} (external session left running)")
        return
    wt = Path(s["worktree"])
    in_place = project(s["repo"]).get("worktrees") is False
    if in_place:
        args = [*args, "keep-worktree"]  # the project folder itself; never remove it
    if "keep-worktree" not in args and wt.exists():
        dirty = run(["git", "-C", str(wt), "status", "--porcelain"], check=False).stdout.strip()
        unpushed = run(["git", "-C", str(wt), "log", "--oneline", "@{u}..HEAD"], check=False)
        if (dirty or unpushed.returncode != 0 or unpushed.stdout.strip()) and "force" not in args:
            die(f"S{s['id']} worktree has uncommitted or unpushed work:\n{dirty}\n{unpushed.stdout}{unpushed.stderr}\n"
                "Resolve it first, or pass 'keep-worktree' / 'force'.")
    record_credits(conn, s)
    if s["workspace_id"]:
        close_workspace(s["workspace_id"])
    if "keep-worktree" not in args and wt.exists():
        repo_path = expand(project(s["repo"])["path"])
        run(["git", "-C", str(repo_path), "worktree", "remove", *(["--force"] if "force" in args else []), str(wt)])
    conn.execute("UPDATE sessions SET status='closed', updated_at=? WHERE id=?", (now(), s["id"]))
    log_event(conn, s["task_id"], "close", f"S{s['id']} {s['agent']} closed" + (" (worktree kept)" if "keep-worktree" in args else ""))
    touch_task(conn, s["task_id"])
    conn.commit()
    write_status(conn)
    print(f"closed S{s['id']}")


def cmd_adopt(args):
    """adopt <pane-id> <task-id> [repo=] — track an agent session Zed didn't start. Never closed by Zed."""
    if len(args) < 2:
        die("adopt <pane-id> <task-id> [repo=<name>]")
    pane_id, tid = args[0], int(args[1].lstrip("T"))
    kv = parse_kv(args[2:])
    conn = db()
    require_lock()
    get_task(conn, tid)
    a = live_agents().get(pane_id)
    if not a:
        die(f"no live agent in pane {pane_id}")
    cwd = a.get("cwd") or ""
    branch = run(["git", "-C", cwd, "branch", "--show-current"], check=False).stdout.strip() or "-"
    ts = now()
    cur = conn.execute(
        "INSERT INTO sessions(task_id,repo,base,branch,worktree,agent,workspace_id,pane_id,claude_session_id,status,external,"
        "runtime,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,1,?,?,?)",
        (tid, kv.get("repo", Path(cwd).name), "-", branch, cwd, a.get("name") or pane_id, a["workspace_id"], pane_id,
         (a.get("agent_session") or {}).get("value"), "running", a.get("agent") or "claude", ts, ts))
    log_event(conn, tid, "adopt", f"S{cur.lastrowid} adopted external session in {pane_id} ({cwd})")
    conn.execute("UPDATE tasks SET status='active' WHERE id=? AND status='intake'", (tid,))
    touch_task(conn, tid)
    conn.commit()
    write_status(conn)
    print(f"S{cur.lastrowid}")


def cmd_handoff(args):
    """handoff <S|agent> [runtime=auto|claude|copilot] [brief=<file>] [model=] [effort=] — move a stopped worker (e.g. one paused
    by a usage limit) to a new session on another runtime, in the same worktree and branch. Only with the user's OK."""
    if not args:
        die("handoff <S|agent> [runtime=auto|claude|copilot] [brief=<file>]")
    conn = db()
    require_lock()
    ref = args[0][1:] if args[0].startswith("S") and args[0][1:].isdigit() else args[0]
    s = resolve_session(conn, ref)
    kv = parse_kv([a for a in args[1:] if a != "restart"])
    if s["external"] or s["status"] == "closed":
        die(f"S{s['id']} is {'external' if s['external'] else 'closed'}; handoff is for running sessions Zed started")
    brief = kv.get("brief") or s["brief"] or str(PROFILE_DIR / "briefs" / f"T{s['task_id']}-{s['repo']}.md")
    if not Path(brief).exists():
        die(f"brief not found: {brief}; pass brief=<file>")
    restart = "restart" in args[1:]  # same runtime, fresh session (e.g. to apply a new model/effort ceiling)
    target = s["runtime"] if restart else choose_runtime(kv.get("runtime", "auto"), exclude=(s["runtime"],))
    if target == s["runtime"] and not restart:
        die("handoff needs a different runtime (or `restart` for a fresh session on the same one)")
    wt = s["worktree"]
    if not s["workspace_id"]:
        die("handoff needs the old worker's managed workspace so it can be stopped safely")
    if not Path(wt).is_dir():
        die(f"handoff worktree is missing: {wt}")
    if project(s["repo"]).get("worktrees") is not False:
        actual = run(["git", "-C", wt, "branch", "--show-current"]).stdout.strip()
        if actual != s["branch"]:
            die(f"handoff worktree is on '{actual}', not '{s['branch']}'; left untouched")

    def git(*a):
        r = run(["git", "-C", wt, *a], check=False)
        return (r.stdout + r.stderr).strip() or "(nothing)"

    screen = run(["herdr", "agent", "read", s["agent"], "--source", "recent-unwrapped", "--lines", "150"], check=False)
    qs = conn.execute("SELECT * FROM questions WHERE session_id=? ORDER BY id", (s["id"],)).fetchall()
    note = PROFILE_DIR / "briefs" / f"T{s['task_id']}-{s['repo']}-handoff-S{s['id']}.md"
    note.write_text("\n".join([
        f"# Handoff from S{s['id']} ({s['runtime']}) — T{s['task_id']} {s['repo']}", "",
        f"Written by Zed on {now()}. S{s['id']} stopped before finishing (state: {s['status']}); "
        f"{runtime_state().get(s['runtime'], {}).get('note') or 'see its last output below'}.",
        f"Brief: {brief}", f"Worktree: {wt}", f"Branch: {s['branch']} (base {s['base']})", "",
        "## Git state", "", "```", f"$ git status --short", git("status", "--short"), "",
        f"$ git log --oneline origin/{s['base']}..HEAD", git("log", "--oneline", f"origin/{s['base']}..HEAD"), "",
        "$ git diff --stat HEAD", git("diff", "--stat", "HEAD"), "```", "",
        "## Questions and answers so far", "",
        *([f"- Q{q['id']} [{q['status']}] {q['question']}" + (f"\n  → {q['answer']}" if q["answer"] else "") for q in qs]
          or ["- None."]), "",
        "## Last output of the previous session", "", "```",
        (screen.stdout.strip() if screen.returncode == 0 else f"(could not read it: {screen.stderr.strip()})"), "```", ""]))
    # Stop the old session so it doesn't resume on its own (e.g. after a limit resets) and race the new one.
    record_credits(conn, s)
    require_lock()
    if s["workspace_id"]:
        close_workspace(s["workspace_id"])
    conn.execute("UPDATE sessions SET status='closed', updated_at=? WHERE id=?", (now(), s["id"]))
    log_event(conn, s["task_id"], "handoff", f"S{s['id']} ({s['runtime']}) closed, worktree kept; handing over to {target} ({note})")
    conn.commit()
    conn.close()
    return cmd_spawn([str(s["task_id"]), f"repo={s['repo']}", f"base={s['base']}", f"branch={s['branch']}",
                      f"brief={brief}", f"runtime={target}", f"handoff={note}", f"name={s['agent']}",
                      *[f"{k}={kv[k]}" for k in ("model", "effort") if k in kv]], worktree=Path(wt))


def read_screen(agent, source="visible", lines=None):
    r = run(["herdr", "agent", "read", agent, "--source", source, *(["--lines", str(lines)] if lines else [])], check=False)
    return r.stdout if r.returncode == 0 else ""


def limit_line(runtime, screen, last=25):
    """The line near the bottom of the screen that looks like the runtime's usage-limit message, if any."""
    for line in reversed(screen.strip().splitlines()[-last:]):
        if any(re.search(p, line, re.I) for p in RUNTIMES.get(runtime, {}).get("limit_patterns", [])):
            return line.strip(" │┃●")
    return None


def record_credits(conn, s, screen=None):
    """Store the AI credits a Copilot session has used so far (its footer: "Session: 4.2 AIC used")."""
    pattern = RUNTIMES.get(s["runtime"], {}).get("credits_pattern")
    if not pattern or s["external"]:
        return
    m = re.findall(pattern, screen if screen is not None else read_screen(s["agent"]))
    if m:
        conn.execute("UPDATE sessions SET credits=? WHERE id=?", (float(m[-1]), s["id"]))


# ---------------------------------------------------------------- worker reports

BLOCK_START = re.compile(r"^ZED:(QUESTION|DONE|BLOCKED)\s*$")
BLOCK_END = re.compile(r"^(```|[─━╭╰❯⏵✻✢✽]|.*\bAIC used\b|.*\besc to\b)")  # closing fence or the CLI's prompt/footer chrome
BLOCK_MAX_LINES = 80           # a marker with more text than this after it is old output, not a final report
DONE_FIELDS = ("Summary", "Branch", "PR", "QA", "Follow-ups", "Learnings")
NO_QA = re.compile(r"^\W*(none|n/?a|not (run|done|tested)|skipped|no qa|-)?\W*$", re.I)
LAPSE_GRACE = 30               # seconds a worker must stay idle without a ZED block before it is nudged
LAPSE_NUDGE = "Continue, or end with ZED:QUESTION / ZED:DONE / ZED:BLOCKED."


def parse_block(screen):
    """The worker's last ZED:QUESTION / ZED:DONE / ZED:BLOCKED block on its screen, or None:
    {"kind", "text", "fingerprint", "items" (QUESTION) | "fields" (DONE)}."""
    lines = [re.sub(r"^[\s⏺●│⎿]+", "", l).rstrip() for l in (screen or "").splitlines()]
    starts = [i for i, l in enumerate(lines) if BLOCK_START.match(l)]
    if not starts:
        return None
    i = starts[-1]
    body = []
    for l in lines[i + 1:]:
        if BLOCK_END.match(l):
            break
        body.append(l)
    while body and not body[-1]:
        body.pop()
    if len(body) > BLOCK_MAX_LINES:
        return None
    kind = BLOCK_START.match(lines[i]).group(1)
    block = {"kind": kind, "text": "\n".join(body), "items": [], "fields": {}}
    block["fingerprint"] = f"{kind}:{block['text'][:200]}"
    if kind == "DONE":
        field = None
        for l in body:
            m = re.match(rf"({'|'.join(DONE_FIELDS)}):\s*(.*)$", l)
            if m:
                field = m.group(1)
                block["fields"][field] = m.group(2)
            elif field and l:
                block["fields"][field] += "\n" + l
    else:
        for l in body:
            m = re.match(r"(\d+)[.)]\s+(.*)$", l)
            if m:
                block["items"].append(m.group(2))
            elif block["items"] and l:
                block["items"][-1] += "\n" + l
        if not block["items"] and block["text"]:
            block["items"] = [block["text"]]
    return block


def record_block(conn, s, block):
    """Do the DB bookkeeping for a worker's report (what `check-workers` did by hand) and return the
    text to put in the watcher event."""
    sid, tid = s["id"], s["task_id"]
    if block["kind"] in ("QUESTION", "BLOCKED"):
        out = []
        for text in block["items"] or ["(empty block)"]:
            if block["kind"] == "BLOCKED":
                text = f"BLOCKED: {text}"
            known = conn.execute("SELECT id FROM questions WHERE session_id=? AND question=?", (sid, text)).fetchone()
            qid = known["id"] if known else add_question(conn, tid, sid, text)
            out.append(f"Q{qid}{' (already recorded)' if known else ''}: {text}")
        return f"ZED:{block['kind']}\n" + "\n".join(out)
    f = block["fields"]
    summary = f.get("Summary", "").strip()
    if not conn.execute("SELECT 1 FROM events WHERE task_id=? AND kind='done' AND text=?", (tid, summary)).fetchone():
        log_event(conn, tid, "done", summary or "(no summary)")
    conn.execute("UPDATE sessions SET status='finished', updated_at=? WHERE id=?", (now(), sid))
    out = [f"ZED:DONE · {summary}"]
    url = re.search(r"https?://\S+", f.get("PR", ""))
    qa = f.get("QA", "").strip()
    if url:
        url = url.group(0).rstrip(".,;)")
        conn.execute("UPDATE sessions SET pr_url=?, updated_at=? WHERE id=?", (url, now(), sid))
        out.append(f"PR: {url}")
        if NO_QA.match(qa):
            out.append("⚠ PR with no real QA in its QA: line — send it back to QA before accepting (CLAUDE.md directive 6)")
        else:
            conn.execute("UPDATE tasks SET status='pr_open' WHERE id=? AND status IN ('active','waiting_user','in_review')", (tid,))
    out.append(f"QA: {qa or '(missing)'}")
    for k in ("Follow-ups", "Learnings"):
        if f.get(k) and f[k].strip().lower() not in ("none", "-"):
            out.append(f"{k}: {f[k]}")
    touch_task(conn, tid)
    return "\n".join(out)


def mark_runtime_limited(conn, name, note):
    state = runtime_state()
    state[name] = {"since": now(), "until": None, "note": note}
    log_event(conn, None, "runtime", f"{name} limited: {note}")
    RUNTIME_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    RUNTIME_STATE_PATH.write_text(json.dumps(state, indent=2) + "\n")


def settle_turn(conn, s, screen, alerts, line, seq):
    """A worker's turn ended (idle/done). Returns the event text for Zed, or None when the watcher
    dealt with it: a new ZED block is recorded and surfaced; a usage limit marks the runtime limited and
    wakes Zed once; no block at all is a protocol lapse, nudged by `lapse_tick` after a grace period."""
    seen = alerts.setdefault(s["id"], {})
    block = parse_block(read_screen(s["agent"], "recent-unwrapped", 150) or screen)
    if block and seen.get("block") != block["fingerprint"]:
        seen["block"], seen["nudges"] = block["fingerprint"], 0
        seen.pop("lapse", None)
        return f"{line}\n{record_block(conn, s, block)}"
    hit = limit_line(s["runtime"], screen)
    if hit:
        if seen.get("limit") == hit:
            return None
        seen["limit"] = hit
        if not runtime_state().get(s["runtime"]):
            mark_runtime_limited(conn, s["runtime"], hit)
        return (f"{line} · USAGE LIMIT: {hit} · {s['runtime']} marked limited (undo: bin/zed runtime ok {s['runtime']}); "
                "moving the worker needs the user's OK (switch-runtime skill)")
    young = (datetime.now() - datetime.strptime(s["created_at"], "%Y-%m-%d %H:%M")).total_seconds() < 180
    if not young:
        seen["lapse"] = {"seq": seq, "since": time.time()}
    return None


def lapse_tick(s, state, seq, alerts):
    """Protocol lapse: idle with no ZED block. The first one is nudged with the standard prompt without
    waking Zed; one after a nudge is returned as an event line."""
    seen = alerts.setdefault(s["id"], {})
    lapse = seen.get("lapse")
    if not lapse:
        return None
    if state not in ("idle", "done") or lapse["seq"] != seq:
        seen.pop("lapse")
        return None
    if time.time() - lapse["since"] < LAPSE_GRACE:
        return None
    seen.pop("lapse")
    if not seen.get("nudges"):
        seen["nudges"] = 1
        run(["herdr", "agent", "prompt", s["agent"], LAPSE_NUDGE], check=False)
        return ("nudge", f"S{s['id']} idle with no ZED block; sent the standard nudge")
    seen["nudges"] += 1
    return ("wake", f"S{s['id']} T{s['task_id']} {s['agent']} · PROTOCOL LAPSE again: idle with no ZED block after a nudge "
                    "(read its screen; it may be waiting on something or lost)")


def watcher_alive():
    """pid of a live `zed watch` for this profile, or None (a stale pid file or a reused pid doesn't count)."""
    pid = read_json(WATCHER_PID_PATH, {}).get("pid")
    if not pid or pid == os.getpid():
        return None
    r = run(["ps", "-o", "command=", "-p", str(pid)], check=False)
    return pid if r.returncode == 0 and re.search(r"\bzed\b.*\bwatch\b", r.stdout) else None


def cmd_watch(args):
    """Emit one line whenever a managed worker changes to a state that needs Zed's attention.
    Claude Code: run it under the Monitor tool. Copilot CLI: run `watch --once` as a detached shell; it
    exits after the first event(s), which wakes Zed, and remembers what it has reported so a re-armed
    watch only reports new changes. Exits (3) when this session loses the Zed lock."""
    once = "--once" in args
    rest = [a for a in args if a != "--once"]
    interval = float(rest[0]) if rest else 3.0
    db().close()
    require_lock()
    other = watcher_alive()
    if other:
        print(f"WATCH_ALREADY_RUNNING pid {other}: one watcher is enough; it will wake Zed.", flush=True)
        sys.exit(4)
    WATCHER_PID_PATH.parent.mkdir(parents=True, exist_ok=True)
    WATCHER_PID_PATH.write_text(json.dumps({"pid": os.getpid(), "started": now()}))
    atexit.register(lambda: WATCHER_PID_PATH.unlink(missing_ok=True))
    saved = read_json(WATCH_STATE_PATH, None)
    prev = {int(k): v for k, v in saved.items()} if saved is not None else {}
    first = saved is None
    alerts_path = WATCH_STATE_PATH.with_name("watch-alerts.json")
    alerts = {int(k): v for k, v in read_json(alerts_path, {}).items()}  # health alerts already reported, kept across runs
    while True:
        if not holds_lock():
            h = read_lock()
            print("LOCK LOST: " + (f"another session took over as Zed ({describe(h)})" if h else "the Zed lock was released")
                  + ". Stop acting as Zed: no watcher, relaying or commits; read-only from now on.", flush=True)
            sys.exit(3)
        events = []
        try:
            conn = db()
            sessions = conn.execute("SELECT * FROM sessions WHERE status IN ('running','waiting_user')").fetchall()
            live = live_agents()
            for s in sessions:
                a = live.get(s["pane_id"])
                state = a["agent_status"] if a else "gone"
                key = s["id"]
                for line in health_events(conn, s, a, state, alerts):
                    events.append(line)
                snapshot = {"state": state, "sequence": a.get("state_change_seq") if a else None}
                if prev.get(key) != snapshot:
                    line = None
                    young = (datetime.now() - datetime.strptime(s["created_at"], "%Y-%m-%d %H:%M")).total_seconds() < 180
                    if not first and young and state in ("idle", "done"):
                        pass  # a just-spawned worker flickers idle before it reads its brief; not an event
                    elif not first and state in ("idle", "done", "blocked", "unknown", "gone"):
                        line = f"S{s['id']} T{s['task_id']} {s['agent']} → {state}"
                    elif first and state in ("idle", "done", "blocked", "gone"):
                        line = f"S{s['id']} T{s['task_id']} {s['agent']} is {state} (at watch start)"
                    if line and state != "gone":
                        screen = read_screen(s["agent"])
                        record_credits(conn, s, screen)
                        if state == "blocked":
                            prompt = prompt_summary(screen)
                            if auto_approve(conn, s, screen, alerts):
                                line = None  # handled by rule; logged, no need to wake Zed
                            else:
                                line += f" · prompt: {prompt}" if prompt else ""
                        elif state in ("idle", "done"):
                            line = settle_turn(conn, s, screen, alerts, line, snapshot["sequence"])
                        hit = line and state not in ("idle", "done") and limit_line(s["runtime"], screen)
                        if hit:
                            line += f" · possible {s['runtime']} usage limit: {hit}"
                    if line:
                        events.append(line)
                    prev[key] = snapshot
                lapse = lapse_tick(s, state, snapshot["sequence"], alerts)
                if lapse:
                    kind, text = lapse
                    if kind == "nudge":
                        log_event(conn, s["task_id"], "auto", text)
                    else:
                        events.append(text)
            first = False
            conn.commit()
            conn.close()
        except Exception as e:  # keep the watch alive through transient failures
            print(f"watch error: {e}", file=sys.stderr, flush=True)
        for line in events:
            print(line, flush=True)
        WATCH_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        WATCH_STATE_PATH.write_text(json.dumps(prev))
        alerts_path.write_text(json.dumps(alerts))
        if once and events:
            return
        time.sleep(interval)


PROMPT_LINE = re.compile(r"(\?\s*$|^\s*(Read|Bash|Edit|Write|Fetch|Update|Agent|Skill)\(|Dangerous|^\s*❯?\s*\d\.\s)")


def prompt_summary(screen):
    """The pending permission prompt in a worker's screen, condensed to one line (what it wants, the options)."""
    lines = [l.strip(" │┃") .strip() for l in (screen or "").splitlines()[-30:]]
    keep = [l for l in lines if l and PROMPT_LINE.search(l) and "Tip:" not in l]
    return " | ".join(keep)[:600]


AUTO_APPROVE_PATH = PROFILE_DIR / "config" / "auto-approve.json"


def auto_approve(conn, s, screen, alerts):
    """Answer a routine permission prompt by rule, without waking Zed. Rules live in the profile's
    config/auto-approve.json: [{"name", "prompt" (text that must appear), "path_prefixes" (the Read/Bash
    target must start with one), "option" (text of the one-time option that must be offered), "key"}].
    A prompt already answered once that is still showing is left for Zed."""
    rules = read_json(AUTO_APPROVE_PATH, [])
    tail = "\n".join((screen or "").splitlines()[-30:])
    seen = alerts.setdefault(s["id"], {})
    if seen.get("auto_last") == tail:
        return False
    for r in rules:
        if r["prompt"] not in tail or r["option"] not in tail:
            continue
        targets = re.findall(r"(?:Read|Bash)\((.*?)\)\s*$", tail, re.M)
        prefixes = [os.path.expanduser(x) for x in r.get("path_prefixes", [])]
        targets = [os.path.normpath(t) for t in targets]  # no `..` escapes out of an allowed prefix
        if not targets or not all(any(t.startswith(x) for x in prefixes) for t in targets):
            continue
        run(["herdr", "agent", "send-keys", s["agent"], r["key"]], check=False)
        seen["auto_last"] = tail
        log_event(conn, s["task_id"], "auto", f"S{s['id']}: answered '{r['name']}' with {r['key']} for {', '.join(targets)}")
        return True
    return False


def health_events(conn, s, a, state, alerts):
    """Deterministic checks the watcher runs on every live session: no plan progress, token use, long blocks."""
    out, seen = [], alerts.setdefault(s["id"], {})
    tag = f"S{s['id']} T{s['task_id']} {s['agent']}"
    now = datetime.now()
    started = datetime.strptime(s["created_at"], "%Y-%m-%d %H:%M")
    if state == "working":
        plans = plan_files(s["task_id"])
        last = max([started] + [datetime.fromtimestamp(p.stat().st_mtime) for p in plans])
        idle = int((now - last).total_seconds() // 60)
        what = "no plan file yet" if not plans else "no plan progress"
        if idle >= STALL_MINUTES and seen.get("stall") != last.isoformat():
            seen["stall"] = last.isoformat()
            out.append(f"{tag} · STALL: {what} for {idle} min while working (check for re-tooling or repeated work)")
    if state == "blocked":
        since = datetime.fromisoformat(seen.setdefault("blocked_since", now.isoformat()))
        if (now - since).total_seconds() >= 300 and not seen.get("block_reminded"):
            seen["block_reminded"] = True
            out.append(f"{tag} · still blocked after 5 min (queued prompt? read the screen again)")
    else:
        seen.pop("blocked_since", None)
        seen.pop("block_reminded", None)
    if s["runtime"] == "claude":
        u = claude_usage(s["worktree"], note_session_id(conn, s, a))
        if u:
            step = u["output"] // USAGE_ALERT_OUTPUT
            if step > seen.setdefault("usage_step", 0):
                done = sum(plan_progress(p)[0] for p in plan_files(s["task_id"]))
                if done <= seen.get("usage_plan_done", -1):  # tokens spent with no plan progress: needs judgment
                    out.append(f"{tag} · USAGE without plan progress: {fmt_usage(u)}, still {done} steps done")
                else:
                    log_event(conn, s["task_id"], "auto", f"S{s['id']} usage {fmt_usage(u)}; {done} plan steps done")
                seen["usage_step"], seen["usage_plan_done"] = step, done
    return out


def cmd_paths(args):
    """Print where Zed's files are, for skills and scripts."""
    print(json.dumps({"home": str(ZED_HOME), "profile": str(PROFILE_DIR),
                      "profile_exists": (PROFILE_DIR / "profile.md").exists(),
                      "db": str(DB_PATH), "status": str(STATUS_PATH), "projects": str(PROJECTS_PATH),
                      "briefs": str(PROFILE_DIR / "briefs"), "runtimes": str(RUNTIMES_PATH),
                      "model_ranking": str(MODEL_RANKING_PATH)}, indent=2))


BRIEF_LINES = 12  # per section; the rest is "N more omitted"


def capped(lines, limit=BRIEF_LINES):
    return lines[:limit] + ([f"  … {len(lines) - limit} more omitted"] if len(lines) > limit else [])


def render_brief(conn, live=None):
    """Only what needs the user or Zed, in a bounded digest: open questions, sessions that need a look,
    PRs waiting on review, tasks not started."""
    live = live if live is not None else live_agents()
    out = []
    qs = [f"  Q{q['id']} T{q['task_id']} ({q['asked_at']}): {q['question'].splitlines()[0][:200]}"
          for q in conn.execute("SELECT * FROM questions WHERE status='open' ORDER BY id")]
    out += ["Waiting on the user:", *(capped(qs) or ["  nothing"])]
    sess = []
    for s in conn.execute("SELECT * FROM sessions WHERE status IN ('running','waiting_user') ORDER BY id"):
        a = live.get(s["pane_id"])
        state = a["agent_status"] if a else "GONE"
        plan = [plan_progress(p) for p in plan_files(s["task_id"])]
        note = f" · plan {plan[0][0]}/{plan[0][0] + plan[0][1]}" if plan else ""
        sess.append(f"  S{s['id']} T{s['task_id']} {s['agent']} {s['runtime']} {s['status']}/{state}{note}")
    out += ["Sessions running:", *(capped(sess) or ["  none"])]
    other = [f"  T{t['id']} {t['status']} {t['jira'] or '-'} {t['title']}" for t in conn.execute(
        "SELECT * FROM tasks WHERE status IN ('pr_open','intake','parked') ORDER BY id")]
    out += ["PR open / not started / parked:", *(capped(other) or ["  none"])]
    return out


def plan_progress(plan):
    text = plan.read_text()
    return len(re.findall(r"^\s*- \[[xX]\]", text, re.M)), len(re.findall(r"^\s*- \[ \]", text, re.M))


def cmd_status(args):
    conn = db()
    if "--brief" in args:
        print("\n".join(render_brief(conn)))
        return
    text = render_status(conn)
    if holds_lock():
        STATUS_PATH.write_text(text)
    print(text)


def cmd_start(args):
    """start [--take-over] — session start in one command: claim the Zed lock, then print one bounded
    digest (lock, runtimes, watcher, what needs the user, running sessions). Read it once and trust it."""
    require_profile()
    notes = []
    try:
        cmd_lock(["acquire", *(["--take-over"] if "--take-over" in args else [])])
    except SystemExit as e:
        notes.append("NOT THE ACTIVE ZED: the lock is held by another live session. Read-only: no watcher, "
                     "no prompting workers, no commits. Ask the user: stay read-only or `bin/zed start --take-over`.")
        if e.code not in (1, 2):
            raise
    conn = db()
    lock = read_lock()
    out = [f"Zed home {ZED_HOME} · profile {PROFILE_DIR}",
           f"lock: {'held by this session (' + (me().get('runtime') or '?') + ')' if holds_lock() else describe(lock) if lock else 'none'}",
           "runtimes: " + "; ".join(
               f"{n} {'LIMITED ' + json.dumps(r['limited']) if r['limited'] else 'ok' if r['installed'] and r['enabled'] else 'unusable'}"
               for n, r in ((n, runtime_report(n)) for n in runtime_config().get("order", [])))]
    watcher = watcher_alive()
    running = conn.execute("SELECT COUNT(*) FROM sessions WHERE status IN ('running','waiting_user')").fetchone()[0]
    out.append(f"watcher: {'alive, pid ' + str(watcher) if watcher else 'NOT RUNNING' + (' — arm it: bin/zed watch --once (background)' if running else '')}")
    out += notes + render_brief(conn)
    print("\n".join(out))


def cmd_help(args):
    print(__doc__)
    print("""Commands
  task add title=... [jira=] [worktype=] [description=] [status=]
  task set <T> key=value...          (title jira worktype description status)
  task show <T> | task list [--all]
  log <T|-> <text...> [kind=note]
  q add <T|-> <question...> [session=S] | q answer <Q> <answer...> | q list
  brief <T> repo= base= branch= [force]
                                     scaffold the brief from the task, projects.json, repo notes and plan
                                     block; leaves <FILL: …> for the model, which spawn refuses
  spawn <T> repo= base= branch= brief=<file> [name=<agent>] [from=<start-ref, default origin/<base>>]
        [runtime=auto|claude|copilot] [model=] [effort=] [handoff=<note>]
                                     runtime/model/effort default to the profile's order and model policy
  session list | session set <S|agent> key=value... (status pr_url claude_session_id pane_id workspace_id base brief)
  close <S|agent> [keep-worktree] [force]   (external sessions are only untracked)
  adopt <pane-id> <T> [repo=]        track a session Zed didn't start (user's own)
  handoff <S|agent> [runtime=] [brief=] [model=] [effort=] [restart]
                                     move a stopped worker to another runtime, same worktree
                                     (writes a handoff note, closes the old session, spawns the new one)
  runtime status | runtime limited <rt> [until=<when>] [note...] | runtime ok <rt>
                                     which runtimes are usable; mark one limited / available again
  models show | models import <ranking.json>
                                     the model ranking and what the policy picks per runtime
  watch [interval-seconds] [--once]  Claude: run under Monitor. Copilot: run `watch --once` as a
                                     detached shell; it exits after the first event(s)
  status [--brief]                   (regenerate + print STATUS.md; --brief: only what needs attention)
  start [--take-over]                (session start: claim the lock, print one bounded digest)
  paths                              (Zed home, profile dir, DB/STATUS/config/briefs locations)
  lock status | lock acquire [--take-over] | lock release
                                     one active Zed per profile; without the lock only
                                     status, list, show, paths and lock work
Task states:    """ + ", ".join(TASK_STATES) + """
Session states: """ + ", ".join(SESSION_STATES))


COMMANDS = {"task": cmd_task, "log": cmd_log, "q": cmd_q, "spawn": cmd_spawn, "session": cmd_session,
            "close": cmd_close, "adopt": cmd_adopt, "handoff": cmd_handoff, "watch": cmd_watch, "status": cmd_status,
            "brief": cmd_brief, "paths": cmd_paths, "start": cmd_start, "lock": cmd_lock, "runtime": cmd_runtime, "models": cmd_models, "help": cmd_help}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        cmd_help([])
        sys.exit(0 if len(sys.argv) < 2 else 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])
