#!/usr/bin/env python3
"""zed — Zed's task tracker and herdr session driver.

Everything Zed knows about ongoing work lives in the user's profile: <profile>/db/zed.db (SQLite),
and <profile>/STATUS.md is regenerated from it on every write. The profile is `profile/` in Zed's
home, or $ZED_PROFILE_DIR if set (e.g. a throwaway profile for testing).

Concepts
  task     a unit of work the user asked for (usually one ticket)
  session  one Claude Code worker running in herdr, in its own git worktree, on one repo
  question something a worker (or Zed) needs the user to decide
  event    timestamped log line attached to a task (or global if no task)

One active Zed per profile: the Claude Code session that holds the profile's lock
(<profile>/.cache/zed.lock) is Zed. Other sessions get read-only access (status, list, show);
mutating commands and `watch` refuse. See `zed lock`.

Run `zed help` for commands.
"""
import argparse
import atexit
import base64
import contextlib
import fcntl
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socket
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.request
from collections import namedtuple
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedconductor  # noqa: E402
import zeddeny  # noqa: E402
import zedemployee as emp  # noqa: E402
import zedgates  # noqa: E402
import zedlib  # noqa: E402

ZED_HOME = Path(__file__).resolve().parent.parent
PROFILE_DIR = Path(os.environ.get("ZED_PROFILE_DIR") or ZED_HOME / "profile").expanduser().resolve()
DB_PATH = PROFILE_DIR / "db" / "zed.db"
STATUS_PATH = PROFILE_DIR / "STATUS.md"
PROJECTS_PATH = PROFILE_DIR / "config" / "projects.json"
CORE_WORKER_RULES = ZED_HOME / "templates" / "worker-rules.md"
PROFILE_RULES = PROFILE_DIR / "rules.md"
LOCK_PATH = PROFILE_DIR / ".cache" / "zed.lock"
CLAUDE_CONFIG_PATH = PROFILE_DIR / "config" / "claude.json"
OPENCODE_CONFIG_PATH = PROFILE_DIR / "config" / "opencode.json"
WATCH_STATE_PATH = PROFILE_DIR / ".cache" / "watch-state.json"
SPEND_LEDGER_PATH = PROFILE_DIR / "db" / "spend.jsonl"
WAKE_QUEUE_PATH = PROFILE_DIR / ".cache" / "wake-queue.json"
WATCHER_PID_PATH = PROFILE_DIR / ".cache" / "watch.pid"
WATCHER_LOCK_PATH = PROFILE_DIR / ".cache" / "watch.lock"
ARM_STAMP_PATH = PROFILE_DIR / ".cache" / "hook-arm.stamp"  # touched by the Stop hook's arm step on every firing

RUNTIMES = ("claude", "opencode")  # an install runs on one of them, Zed and its workers alike: install_runtime()
# Claude Code workers: the model, effort ceiling and capacity live in <profile>/config/claude.json.
EFFORTS = ["low", "medium", "high", "xhigh", "max"]
# Dialogs Claude Code can show before its first prompt, in the order it shows them.
# Claude Code documents no flag or setting that answers either one in advance (code.claude.com/docs/en/memory and
# /cli-reference, read 2026-11-11; dialogs observed on v2.1.322), so spawn answers them with key presses.
# - Folder trust: Zed created the worktree from a configured repo, so it accepts ("No, exit" is preselected).
# - External imports: a CLAUDE.md, here or in a parent folder, imports a file from outside the worktree. Zed declines
#   ("No, disable external imports" is preselected): the worktree's own instructions and their imports still load, only
#   files outside it are refused, so a folder the user never delegated cannot instruct the worker.
StartDialog = namedtuple("StartDialog", "name text keys note")  # text: what the screen shows; keys: the answer
START_DIALOGS = [
    StartDialog("folder trust", "Yes, I trust this folder", ["down", "enter"], "accepted"),
    StartDialog("external CLAUDE.md imports", "No, disable external imports", ["enter"],
                "declined: instructions imported from outside the worktree are not loaded"),
]
# e.g. "You've hit your session limit · resets 3pm", "Usage limit reached · continuing automatically at …"
LIMIT_PATTERNS = [r"hit your \w+ limit", r"usage limit reached", r"limit reached\b.*\breset"]
# OpenCode V2 workers (`spawn runtime=opencode`), observed on v2.2.7. Each worker has its own server (`opencode serve`),
# because only a server started with the worker's OPENCODE_CONFIG_DIR loads its deny plugin and rules, and a `--standalone`
# TUI opens no port spawn could reach. The server is a background job of the worker's pane: OpenCode runs the worker's
# shell commands in the server, and a hat session is known by the pane that hosts its processes (zedemployee.process_pane).
# The TUI takes no model flag, so spawn creates the session through the server's API with the model and variant from
# <profile>/config/opencode.json and attaches the TUI to it. The TUI showed no dialog at start.
OPENCODE_DEFAULTS_PATH = ZED_HOME / "profile.template" / "config" / "opencode.json"  # the one place the defaults live
OPENCODE_START_TIMEOUT_MS = 180000
OPENCODE_SERVER_SECONDS = 60  # for the server to answer after `opencode serve`
OPENCODE_CANARY_SECONDS = 180  # for the one model turn that makes the canary call
# The coordinator on OpenCode (`bin/zed coordinator`): its own server too, so the canary runs in the very server and
# session Zed then works in, and the watcher has an address to wake it at. The session's shell commands carry
# COORDINATOR_ENV, the path of the record `start` checks before it lets the session act as Zed.
COORDINATOR_ENV = "ZED_COORDINATOR"
PRETOOL_CANARY = "zed-pretool-canary"  # bin/zed-pretool denies it in every session
# The repository section of the worker rules names Claude Code's files; this says what OpenCode reads instead.
OPENCODE_RULES_NOTE = """## You run on OpenCode

Where these rules name `CLAUDE.md`, `.claude/rules` or Claude Code settings: OpenCode reads the repository's `AGENTS.md`
files and its skills (`.opencode/skills`, `.claude/skills`) instead, and does not read `CLAUDE.md`.
"""

TASK_STATES = ["intake", "active", "waiting_user", "in_review", "pr_open", "parked", "done", "cancelled"]
SESSION_STATES = ["running", "waiting_user", "finished", "failed", "closed"]  # failed: never briefed (start checks)
OPEN_TASK_STATES = ["intake", "active", "waiting_user", "in_review", "pr_open", "parked"]
# How STATUS.md groups the open tasks; finished ones (done, cancelled) follow separately.
TASK_GROUPS = [("In progress", ["active", "waiting_user", "in_review"]),
               ("PR open", ["pr_open"]),
               ("Not started / parked", ["intake", "parked"])]
SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks (
  id INTEGER PRIMARY KEY,
  title TEXT NOT NULL,
  ticket TEXT,  -- the tracker's id for this work, if it has one
  worktype TEXT,
  description TEXT,
  status TEXT NOT NULL DEFAULT 'intake',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS sessions (
  id INTEGER PRIMARY KEY,
  task_id INTEGER NOT NULL REFERENCES tasks(id),
  repo TEXT NOT NULL,
  base TEXT NOT NULL,
  branch TEXT NOT NULL,
  worktree TEXT NOT NULL,
  agent TEXT NOT NULL,
  workspace_id TEXT,
  pane_id TEXT,
  claude_session_id TEXT,  -- the runtime's own session id (Claude Code's, or OpenCode's `ses_…`)
  pr_url TEXT,
  status TEXT NOT NULL DEFAULT 'running',
  external INTEGER NOT NULL DEFAULT 0,
  model TEXT,
  effort TEXT,
  brief TEXT,
  pr_state TEXT,  -- open | merged | closed, as last polled by the watcher
  scratch TEXT,  -- per-session scratch folder in an in-place (non-git) project; removed on close
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS questions (
  id INTEGER PRIMARY KEY,
  task_id INTEGER REFERENCES tasks(id),
  session_id INTEGER REFERENCES sessions(id),
  question TEXT NOT NULL,
  answer TEXT,
  status TEXT NOT NULL DEFAULT 'open',
  asked_at TEXT NOT NULL,
  answered_at TEXT
);
CREATE TABLE IF NOT EXISTS events (
  id INTEGER PRIMARY KEY,
  task_id INTEGER REFERENCES tasks(id),
  ts TEXT NOT NULL,
  kind TEXT NOT NULL,
  text TEXT NOT NULL
);
"""


def now():
    return datetime.now().strftime("%Y-%m-%d %H:%M")


def require_profile():
    if not (PROFILE_DIR / "profile.md").exists():
        die(f"no profile at {PROFILE_DIR}. Start `claude` in {ZED_HOME} to run onboarding, "
            "or set ZED_PROFILE_DIR.")


def db():
    require_profile()
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=10)  # waits up to 10s if another process is writing
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    task_cols = [r["name"] for r in conn.execute("PRAGMA table_info(tasks)")]
    if "jira" in task_cols and "ticket" not in task_cols:  # the ticket id was once stored under one tracker's name
        conn.execute("ALTER TABLE tasks RENAME COLUMN jira TO ticket")
    cols = [r["name"] for r in conn.execute("PRAGMA table_info(sessions)")]
    # migrate DBs created before these columns existed
    for col, decl in [("external", "INTEGER NOT NULL DEFAULT 0"), ("model", "TEXT"), ("effort", "TEXT"), ("brief", "TEXT"), ("pr_state", "TEXT"),
                      ("scratch", "TEXT")]:
        if col not in cols:
            conn.execute(f"ALTER TABLE sessions ADD COLUMN {col} {decl}")
    zedlib.ensure_session_schema(conn)
    return conn


def die(msg):
    print(f"zed: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, check=True, cwd=None):
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd)
    if check and r.returncode != 0:
        die(f"command failed: {' '.join(cmd)}\n{r.stdout}{r.stderr}")
    return r


# ---------------------------------------------------------------- lock


GONE = "gone"


def pane_record(pane):
    """What herdr knows of a pane: its dict, GONE once it no longer exists, None when unknown
    (no pane, no herdr binary, odd output)."""
    if not pane:
        return None
    try:
        r = run(["herdr", "pane", "get", pane], check=False)
        if "pane_not_found" in r.stdout + r.stderr:
            return GONE
        return json.loads(r.stdout)["result"]["pane"]
    except (OSError, ValueError, KeyError, TypeError):
        return None


def session_in(record):
    """The agent session herdr records in a pane record, or None."""
    if not isinstance(record, dict):
        return None
    return (record.get("agent_session") or {}).get("value")


def pane_session(pane):
    """The agent session herdr records for a pane: None when herdr, the pane or the session is unknown.
    This is the authority: after a restart, Bash may run under a helper whose env session id differs."""
    return session_in(pane_record(pane))


def me():
    """Identity of the Claude Code (or OpenCode) session running this command (falls back to the parent shell). Inside herdr
    the pane's session wins over the env var (see pane_session)."""
    pane = os.environ.get("HERDR_PANE_ID")
    session = pane_session(pane) or os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("OPENCODE_SESSION_ID")
    pid = os.environ.get("CLAUDE_PID", "") or os.environ.get("OPENCODE_PID", "")
    return {"pane": pane, "agent_session": session, "pid": int(pid) if pid.isdigit() else os.getppid()}


def session_of(h):
    return h.get("agent_session")


def same_holder(a, b):
    if session_of(a) and session_of(b):
        return session_of(a) == session_of(b)
    return a.get("pid") == b.get("pid")


def holder_alive(h):
    """False once the holder's herdr pane is gone or runs another session. With a pane and a session the
    pane decides (the recorded pid may be a short-lived helper); a pane without a session, or no herdr,
    leaves the pid to decide: it must still exist."""
    record = pane_record(h.get("pane"))
    if record == GONE:
        return False
    session = session_in(record) if session_of(h) else None
    if session:
        return session == session_of(h)
    try:
        os.kill(h["pid"], 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def read_lock():
    try:
        return json.loads(LOCK_PATH.read_text())
    except (FileNotFoundError, ValueError):
        return None


def heal_lock(h, caller):
    """A lock written under a helper's session id goes stale once herdr's pane session differs. When the
    caller sits in the holder's pane and that pane's session is the caller's, record the caller as holder.
    pane_session is asked again on purpose: me() also falls back to the env id, which is no proof."""
    pane = h.get("pane")
    if not (pane and pane == caller.get("pane") and caller.get("agent_session")
            and session_of(h) != caller["agent_session"] and pane_session(pane) == caller["agent_session"]):
        return h
    if read_lock() != h:  # changed since it was read (e.g. a take-over): not ours to overwrite
        return h
    healed = h | {key: caller[key] for key in ("agent_session", "pid")}
    healed.pop("claude_session", None)
    tmp = LOCK_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(healed, indent=2) + "\n")
    os.replace(tmp, LOCK_PATH)
    print(f"zed: lock in pane {pane} healed: session {session_of(h) or '-'} -> {caller['agent_session']}",
          file=sys.stderr)
    return healed


def holds_lock():
    h = read_lock()
    caller = me()
    return bool(h) and same_holder(heal_lock(h, caller), caller)


def describe(h):
    return (f"pane {h.get('pane') or '-'}, Claude session {session_of(h) or '-'}, "
            f"pid {h.get('pid')}, since {h.get('acquired_at')}")


def require_lock():
    if holds_lock():
        return
    h = read_lock()
    if h and holder_alive(h):
        die(f"another session is acting as Zed for this profile ({describe(h)}). This session is "
            "read-only: status/list/show work; to become Zed run `bin/zed lock acquire --take-over`.")
    die("this session doesn't hold the Zed lock for this profile; run `bin/zed lock acquire` first.")


def cmd_lock(args):
    """lock status | lock acquire [--take-over] | lock release"""
    sub = args[0] if args else "status"
    require_profile()
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK_PATH.with_suffix(".guard"), "w") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)  # serialise read-modify-write of the lock file
        h, caller = read_lock(), me()
        h = heal_lock(h, caller) if h else h
        alive = bool(h) and holder_alive(h)
        if h and not alive and not same_holder(h, caller):
            LOCK_PATH.unlink(missing_ok=True)
            print(f"cleared stale lock ({describe(h)})")
            h = None
        if sub == "status":
            print(json.dumps({"holder": h, "holder_alive": alive if h else None,
                              "you_hold_it": bool(h) and same_holder(h, caller), "you": caller}, indent=2))
        elif sub == "acquire":
            if h and not same_holder(h, caller) and "--take-over" not in args:
                print(f"zed: the lock is held by a live session ({describe(h)}). Choose: stay read-only, "
                      "or `bin/zed lock acquire --take-over` (its watcher will exit and it must step down).",
                      file=sys.stderr)
                sys.exit(2)
            if h and same_holder(h, caller):
                print("you already hold the lock")
                return
            LOCK_PATH.write_text(json.dumps(caller | {"acquired_at": now()}, indent=2) + "\n")
            print("took over the lock from " + describe(h) if h else "acquired the lock")
        elif sub == "release":
            if not (h and same_holder(h, caller)):
                die("you don't hold the lock")
            LOCK_PATH.unlink()
            print("released the lock")
        else:
            die("lock status | lock acquire [--take-over] | lock release")


def herdr_json(args):
    r = run(["herdr", *args], check=False)
    if r.returncode != 0:
        die(f"herdr {' '.join(args)} failed:\n{r.stderr or r.stdout}")
    return json.loads(r.stdout)


# ---------------------------------------------------------------- Claude settings

def claude_config():
    """The profile's config/claude.json: {"model", "effort" (the ceiling), "effort_by_kind", "max_running"}; a profile without one uses the CLI's defaults."""
    return read_json(CLAUDE_CONFIG_PATH, {})


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as e:
        die(f"invalid JSON in {path}: {e}")


def install_runtime():
    """The one runtime this install runs on, Zed and its workers alike: `runtime` in the profile's config/settings.json
    (bin/zed-setup writes it from what is installed). Not set: OpenCode when it is the only one installed, else
    Claude Code."""
    configured = zedlib.settings().get("runtime")
    if configured and configured not in RUNTIMES:
        die(f"\"runtime\": \"{configured}\" in {PROFILE_DIR / 'config' / 'settings.json'} is not one of {', '.join(RUNTIMES)}")
    return configured or ("opencode" if shutil.which("opencode") and not shutil.which("claude") else "claude")


def opencode_config():
    """The profile's config/opencode.json: {"model" ("provider/model"), "variant"}; a missing file or key takes the
    value in the profile template's opencode.json."""
    return read_json(OPENCODE_DEFAULTS_PATH, {}) | read_json(OPENCODE_CONFIG_PATH, {})


def pick_model(kind):
    """(model, effort, reason) for a new session: claude.json's model, and its effort for this kind of work
    (effort_by_kind), never above claude.json's effort ceiling. None = let Claude Code use its default."""
    cfg = claude_config()
    effort = (cfg.get("effort_by_kind") or {}).get(kind or "") or cfg.get("effort")
    cap = cfg.get("effort")
    if effort and cap in EFFORTS and EFFORTS.index(effort) > EFFORTS.index(cap):
        effort = cap
    return cfg.get("model"), effort, "claude.json" if cfg else "Claude Code default (no claude.json)"


def running_count(conn):
    """How many Claude sessions are open right now: every live Claude agent in herdr, i.e. Zed itself, its workers
    and the user's own, because they all draw on the same plan. Falls back to the DB's own sessions when herdr
    can't be listed."""
    live = live_agents()
    if live:
        return sum(1 for a in live.values() if a.get("agent") == "claude")
    return conn.execute("SELECT COUNT(*) FROM sessions WHERE external=0 AND status IN ('running','waiting_user')").fetchone()[0]


def require_capacity(conn, tid):
    """At most claude.json max_running sessions, counting all of them (see running_count): a plan's limits are
    shared. Beyond it the task stays queued (exit 75)."""
    cap = claude_config().get("max_running")
    n = running_count(conn)
    if cap is not None and n >= cap:
        print(f"zed: queued: {n} Claude sessions are open (Zed, workers and your own; max_running {cap} in claude.json). "
              f"T{tid} stays queued; spawn it again when one finishes (`bin/zed session list`).", file=sys.stderr)
        sys.exit(75)


def projects():
    if not PROJECTS_PATH.exists():
        die(f"{PROJECTS_PATH} is missing; add the user's repos there (see profile.template/config/).")
    return json.loads(PROJECTS_PATH.read_text())


def project(repo):
    p = projects()["repos"].get(repo)
    if not p:
        die(f"unknown repo '{repo}'. Known: {', '.join(projects()['repos'])}")
    return p


def expand(path):
    return Path(os.path.expandvars(os.path.expanduser(path)))


def parse_kv(args):
    out = {}
    for a in args:
        if "=" not in a:
            die(f"expected key=value, got '{a}'")
        k, v = a.split("=", 1)
        out[k] = v
    return out


def log_event(conn, task_id, kind, text):
    conn.execute("INSERT INTO events(task_id, ts, kind, text) VALUES (?,?,?,?)", (task_id, now(), kind, text))


def touch_task(conn, task_id):
    conn.execute("UPDATE tasks SET updated_at=? WHERE id=?", (now(), task_id))


def get_task(conn, tid):
    t = conn.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
    if not t:
        die(f"no task {tid}")
    return t


def session_ref(arg):
    """`S61` -> `61`; an agent name or a bare id is returned unchanged."""
    return arg[1:] if arg[:1] == "S" and arg[1:].isdigit() else arg


def resolve_session(conn, ref):
    """Session by numeric id or agent name."""
    if str(ref).isdigit():
        s = conn.execute("SELECT * FROM sessions WHERE id=?", (int(ref),)).fetchone()
    else:
        s = conn.execute("SELECT * FROM sessions WHERE agent=? ORDER BY id DESC", (ref,)).fetchone()
    if not s:
        die(f"no session '{ref}'")
    return s


# ---------------------------------------------------------------- status

def herdr_agents():
    """{pane_id: agent} for every agent herdr knows, or None when herdr can't be reached."""
    try:
        r = run(["herdr", "agent", "list"], check=False)
    except OSError:  # herdr isn't installed
        return None
    if r.returncode != 0:
        return None
    try:
        agents = json.loads(r.stdout)["result"]["agents"]
    except (ValueError, KeyError):
        return None
    return {a["pane_id"]: a for a in agents}


STALL_MINUTES = 30          # running with no plan progress for this long → watch event


def note_session_id(conn, s, a):
    """Remember the agent CLI's own session id (needed to find its transcript after it closes)."""
    sid = (a or {}).get("agent_session", {}).get("value")
    if sid and s["claude_session_id"] != sid:
        conn.execute("UPDATE sessions SET claude_session_id=? WHERE id=?", (sid, s["id"]))
        return sid
    return s["claude_session_id"]


def claude_usage(worktree, sid):
    """Tokens a Claude Code session used, including its sub-agents and workflows, from its transcripts
    (~/.claude/projects/<cwd>/<sid>.jsonl and <sid>/**). None if not found."""
    if not worktree or not sid:
        return None
    root = Path.home() / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(worktree)) / sid
    files = [root.with_suffix(".jsonl")] + sorted(root.glob("**/*.jsonl"))
    if not files[0].exists():
        return None
    total, seen = {"output": 0, "input": 0, "cache_read": 0, "cache_write": 0}, set()
    for f in files:
        for line in f.read_text(errors="replace").splitlines():
            try:
                r = json.loads(line)
            except ValueError:
                continue
            m = r.get("message")
            u = m.get("usage") if isinstance(m, dict) else None
            if not u or (m.get("id"), r.get("requestId")) in seen:
                continue
            seen.add((m.get("id"), r.get("requestId")))
            total["output"] += u.get("output_tokens") or 0
            total["input"] += u.get("input_tokens") or 0
            total["cache_read"] += u.get("cache_read_input_tokens") or 0
            total["cache_write"] += u.get("cache_creation_input_tokens") or 0
    return total


def fmt_usage(u):
    return (f"{u['output'] / 1e6:.2f}M output, {(u['input'] + u['cache_write']) / 1e6:.1f}M input, "
            f"{u['cache_read'] / 1e6:.0f}M cache-read tokens")


def task_plan_progress(conn, task_id):
    """(done, total) over the plans of the task's build and fix sessions."""
    done = todo = 0
    for plan in plan_files(conn, task_id):
        d, t = plan_progress(plan)
        done, todo = done + d, todo + t
    return done, done + todo


def session_plan_progress(conn, s):
    """(done, total) of the session's own plan; the task's build progress when it recorded none (older sessions)."""
    plan = zedlib.session_plan(s)
    if plan and plan.is_file():
        d, t = plan_progress(plan)
        return d, d + t
    return task_plan_progress(conn, s["task_id"])


def spend_rows():
    try:
        return [json.loads(l) for l in SPEND_LEDGER_PATH.read_text().splitlines() if l.strip()]
    except FileNotFoundError:
        return []


def record_spend(conn, s):
    """Append what a session cost (tokens), how long it ran and how far its plan got to the spend ledger
    (db/spend.jsonl), when it is closed."""
    if s["external"]:
        return
    usage = claude_usage(s["worktree"], s["claude_session_id"])
    done, total = session_plan_progress(conn, s)
    started = datetime.strptime(s["created_at"], "%Y-%m-%d %H:%M")
    row = {"ts": now(), "session": s["id"], "task": s["task_id"], "repo": s["repo"],
           "model": s["model"], "effort": s["effort"], "minutes": int((datetime.now() - started).total_seconds() // 60),
           "tokens": usage, "plan_done": done, "plan_total": total}
    SPEND_LEDGER_PATH.parent.mkdir(parents=True, exist_ok=True)
    with SPEND_LEDGER_PATH.open("a") as f:
        f.write(json.dumps(row) + "\n")


def spend_line(conn, task_id, rows):
    """Spend against plan progress for a task, from its closed sessions' ledger rows."""
    mine = [r for r in rows if r["task"] == task_id]
    if not mine:
        return None
    out = sum((r["tokens"] or {}).get("output", 0) for r in mine)
    done, total = task_plan_progress(conn, task_id)
    spend = f"{out / 1e6:.2f}M output tokens" if out else "no usage recorded"
    return (f"- spend (closed sessions): {spend}, {sum(r['minutes'] for r in mine)} min, plan {done}/{total} steps"
            + (f" (~{out / done / 1e3:.0f}k output tokens per step done)" if out and done else ""))


def plan_files(conn, task_id):
    """The build and fix plans of a task (never review, QA or verify plans)."""
    return zedlib.task_plans(conn, task_id)


def session_plan_files(s):
    plan = zedlib.session_plan(s)
    return [plan] if plan and plan.is_file() else []


def live_agents():
    return herdr_agents() or {}


def render_status(conn, live=None):
    live = live if live is not None else live_agents()
    ledger = spend_rows()
    lines = ["# Zed status", "", f"_Generated {now()} from the task DB (`bin/zed status`). Do not edit by hand._", ""]

    open_q = conn.execute(
        "SELECT q.*, t.ticket, t.title FROM questions q LEFT JOIN tasks t ON t.id=q.task_id "
        "WHERE q.status='open' ORDER BY q.id").fetchall()
    lines.append("## Waiting on you")
    lines.append("")
    if open_q:
        for q in open_q:
            tag = f"T{q['task_id']} {q['ticket'] or ''}".strip() if q["task_id"] else "general"
            lines.append(f"- **Q{q['id']}** ({tag}, asked {q['asked_at']}): {q['question']}")
    else:
        lines.append("- Nothing.")
    lines.append("")

    def task_block(t):
        out = [f"### T{t['id']} · {t['ticket'] or 'no-ticket'} · {t['title']}",
               f"- status: **{t['status']}** · worktype: {t['worktype'] or '-'} · updated {t['updated_at']}"]
        if t["description"]:
            out.append(f"- {t['description']}")
        for s in conn.execute("SELECT * FROM sessions WHERE task_id=? ORDER BY id", (t["id"],)):
            state = s["status"]
            if s["status"] in ("running", "waiting_user") and s["pane_id"]:
                a = live.get(s["pane_id"])
                state += f" / agent {a['agent_status']}" if a else " / agent NOT FOUND"
            pr = f" · PR {s['pr_url']}" if s["pr_url"] else ""
            ext = " (external)" if s["external"] else ""
            rt = (f" · {s['model']}" if s["model"] else "") + (f" ({s['effort']})" if s["effort"] else "")
            u = claude_usage(s["worktree"], s["claude_session_id"])
            usage = f" · {fmt_usage(u)}" if u else ""
            out.append(f"- S{s['id']}{ext} `{s['agent']}` {s['repo']} `{s['branch']}` ← `{s['base']}` · {state}{rt}{usage}{pr}")
        for plan in plan_files(conn, t["id"]):
            done, todo = plan_progress(plan)
            out.append(f"- plan `{plan.name}`: {done}/{done + todo} steps done{awaiting_note([plan])}")
        for s in conn.execute(f"SELECT * FROM sessions WHERE task_id=? AND status IN ('running','waiting_user') AND NOT {zedlib.AUTHOR_SESSION} ORDER BY id", (t["id"],)):
            if plan := next(iter(session_plan_files(s)), None):
                done, todo = plan_progress(plan)
                out.append(f"- S{s['id']} {s['hat']} plan `{plan.name}`: {done}/{done + todo} steps done")
        if line := spend_line(conn, t["id"], ledger):
            out.append(line)
        last = conn.execute("SELECT * FROM events WHERE task_id=? ORDER BY id DESC LIMIT 3", (t["id"],)).fetchall()
        for e in reversed(last):
            out.append(f"  - {e['ts']} [{e['kind']}] {e['text']}")
        out.append("")
        return out

    for header, states in TASK_GROUPS:
        rows = conn.execute(
            f"SELECT * FROM tasks WHERE status IN ({','.join('?'*len(states))}) ORDER BY id", states).fetchall()
        lines.append(f"## {header}")
        lines.append("")
        if not rows:
            lines.append("- None.")
            lines.append("")
        for t in rows:
            lines.extend(task_block(t))

    done = conn.execute(
        "SELECT * FROM tasks WHERE status IN ('done','cancelled') ORDER BY updated_at DESC LIMIT 20").fetchall()
    lines.append("## Recently finished")
    lines.append("")
    if not done:
        lines.append("- None.")
    for t in done:
        prs = [s["pr_url"] for s in conn.execute("SELECT pr_url FROM sessions WHERE task_id=? AND pr_url IS NOT NULL", (t["id"],))]
        lines.append(f"- T{t['id']} {t['ticket'] or ''} {t['title']} — {t['status']} {t['updated_at']}"
                     + (f" — {', '.join(prs)}" if prs else ""))
    lines.append("")
    return "\n".join(lines)


def write_status(conn):
    if holds_lock():  # read-only sessions never write
        STATUS_PATH.write_text(render_status(conn))


# ---------------------------------------------------------------- commands

TASK_FIELDS = ("title", "ticket", "worktype", "description", "status")


def cmd_task(args):
    if not args:
        die("task add|set|show|list")
    sub, rest = args[0], args[1:]
    conn = db()
    if sub in ("add", "set"):
        require_lock()
    if sub == "add":
        kv = parse_kv(rest)
        if "title" not in kv:
            die("task add title=... [ticket=<ticket-id>] [worktype=<e.g. story>] [description=...] [status=intake]")
        unknown = sorted(set(kv) - set(TASK_FIELDS))
        if unknown:
            die(f"cannot set '{unknown[0]}' on a task")
        ts = now()
        cur = conn.execute(
            "INSERT INTO tasks(title,ticket,worktype,description,status,created_at,updated_at) VALUES (?,?,?,?,?,?,?)",
            (kv["title"], kv.get("ticket"), kv.get("worktype"), kv.get("description"), kv.get("status", "intake"), ts, ts))
        log_event(conn, cur.lastrowid, "created", kv["title"])
        print(f"T{cur.lastrowid}")
    elif sub == "set":
        tid, kv = int(rest[0].lstrip("T")), parse_kv(rest[1:])
        get_task(conn, tid)
        for k, v in kv.items():
            if k not in TASK_FIELDS:
                die(f"cannot set '{k}' on a task")
            if k == "status" and v not in TASK_STATES:
                die(f"status must be one of {TASK_STATES}")
            conn.execute(f"UPDATE tasks SET {k}=? WHERE id=?", (v, tid))
            log_event(conn, tid, "update", f"{k} → {v}")
        touch_task(conn, tid)
    elif sub == "show":
        tid = int(rest[0].lstrip("T"))
        t = get_task(conn, tid)
        print(json.dumps(dict(t), indent=2))
        print("sessions:")
        for s in conn.execute("SELECT * FROM sessions WHERE task_id=?", (tid,)):
            print("  " + json.dumps(dict(s)))
        print("questions:")
        for q in conn.execute("SELECT * FROM questions WHERE task_id=?", (tid,)):
            print(f"  Q{q['id']} [{q['status']}] {q['question']}" + (f"\n     → {q['answer']}" if q["answer"] else ""))
        print("events:")
        for e in conn.execute("SELECT * FROM events WHERE task_id=? ORDER BY id", (tid,)):
            print(f"  {e['ts']} [{e['kind']}] {e['text']}")
    elif sub == "list":
        allrows = "--all" in rest
        q = "SELECT * FROM tasks" + ("" if allrows else f" WHERE status IN ({','.join('?'*len(OPEN_TASK_STATES))})") + " ORDER BY id"
        for t in conn.execute(q, () if allrows else OPEN_TASK_STATES):
            print(f"T{t['id']:<4} {t['status']:<13} {t['ticket'] or '-':<10} {t['title']}")
    else:
        die(f"unknown task subcommand {sub}")
    conn.commit()
    write_status(conn)


def cmd_log(args):
    if len(args) < 2:
        die("log <task-id|-> <text> [kind=note]")
    conn = db()
    require_lock()
    tid = None if args[0] == "-" else int(args[0].lstrip("T"))
    kind = "note"
    text_parts = []
    for a in args[1:]:
        if a.startswith("kind="):
            kind = a[5:]
        else:
            text_parts.append(a)
    log_event(conn, tid, kind, " ".join(text_parts))
    if tid:
        touch_task(conn, tid)
    conn.commit()
    write_status(conn)


def add_question(conn, tid, sid, text):
    """Record an open question for the user; marks the task and session as waiting on them."""
    cur = conn.execute("INSERT INTO questions(task_id,session_id,question,asked_at) VALUES (?,?,?,?)",
                       (tid, sid, text, now()))
    if tid:
        log_event(conn, tid, "question", f"Q{cur.lastrowid}: {text}")
        conn.execute("UPDATE tasks SET status='waiting_user' WHERE id=? AND status='active'", (tid,))
        touch_task(conn, tid)
    if sid:
        conn.execute("UPDATE sessions SET status='waiting_user', updated_at=? WHERE id=?", (now(), sid))
    return cur.lastrowid


def question(conn, ref):
    q = conn.execute("SELECT * FROM questions WHERE id=?", (int(str(ref).lstrip("Q")),)).fetchone() if re.fullmatch(r"Q?\d+", str(ref)) else None
    if not q:
        die(f"no question {ref}")
    return q


def answer_question(conn, q, ans):
    """Record the user's answer; the task and the session stop waiting once none of their questions is open."""
    conn.execute("UPDATE questions SET answer=?, status='answered', answered_at=? WHERE id=?", (ans, now(), q["id"]))
    if q["task_id"]:
        log_event(conn, q["task_id"], "answer", f"Q{q['id']}: {ans}")
        touch_task(conn, q["task_id"])
        still_open = conn.execute("SELECT COUNT(*) FROM questions WHERE task_id=? AND status='open'", (q["task_id"],)).fetchone()[0]
        if not still_open:
            conn.execute("UPDATE tasks SET status='active' WHERE id=? AND status='waiting_user'", (q["task_id"],))
    if q["session_id"]:
        still_open = conn.execute("SELECT COUNT(*) FROM questions WHERE session_id=? AND status='open'", (q["session_id"],)).fetchone()[0]
        if not still_open:
            conn.execute("UPDATE sessions SET status='running', updated_at=? WHERE id=? AND status='waiting_user'", (now(), q["session_id"]))


def cmd_q(args):
    if not args:
        die("q add <task-id|-> <question> [session=S] | q answer <qid> <answer> | q list")
    sub, rest = args[0], args[1:]
    conn = db()
    if sub in ("add", "answer"):
        require_lock()
    if sub == "add":
        tid = None if rest[0] == "-" else int(rest[0].lstrip("T"))
        sid = None
        parts = []
        for a in rest[1:]:
            if a.startswith("session="):
                sid = int(a[8:].lstrip("S"))
            else:
                parts.append(a)
        print(f"Q{add_question(conn, tid, sid, ' '.join(parts))}")
    elif sub == "answer":
        answer_question(conn, question(conn, rest[0]), " ".join(rest[1:]))
    elif sub == "list":
        for q in conn.execute("SELECT * FROM questions WHERE status='open' ORDER BY id"):
            ids = [f"{p}{q[k]}" for p, k in (("Q", "id"), ("T", "task_id"), ("S", "session_id")) if q[k] is not None]
            print(f"{' '.join(ids)} {q['asked_at']}: {q['question']}")
    else:
        die(f"unknown q subcommand {sub}")
    conn.commit()
    write_status(conn)


def slugify(s, n=40):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:n].strip("-")


def worker_rules_text():
    """Core worker rules + the profile's rules.md, with {{ZED_HOME}} / {{PROFILE}} filled in."""
    text = CORE_WORKER_RULES.read_text()
    if PROFILE_RULES.exists():
        text += "\n\n" + PROFILE_RULES.read_text()
    return text.replace("{{ZED_HOME}}", str(ZED_HOME)).replace("{{PROFILE}}", str(PROFILE_DIR))


def claude_launch(agent, model, effort, kit):
    """CLI arguments to start a worker with its `kit` (hat_kit): the rules file and the hat's deny policy.
    --add-dir: workers read their brief, rules and knowledge from the profile outside their worktree."""
    return ["--permission-mode", "auto", "-n", agent, "--append-system-prompt-file", str(kit["rules"]),
            "--add-dir", str(PROFILE_DIR), *(["--model", model] if model else []), *(["--effort", effort] if effort else []),
            "--settings", str(kit["claude_settings"])]


def hat_kit(hat, sid, agent, worktree, runtime="claude"):
    """What a hat session starts with, written under profile/.cache/hats/: the rules (worker rules and the hat's
    charter) and the hat's deny policy (bin/zed-deny as a Claude hook, or as an OpenCode plugin when `runtime` is
    opencode). Returns the kit for claude_launch or start_opencode, plus the env that identifies the session to its
    hooks and scripts.
    OpenCode: the kit's directory is the OPENCODE_CONFIG_DIR of the worker's own server. Its AGENTS.md (the rules) is
    loaded as OpenCode's global instruction file, next to the repository's own AGENTS.md, which is never touched."""
    out = PROFILE_DIR / ".cache" / "hats"
    out.mkdir(parents=True, exist_ok=True)
    kit = {"rules": out / f"{agent}-rules.md"}
    rules = worker_rules_text() + "\n\n" + emp.hat_charter(hat)
    kit["rules"].write_text(rules)
    identity = {"ZED_HAT": hat, "ZED_SESSION": f"S{sid}", "ZED_WORKTREE": str(worktree),
                "ZED_PROFILE_DIR": str(PROFILE_DIR)}  # so zed-employee and zed-deny find this profile, wherever it is
    env = [f"{k}={v}" for k, v in identity.items()]
    deny_tools = (zedlib.settings().get("worker") or {}).get("deny_tools") or []
    if runtime == "opencode":
        config_dir = zeddeny.opencode_plugin(out / f"{agent}-opencode", ZED_HOME, identity, deny_tools)
        (config_dir / "AGENTS.md").write_text(rules + "\n\n" + OPENCODE_RULES_NOTE)
        kit["opencode_server"] = private_server(config_dir / "server.log")
        env += [f"OPENCODE_CONFIG_DIR={config_dir}", f"OPENCODE_PASSWORD={kit['opencode_server']['password']}"]
    else:
        kit["claude_settings"] = out / f"{agent}-settings.json"
        kit["claude_settings"].write_text(json.dumps(zeddeny.claude_settings(ZED_HOME, deny_tools), indent=2) + "\n")
    return kit, env


def private_server(log):
    """Address, password and log file of an OpenCode server that is about to be started, on a port that is free now."""
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return {"url": f"http://127.0.0.1:{s.getsockname()[1]}", "password": secrets.token_urlsafe(24), "log": log}


def opencode_api(server, method, path, body=None, timeout=30):
    """One request to a worker's own OpenCode server (`server`: its url and password); returns the response's `data`.
    Raises OSError when the server does not answer or refuses."""
    token = base64.b64encode(f"opencode:{server['password']}".encode()).decode()
    req = urllib.request.Request(f"{server['url']}/api{path}", method=method,
                                 data=None if body is None else json.dumps(body).encode(),
                                 headers={"content-type": "application/json", "authorization": f"Basic {token}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        text = r.read().decode()
    answer = json.loads(text) if text.strip() else None
    return answer["data"] if isinstance(answer, dict) and "data" in answer else answer


def opencode_canary(server, session, program=zeddeny.CANARY_COMMAND, plugin="deny plugin"):
    """Prove a guard plugin is live in this server, in this session: ask for one shell call that the guard always
    denies (`program`: zed-deny's canary for a worker, zed-pretool's for the coordinator) and read back what happened
    to it. Returns "" when the call was stopped with the guard's reason, else why the guard is not proven. OpenCode has
    no API that runs a tool without the model (its `session.shell` is the user's shell and passes no tool hook), so
    the call takes one model turn; a model that makes no call proves nothing, and the session is refused."""
    command = f"{program} {secrets.token_hex(4)}"
    opencode_api(server, "POST", f"/session/{session}/prompt", {"text": (
        f"Startup check. Call the shell tool exactly once with exactly this command: {command}\n"
        "It is expected to be refused. Do not retry it and do nothing else. Then reply with the single word CHECKED.")})
    opencode_api(server, "POST", f"/experimental/session/{session}/wait", timeout=OPENCODE_CANARY_SECONDS)  # the turn's end
    calls = [part for m in opencode_api(server, "GET", f"/session/{session}/message") for part in m.get("content") or []
             if part.get("type") == "tool" and ((part.get("state") or {}).get("input") or {}).get("command", "").strip() == command]
    if not calls:
        return f"the model made no canary call, so the {plugin} is not proven live"
    state = calls[0]["state"]
    reason = str((state.get("error") or {}).get("message", ""))
    if state.get("status") == "error" and f"canary: `{command}`" in reason:
        return ""
    return f"the canary call `{command}` was not denied (status {state.get('status')}): the {plugin} is not live"


def opencode_session(server, directory, title, model, variant):
    """Wait for an OpenCode server that was just started, then create a session in `directory` with `model`
    ("provider/model") and `variant`. Returns (the session id or None, "" or why it is not the configured session).
    Raises OSError when the server does not answer in OPENCODE_SERVER_SECONDS."""
    deadline = time.monotonic() + OPENCODE_SERVER_SECONDS
    while True:
        try:
            opencode_api(server, "GET", "/info", timeout=5)
            break
        except OSError:
            if time.monotonic() > deadline:
                raise
            time.sleep(1)
    provider, _, name = model.partition("/")
    wanted = {"providerID": provider, "id": name, "variant": variant}
    created = opencode_api(server, "POST", "/session", {"location": {"directory": str(directory)}, "title": title, "model": wanted})
    if created.get("model") != wanted:
        return created["id"], f"the session runs {created.get('model')}, not the configured {wanted}"
    return created["id"], ""


def start_opencode(agent, pane_id, worktree, kit, model, variant):
    """Start an OpenCode worker: its own server as a background job of its pane (it ends with the pane), a session
    created with `model` and `variant`, the canary, then the TUI attached to that session. Returns (the OpenCode
    session id or None, "" or why the worker must not get its brief). The TUI is not started for a worker whose guard
    is not proven."""
    server = kit["opencode_server"]
    port = server["url"].rsplit(":", 1)[1]
    run(["herdr", "pane", "run", pane_id, f"opencode serve --print-logs --log-level warn --hostname 127.0.0.1 --port {port} "
                                          f"> {shlex.quote(str(server['log']))} 2>&1 &"])  # the log names a plugin that failed to load
    session = None
    try:
        session, problem = opencode_session(server, worktree, agent, model, variant)
        if problem or (problem := opencode_canary(server, session)):
            return session, problem
    except (OSError, ValueError, KeyError, TypeError) as e:
        return session, f"its OpenCode server at {server['url']} failed ({type(e).__name__}: {e}); its log: {server['log']}"
    r = run(["herdr", "agent", "start", agent, "--kind", "opencode", "--pane", pane_id, "--timeout", str(OPENCODE_START_TIMEOUT_MS),
             "--", "--server", server["url"], "--auto", "--session", session], check=False)
    if r.returncode:
        return session, f"agent start did not report ready (pane {pane_id}). Inspect with: herdr agent read {agent}\n{r.stderr}"
    return session, ""


def start_dialog_on_screen(agent):
    """The one of START_DIALOGS the agent's screen shows, or None."""
    screen = run(["herdr", "agent", "read", agent, "--source", "visible"], check=False).stdout
    return next((d for d in START_DIALOGS if d.text in screen), None)


def answer_start_dialogs(agent, started, seconds=60):
    """Answer each of START_DIALOGS the CLI shows at startup, once, until the agent is ready for its brief. Returns
    (the dialogs answered, whether it is ready). `started`: herdr's own start reported ready. Ready means herdr says
    idle AND none of the dialogs is on screen, answered or not: herdr reports "blocked" for every dialog alike and may
    report idle between two of them, so the screen has the last word. Herdr not ready and none of the dialogs on screen
    before any was answered: left blocked for Zed to inspect. `seconds` bounds the wait by the clock."""
    answered, deadline = [], time.monotonic() + seconds
    while time.monotonic() < deadline:
        idle = herdr_json(["agent", "get", agent])["result"]["agent"]["agent_status"] == "idle"
        dialog = start_dialog_on_screen(agent)  # read after the status: a dialog drawn since then still shows
        if dialog and dialog not in answered:
            run(["herdr", "agent", "send-keys", agent, *dialog.keys], check=False)
            answered.append(dialog)
        elif idle and not dialog:
            return answered, True
        elif not (dialog or answered or started):
            break
        time.sleep(0.5)
    return answered, False


def started_since(agent, before, seconds):
    """True once the agent has worked, is blocked on a dialog, or changed state since sequence `before`."""
    for _ in range(int(seconds / 0.25)):
        a = herdr_json(["agent", "get", agent])["result"]["agent"]
        if a["agent_status"] in ("working", "blocked") or (a.get("state_change_seq") or 0) > (before or 0):
            return True
        time.sleep(0.25)
    return False


def prompt_worker(agent, text):
    """Submit `text` to the agent and confirm it started. Herdr's five-second activity gate can expire before a slow
    CLI starts its turn, so activity is also watched for 10 s. If none shows, the text may be sitting unsent in the
    input box (seen: a pasted brief whose Enter was swallowed, the agent idle for 31 minutes): Enter is pressed once,
    which submits it, and does nothing on an empty box, so the text is never sent twice. Still idle: a wake event is
    queued and (False, reason) returned."""
    before = herdr_json(["agent", "get", agent])["result"]["agent"].get("state_change_seq", 0)
    r = run(["herdr", "agent", "prompt", agent, text,
             "--wait", "--until", "working", "--until", "blocked", "--timeout", "30000"], check=False)
    if r.returncode == 0:
        return True, ""
    if "agent_prompt_stalled" not in r.stderr:
        return False, r.stderr or r.stdout
    if started_since(agent, before, 10):
        return True, ""
    run(["herdr", "agent", "send-keys", agent, "enter"], check=False)
    if started_since(agent, before, 10):
        return True, ""
    queue_add([f"{agent} · prompt not picked up: still idle 20 s after submitting it and pressing Enter once "
               f"(read its screen: `herdr agent read {agent}`); it will not be retried"])
    return False, r.stderr or r.stdout


def worktree_path(repo, branch):
    return expand(projects()["worktree_root"]) / repo / slugify(branch.split("/")[-1], 60)


FILL = re.compile(r"<FILL\b[^>\n]*>")  # what `zed brief` leaves for the model to write; spawn refuses it


def knowledge_qa_notes(repo, limit=30):
    """How to run and log in, from the repo's knowledge file: its QA/login/run/test sections, capped."""
    path = PROFILE_DIR / "knowledge" / "repos" / f"{repo}.md"
    if not path.exists():
        return f"no notes yet at {path}; ask Zed if unclear"
    keep, on = [], False
    for line in path.read_text().splitlines():
        if line.startswith("#"):
            on = bool(re.search(r"\b(qa|log ?in|run|test|setup|start)", line, re.I))
        if on:
            keep.append(line)
    if not keep:
        return f"see {path}"
    return f"from {path}:\n" + "\n".join(keep[:limit]) + (f"\n… ({len(keep) - limit} more lines in the file)" if len(keep) > limit else "")


def cmd_brief(args):
    """brief <T> repo= base= branch= [force] — scaffold profile/briefs/T<id>-<repo>.md from the task, projects.json,
    the repo's knowledge file and the plan block. The model writes only what is marked <FILL: …>."""
    if not args:
        die("brief <T> repo=<repo> base=<branch> branch=<branch> [force]")
    tid = int(args[0].lstrip("T"))
    kv = parse_kv([a for a in args[1:] if a != "force"])
    for k in ("repo", "base", "branch"):
        if k not in kv:
            die(f"brief needs {k}=")
    conn = db()
    t = get_task(conn, tid)
    p = project(kv["repo"])
    out = PROFILE_DIR / "briefs" / f"T{tid}-{kv['repo']}.md"
    if out.exists() and "force" not in args:
        die(f"{out} exists; pass `force` to overwrite it")
    worktree = expand(p["path"]) if p.get("worktrees") is False else worktree_path(kv["repo"], kv["branch"])
    values = {"TASK": tid, "TICKET_ID": t["ticket"] or "no ticket", "TITLE": t["title"], "REPO": kv["repo"],
              "ROLE": p.get("role", "-"), "WORKTREE": worktree, "BRANCH": kv["branch"], "BASE": kv["base"],
              "TICKET_LINE": f"{t['ticket']} — read it for full details; ask Zed if you can't reach it" if t["ticket"] else "none",
              "QA_ENV": knowledge_qa_notes(kv["repo"]), "PLAN_FILE": PROFILE_DIR / "briefs" / f"T{tid}-{kv['repo']}-plan.md"}
    text = (ZED_HOME / "templates" / "brief.md").read_text()
    for k, v in values.items():
        text = text.replace("{{" + k + "}}", str(v))
    if t["description"]:
        text = text.replace("<FILL: what the user wants, in their words where possible>",
                            f"{t['description']}\n<FILL: anything the task description above leaves out, or \"nothing\">")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text)
    print(f"{out}\nfill these, then spawn:")
    for n, line in enumerate(text.splitlines(), 1):
        if FILL.search(line):
            print(f"  line {n}: {FILL.search(line).group(0)}")


SPAWN_KEYS = {"repo", "base", "branch", "brief", "name", "model", "effort", "kind", "from", "hat", "runtime"}

def cmd_spawn(args):
    """spawn <task-id> repo=<repo> base=<branch> branch=<branch> brief=<path> [name=<agent>]
    [model=] [effort=] [kind=<worktype|investigation|design…>] [from=<start point>]
    [hat=build|review|qa]   the hat the session wears (default build)
    [runtime=claude|opencode]   claude (default); opencode takes its model and variant from config/opencode.json
                                (model= overrides the model; no effort=, no claude.json policy)"""
    if not args or args[0] in ("-h", "--help"):
        print(cmd_spawn.__doc__)
        sys.exit(0 if args else 1)
    tid = int(args[0].lstrip("T"))
    kv = parse_kv(args[1:])
    for k in ("repo", "base", "branch", "brief"):
        if k not in kv:
            die(f"spawn needs {k}=")
    if unknown := sorted(set(kv) - SPAWN_KEYS):
        die(f"spawn does not take {', '.join(k + '=' for k in unknown)} (workers wear a hat, not a name: hat=build|review|qa; see `bin/zed help`)")
    conn = db()
    require_lock()
    t = get_task(conn, tid)
    p = project(kv["repo"])
    repo_path = expand(p["path"])
    brief = Path(kv["brief"]).resolve()
    if not brief.exists():
        die(f"brief not found: {brief}")
    left = FILL.findall(brief.read_text())
    if left:
        die(f"brief {brief.name} still has {len(left)} unfilled placeholder(s), e.g. {left[0]}; fill them before spawning")
    missing = [h for h in ("## Plan", "## Definition of done") if h not in brief.read_text()]
    if missing:
        die(f"brief {brief.name} lacks {', '.join(missing)} (templates/brief.md); no worker starts without a plan")
    hat = kv.get("hat", "build")
    runtime = kv.get("runtime") or install_runtime()
    if runtime not in RUNTIMES:
        die(f"runtime={runtime} is not supported: {' or '.join(RUNTIMES)}")
    if runtime == "opencode" and "effort" in kv:
        die("runtime=opencode takes no effort=: set \"variant\" in the profile's config/opencode.json")
    try:
        hat_kind = emp.load_manifest(hat)["kind"]
        zedgates.check_assignment(conn, hat, tid, kv["repo"], kv["branch"],
                                  None if p.get("worktrees") is False else worktree_path(kv["repo"], kv["branch"]))
    except (zedgates.Refused, emp.HatError) as e:
        die(f"refused: {e}")
    sid = conn.execute("SELECT COALESCE(MAX(id), 0) + 1 FROM sessions").fetchone()[0]  # the session's env names it
    kind = kv.get("kind") or t["worktype"]
    if hat_kind in (claude_config().get("effort_by_kind") or {}) and "kind" not in kv:
        kind = hat_kind  # the hat's own kind, when claude.json has an effort for it
    if runtime == "claude":
        require_capacity(conn, tid)
        model, effort, model_why = pick_model(kind)
    else:  # claude.json names Claude models and efforts: an OpenCode worker's model and variant are in opencode.json
        opencode = opencode_config()
        model, effort, model_why = opencode["model"], opencode["variant"], "opencode.json"  # `effort` carries the variant
    if "model" in kv:
        model, model_why = kv["model"], "given to spawn"
    if runtime == "opencode" and not re.fullmatch(r"[^/\s]+/\S+", model):
        die(f"an OpenCode model is written provider/model, not '{model}'")
    if "effort" in kv:
        effort, model_why = kv["effort"], model_why + "; effort given to spawn"
    if runtime == "claude" and effort and effort not in EFFORTS:  # an OpenCode variant is the model's own word
        die(f"invalid effort '{effort}': {EFFORTS}")

    agent = kv.get("name") or f"{hat}-t{tid}"
    if "name" not in kv and conn.execute("SELECT 1 FROM sessions WHERE agent=? AND status!='closed'", (agent,)).fetchone():
        agent = f"{agent}-{sid}"  # an earlier session of the same name is still open (finished, not yet closed)
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", agent):
        die(f"bad agent name '{agent}'")
    worktree = worktree_path(kv["repo"], kv["branch"])

    # 1. worktree (projects with "worktrees": false, e.g. plain doc folders, run in place)
    if p.get("worktrees") is False:
        worktree = repo_path
    elif worktree.exists():
        print(f"reusing existing worktree {worktree}")
    else:
        worktree.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "-C", str(repo_path), "fetch", "origin", kv["base"]])
        branch_exists = run(["git", "-C", str(repo_path), "rev-parse", "--verify", "--quiet", kv["branch"]], check=False).returncode == 0
        if branch_exists:
            run(["git", "-C", str(repo_path), "worktree", "add", str(worktree), kv["branch"]])
        else:
            start = kv.get("from", f"origin/{kv['base']}")
            run(["git", "-C", str(repo_path), "worktree", "add", "-b", kv["branch"], str(worktree), start])
        # Don't let the new branch track the base branch; worker pushes with -u.
        run(["git", "-C", str(worktree), "branch", "--unset-upstream"], check=False)
    if p.get("worktrees") is not False:
        actual = run(["git", "-C", str(worktree), "branch", "--show-current"]).stdout.strip()
        if actual != kv["branch"]:
            die(f"worktree {worktree} is on '{actual}', not '{kv['branch']}'; left untouched")
        guard = run([sys.executable, str(ZED_HOME / "bin" / "zed-guard"), "install", str(worktree), "--repo", kv["repo"],
                     "--base", kv["base"], "--gate", *(["--ticket", t["ticket"]] if t["ticket"] else ["--no-commit-format"])], check=False)
        if guard.returncode and "already pointing" not in guard.stderr:  # a reused worktree keeps its guard
            die(f"could not install the git guard in {worktree}; no worker started:\n{guard.stderr.strip() or guard.stdout.strip()}")

    scratch = None
    if p.get("worktrees") is False:  # in-place project: the worker's scratch goes in its own folder, removed on close
        scratch = worktree / f"T{tid}-{agent}"
        scratch.mkdir(exist_ok=True)

    # 2. herdr workspace + agent CLI
    require_lock()
    kit, env = hat_kit(hat, sid, agent, worktree, runtime)
    label = f"T{tid} {t['ticket'] or ''} {kv['repo']}".strip()
    ws = herdr_json(["workspace", "create", "--cwd", str(worktree), "--label", label, "--no-focus",
                     *[a for e in env for a in ("--env", e)]])["result"]
    ws_id, pane_id = ws["workspace"]["workspace_id"], ws["root_pane"]["pane_id"]
    time.sleep(1.5)  # let the shell reach its prompt
    runtime_session = None
    if runtime == "opencode":
        runtime_session, failure = start_opencode(agent, pane_id, worktree, kit, model, effort)
    else:
        r = run(["herdr", "agent", "start", agent, "--kind", "claude", "--pane", pane_id, "--timeout", "60000",
                 "--", *claude_launch(agent, model, effort, kit)], check=False)
        dialogs, ready = [], False
        if r.returncode == 0 or "agent_not_ready" in r.stderr:
            dialogs, ready = answer_start_dialogs(agent, started=r.returncode == 0)
        for dialog in dialogs:
            print(f"startup dialog: {dialog.name}: {dialog.note}")
        failure = "" if ready else f"agent start did not report ready (pane {pane_id}). Inspect with: herdr agent read {agent}\n{r.stderr}"
    ts = now()
    cur = conn.execute(
        "INSERT INTO sessions(id,task_id,repo,base,branch,worktree,agent,workspace_id,pane_id,claude_session_id,status,"
        "model,effort,brief,scratch,hat,plan,core_start,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
        (sid, tid, kv["repo"], kv["base"], kv["branch"], str(worktree), agent, ws_id, pane_id, runtime_session,
         # an OpenCode worker that failed its start checks is never briefed; a Claude one may wait on a dialog Zed answers
         "failed" if failure and runtime == "opencode" else "running", model, effort, str(brief), str(scratch) if scratch else None, hat,
         str(zedlib.brief_plan_file(brief.read_text()) or PROFILE_DIR / "briefs" / f"T{tid}-{kv['repo']}-plan.md"),
         zedlib.core_tree(worktree) if hat in zedgates.GATE_HATS else None, ts, ts))
    sid = cur.lastrowid
    conn.execute("UPDATE tasks SET status='active' WHERE id=? AND status IN ('intake','parked')", (tid,))
    log_event(conn, tid, "spawn", f"S{sid} {agent} on {kv['repo']} {kv['branch']} ← {kv['base']} ({worktree}); "
              f"model {model or 'default'} {'variant' if runtime == 'opencode' else 'effort'} {effort or 'default'} ({model_why})"
              + f"; wearing {hat}" + (f"; runtime {runtime}, session {runtime_session}" if runtime == "opencode" else "")
              + (f"; FAILED to start: {failure.splitlines()[0]}" if failure else ""))
    touch_task(conn, tid)
    conn.commit()
    write_status(conn)
    if failure:
        die(f"S{sid}: {failure}" + (f"\nNo brief was handed over and S{sid} is marked failed; its workspace {ws_id} is left open "
                                    f"to inspect (server log: {kit['opencode_server']['log']}). Remove it with: bin/zed close S{sid}"
                                    if runtime == "opencode" else ""))

    # 3. hand over the brief
    require_lock()
    STATUS_DIR.mkdir(parents=True, exist_ok=True)
    # OpenCode already loaded the rules as an instruction file (hat_kit): naming the file would load them twice
    rules = ("Your worker rules are already in your instructions (they begin '# You are a Zed worker'). Read"
             if runtime == "opencode" else f"Read your worker rules at {kit['rules']} and")
    text = (f"You are the engineering worker, NOT the Zed coordinator, for session S{sid} / task T{tid}. "
            f"Do not onboard, acquire the coordinator lock, or change the coordinator's task database. "
            f"Zed's home is {ZED_HOME}; the user's profile is {PROFILE_DIR}. "
            f"{rules} your brief at {brief}, then "
            f"{PROFILE_DIR}/knowledge/repos/{kv['repo']}.md if it exists. "
            f"Your status file is {STATUS_DIR}/S{sid}.log (see 'Report status' in your rules). ")
    text += hat_intro(conn, hat, tid)
    if scratch:
        text += (f"Your scratch folder is {scratch}: keep every clone, download and temporary file there and nowhere "
                 f"else in the project; Zed deletes it when your session closes. ")
    text += "Then start."
    if runtime == "opencode":  # admitted by the worker's server, not typed into its screen: the message id is the receipt
        try:
            admitted = opencode_api(kit["opencode_server"], "POST", f"/session/{runtime_session}/prompt", {"text": text})
            prompt_ok, prompt_error = bool(admitted["id"]), ""
        except (OSError, KeyError, TypeError) as e:
            prompt_ok, prompt_error = False, f"{type(e).__name__}: {e}"
    else:
        prompt_ok, prompt_error = prompt_worker(agent, text)
    print(json.dumps({"task": f"T{tid}", "session": f"S{sid}", "agent": agent, "pane": pane_id,
                      "workspace": ws_id, "worktree": str(worktree), "model": model,
                      "effort": effort, "model_choice": model_why, "prompt_ok": prompt_ok}))
    if not prompt_ok:
        die(f"S{sid}: brief submission did not report activity; inspect before retrying:\n{prompt_error}")
    return sid


def hat_intro(conn, hat, tid):
    """The hat's paragraph of the first prompt: the hat, its skills, and the findings drafts earlier sessions on this
    task left (a fix or a re-review starts from them, not from anyone's memory of the work)."""
    text = (f"You wear the {hat} hat. "
            f"Skills load when they apply (`zed-employee skill show <name>`): {', '.join(emp.load_manifest(hat)['skills'])}. "
            f"Before ZED:DONE run `zed-employee finish`. ")
    findings = [r["text"] for r in conn.execute("SELECT text FROM events WHERE task_id=? AND kind='findings' ORDER BY id", (tid,))]
    if findings:
        text += "Findings drafts from earlier sessions on this task, read them: " + "; ".join(findings) + ". "
    return text


def session_agent_state(s):
    a = live_agents().get(s["pane_id"])
    return a["agent_status"] if a else "gone"


def send_prompt(conn, s, text, redirect, what):
    """The one way Zed prompts a worker: refuses a `working` session unless redirect (lesson: don't derail a working session)."""
    if s["external"]:
        die(f"S{s['id']} is external (the user's own session): not prompted")
    state = session_agent_state(s)
    if state == "gone":
        die(f"S{s['id']} has no live agent")
    if reason := zedgates.prompt_refusal(state, redirect):
        die(f"refused: S{s['id']} {reason}")
    ok, err = prompt_worker(s["agent"], text)
    if not ok:
        die(f"prompt to S{s['id']} failed: {err.strip()}")
    log_event(conn, s["task_id"], "prompt", f"S{s['id']} {what}" + (" (redirect)" if redirect else ""))
    conn.commit()
    print(f"prompted S{s['id']} ({state}): {what}")


def cmd_prompt(args):
    """prompt <S|agent> [--redirect] (<text> | --file <path>) — prompt a worker; refuses a session that is `working`
    unless --redirect (a prompt mid-task is injected at the next tool boundary and can drop the rest of its plan)."""
    redirect, args = "--redirect" in args, [a for a in args if a != "--redirect"]
    if len(args) < 2:
        die("prompt <S|agent> [--redirect] (<text> | --file <path>)")
    conn = db()
    require_lock()
    s = resolve_session(conn, session_ref(args[0]))
    text = Path(args[2]).read_text() if args[1] == "--file" and len(args) > 2 else " ".join(args[1:])
    send_prompt(conn, s, text.strip(), redirect, "prompted by Zed")


DECISIONS_HEADING = "## Decisions already made by the user"  # templates/brief.md


def note_decision(brief, line):
    """Add `line` to the brief's decisions section (at its end; the section is added when the brief has none), so the
    answer survives a restart of the session."""
    lines = brief.read_text().splitlines()
    if DECISIONS_HEADING not in lines:
        lines += ["", DECISIONS_HEADING]
    start = lines.index(DECISIONS_HEADING) + 1
    end = next((i for i in range(start, len(lines)) if lines[i].startswith("## ")), len(lines))
    while end > start and not lines[end - 1].strip():
        end -= 1
    brief.write_text("\n".join(lines[:end] + [line] + lines[end:]) + "\n")


def cmd_relay(args):
    """relay <Q> <answer> [<Q> <answer> …] [--redirect] — the user's answers to workers' questions, in one command and
    in this order: each worker is prompted with its answers verbatim (one prompt per worker; refused while it is
    `working` unless --redirect, and then nothing is recorded), then the answers are recorded (as `q answer`) and
    noted in the session's brief. A question no session asked is only recorded."""
    redirect, args = "--redirect" in args, [a for a in args if a != "--redirect"]
    if not args or len(args) % 2:
        die('relay <Q> "<answer>" [<Q> "<answer>" …] [--redirect]: one quoted answer after each question id')
    conn = db()
    require_lock()
    answers = [(question(conn, ref), ans.strip()) for ref, ans in zip(args[::2], args[1::2])]
    if blank := [f"Q{q['id']}" for q, ans in answers if not ans]:
        die(f"no answer given for {', '.join(blank)}")
    by_session = {}
    for q, ans in answers:
        by_session.setdefault(q["session_id"], []).append((q, ans))
    sessions = {sid: resolve_session(conn, sid) for sid in by_session if sid is not None}
    for sid, s in sessions.items():  # every prompt first: a refusal leaves the record untouched
        parts = [f"Answer from the user to your question Q{q['id']} ({q['question'].splitlines()[0][:120]}): {ans}" for q, ans in by_session[sid]]
        send_prompt(conn, s, "\n".join(parts) + "\nContinue.", redirect, "relay: " + ", ".join(f"Q{q['id']}" for q, _ in by_session[sid]))
    for q, ans in answers:
        answer_question(conn, q, ans)
        s = sessions.get(q["session_id"])
        if s and s["brief"] and Path(s["brief"]).is_file():
            note_decision(Path(s["brief"]), f"- User ({now()}), Q{q['id']} \"{q['question'].splitlines()[0][:160]}\": \"{ans}\"")
    conn.commit()
    write_status(conn)
    print("recorded " + ", ".join(f"Q{q['id']}" for q, _ in answers))


def cmd_relay_post(args):
    """relay-post <S|agent> <user-words-file> --action "<exact action>" [--redirect] [--print] — relay the user's OK to
    post (a PR review, comment, ticket edit): the prompt carries their words verbatim plus the exact action, so the
    auto-mode classifier sees the request."""
    redirect, show = "--redirect" in args, "--print" in args
    args = [a for a in args if a not in ("--redirect", "--print")]
    if "--action" not in args or len(args) != 4 or args.index("--action") != 2:
        die('relay-post <S|agent> <user-words-file> --action "<exact action>" [--redirect] [--print]')
    words_file = Path(args[1])
    if not words_file.is_file():
        die(f"no such file: {words_file}")
    try:
        text = zedgates.relay_prompt(words_file.read_text(), args[3])
    except ValueError as e:
        die(str(e))
    conn = db()
    if show:
        print(text)
        return
    require_lock()
    s = resolve_session(conn, session_ref(args[0]))
    send_prompt(conn, s, text, redirect, f"relay-post: {args[3][:120]}")


def cmd_gate(args):
    """gate check <sha|branch> [repo-dir] — exit 0 when the commit's code (everything outside profile/) has a clean review
    and a clean qa verdict (both by sessions that did not author it); else print what is missing and exit 1. Read-only: usable by git hooks."""
    if len(args) < 2 or args[0] != "check":
        die("gate check <sha|branch> [repo-dir]")
    repo_dir = args[2] if len(args) > 2 else "."
    sha = run(["git", "-C", repo_dir, "rev-parse", "--verify", args[1] + "^{commit}"]).stdout.strip()
    conn = db()
    problems = zedgates.merge_problems(conn, zedlib.core_tree(repo_dir, sha))
    for p in problems:
        print(f"merge gate: {p}", file=sys.stderr)
    if problems and (override := os.environ.get("ZED_GATE_OVERRIDE", "").strip()):
        log_event(conn, None, "merge", f"gate overridden for {sha[:10]} (ZED_GATE_OVERRIDE): {override}")
        conn.commit()
        print(f"merge gate: overridden ({override}); logged", file=sys.stderr)
        problems = []
    sys.exit(1 if problems else 0)


def cmd_merge(args):
    """merge <branch> [repo-dir] [--override "<reason>"] — merge a worker branch into the current branch of repo-dir
    (default: Zed's checkout) with `git merge --no-ff`, only when the merge gate passes (clean review + clean qa by
    non-authors for the branch head's code, which ignores profile/). --override records the reason in the task log (the user's decision)."""
    override = args[args.index("--override") + 1] if "--override" in args and args.index("--override") + 1 < len(args) else None
    args = [a for i, a in enumerate(args) if a != "--override" and (i == 0 or args[i - 1] != "--override")]
    if not args:
        die('merge <branch> [repo-dir] [--override "<reason>"]')
    repo_dir = args[1] if len(args) > 1 else str(ZED_HOME)
    conn = db()
    require_lock()
    sha = run(["git", "-C", repo_dir, "rev-parse", "--verify", args[0] + "^{commit}"]).stdout.strip()
    problems = zedgates.merge_problems(conn, zedlib.core_tree(repo_dir, sha))
    if problems and not override:
        die("refused: " + "; ".join(problems) + '. Get the review and qa done, or pass --override "<reason>" (the user\'s call)')
    trial = run(["git", "-C", repo_dir, "merge-tree", "--write-tree", "--name-only", "HEAD", sha], check=False)  # writes objects only, never the checkout
    if trial.returncode != 0:
        files = [l for l in trial.stdout.splitlines()[1:] if l.strip() and ("\t" not in l) and not l.startswith(("Auto-merging", "CONFLICT"))]
        die(f"refused: merging {args[0]} into {run(['git', '-C', repo_dir, 'branch', '--show-current']).stdout.strip() or 'HEAD'} would conflict"
            + (f" in {', '.join(files)}" if files else f": {trial.stderr.strip()}")
            + f". Nothing was touched. Merge it into the branch first, resolve there, then merge again")
    row = conn.execute("SELECT task_id FROM sessions WHERE branch=? ORDER BY id DESC", (args[0],)).fetchone()
    log_event(conn, row["task_id"] if row else None, "merge",
              f"{args[0]} {sha[:10]} into {run(['git', '-C', repo_dir, 'branch', '--show-current']).stdout.strip()}"
              + (f"; gate overridden: {override}" if problems else "; gate passed"))
    conn.commit()
    os.environ["ZED_MERGE_GATE_DONE"] = sha  # the git hook (hooks/reference-transaction) skips only this vetted head
    try:
        r = run(["git", "-C", repo_dir, "merge", "--no-ff", args[0]], check=False)
    finally:
        del os.environ["ZED_MERGE_GATE_DONE"]
    print((r.stdout + r.stderr).strip())
    sys.exit(r.returncode)


def cmd_session(args):
    if not args:
        die("session set <S|agent> key=value... | session list")
    sub, rest = args[0], args[1:]
    conn = db()
    if sub == "set":
        require_lock()
        s = resolve_session(conn, session_ref(rest[0]))
        for k, v in parse_kv(rest[1:]).items():
            if k not in ("status", "pr_url", "claude_session_id", "pane_id", "workspace_id", "base", "brief"):
                die(f"cannot set '{k}' on a session")
            if k == "status" and v not in SESSION_STATES:
                die(f"status must be one of {SESSION_STATES}")
            conn.execute(f"UPDATE sessions SET {k}=?, updated_at=? WHERE id=?", (v, now(), s["id"]))
            log_event(conn, s["task_id"], "session", f"S{s['id']} {k} → {v}")
        touch_task(conn, s["task_id"])
    elif sub == "list":
        live = live_agents()
        for s in conn.execute("SELECT * FROM sessions WHERE status!='closed' ORDER BY id"):
            a = live.get(s["pane_id"])
            print(f"S{s['id']:<3} T{s['task_id']:<3} {s['agent']:<20} {s['status']:<13} "
                  f"agent={a['agent_status'] if a else 'GONE':<8} {s['repo']} {s['branch']}")
    else:
        die(f"unknown session subcommand {sub}")
    conn.commit()
    write_status(conn)


def close_workspace(ws_id):
    """Close a herdr workspace; one that is already gone counts as closed. Anything else fails loudly."""
    r = run(["herdr", "workspace", "close", ws_id], check=False)
    if r.returncode and "workspace_not_found" not in r.stdout + r.stderr:
        die(f"could not close herdr workspace {ws_id}:\n{r.stdout}{r.stderr}")


def pr_snapshot(url):
    """State of a PR as {"state": open|merged|closed, "reviews": n (reviews + comments), "checks": failing|passing|pending|None},
    or None if it can't be read. GitHub through `gh`; no model tokens."""
    try:
        if "github.com" in url:
            r = run(["gh", "pr", "view", url, "--json", "state,reviews,comments,statusCheckRollup"], check=False)
            if r.returncode:
                return None
            d = json.loads(r.stdout)
            rollup = d.get("statusCheckRollup") or []
            results = [(c.get("conclusion") or c.get("state") or "").upper() for c in rollup]
            checks = (None if not results else
                      "failing" if any(x in ("FAILURE", "TIMED_OUT", "CANCELLED", "ERROR", "STARTUP_FAILURE") for x in results) else
                      "pending" if any(x in ("", "PENDING", "IN_PROGRESS", "QUEUED", "EXPECTED") for x in results) else "passing")
            return {"state": d["state"].lower(), "reviews": len(d.get("reviews") or []) + len(d.get("comments") or []),
                    "checks": checks}
    except (ValueError, KeyError, OSError):
        pass
    return None


def main_checkout_heads(repo, worktree):
    """The branch checked out in the repo's own folder, as a list for `rev-list --not`: work merged into it survives
    removing the worktree. Empty when the repo is unknown, has no folder, or its HEAD is detached."""
    path = (projects()["repos"].get(repo) or {}).get("path") if PROJECTS_PATH.exists() else None
    main = expand(path) if path else None
    if not main or not main.is_dir() or main.resolve() == Path(worktree).resolve():
        return []
    ref = run(["git", "-C", str(main), "symbolic-ref", "-q", "HEAD"], check=False).stdout.strip()
    return [ref] if ref else []


def landed_blockers(conn, s, git_checks=True):
    """Why a session's work isn't landed yet, as a list of exact reasons (empty = safe to close): uncommitted or
    unpushed work, a PR that is still open, a plan with steps left, open questions."""
    out, wt = [], Path(s["worktree"])
    if git_checks and wt.exists():
        dirty = run(["git", "-C", str(wt), "status", "--porcelain"], check=False).stdout.strip().splitlines()
        if dirty:
            out.append(f"{len(dirty)} uncommitted file(s): " + ", ".join(l[3:] for l in dirty[:5]) + (" …" if len(dirty) > 5 else ""))
        # Commits no remote has: `@{u}..HEAD` is wrong when the upstream is the base branch (or none is set).
        # Commits already in the main checkout's branch (e.g. merged into a local-only profile branch) are kept safe.
        ahead = run(["git", "-C", str(wt), "rev-list", "HEAD", "--not", "--remotes", *main_checkout_heads(s["repo"], wt)],
                    check=False).stdout.split()
        if ahead:
            out.append(f"{len(ahead)} commit(s) not pushed")
    if s["pr_url"]:
        snap = pr_snapshot(s["pr_url"])
        if snap is None:
            out.append(f"PR state unknown (could not read {s['pr_url']})")
        elif snap["state"] == "open":
            out.append(f"PR still open: {s['pr_url']} (needs to be merged or closed)")
    done, total = session_plan_progress(conn, s)
    if done < total:
        out.append(f"plan has {total - done} of {total} steps left")
    open_q = conn.execute("SELECT COUNT(*) FROM questions WHERE session_id=? AND status='open'", (s["id"],)).fetchone()[0]
    if open_q:
        out.append(f"{open_q} open question(s) for the user")
    return out


def cmd_landed(args):
    """landed <S|agent> — the landed-work test `close` applies, without closing. Exit 1 and the reasons if not landed."""
    if not args:
        die("landed <S|agent>")
    conn = db()
    s = resolve_session(conn, session_ref(args[0]))
    blockers = landed_blockers(conn, s, git_checks=project(s["repo"]).get("worktrees") is not False and not s["external"])
    if blockers:
        print(f"S{s['id']} is not landed:\n" + "\n".join(f"  - {b}" for b in blockers))
        sys.exit(1)
    print(f"S{s['id']} is landed: pushed, nothing uncommitted, PR merged/closed or none, plan complete, no open questions")


def remove_scratch(path):
    """Delete a scratch folder unless it holds unique work. Returns a report line."""
    reasons = zedlib.scratch_unique_work(path)
    if reasons:
        return f"kept scratch {path}: " + "; ".join(reasons)
    shutil.rmtree(path)
    return f"removed scratch {path}"


def own_scratch(s):
    """The session's scratch folder if it is one Zed may delete: T<id>-<name> directly inside its project folder."""
    scratch = Path(s["scratch"]) if s["scratch"] else None
    if scratch and scratch.is_dir() and zedlib.SCRATCH_NAME.fullmatch(scratch.name) \
            and scratch.parent == Path(s["worktree"]):
        return scratch


def cmd_close(args):
    """close <S|agent> [keep-worktree] [keep-scratch] [force] — stop the worker, close its herdr workspace, then remove
    its scratch folder and its worktree unless they hold unique work (the landed-work test; see scratch_unique_work)."""
    if not args:
        die("close <S|agent> [keep-worktree] [keep-scratch] [force]")
    conn = db()
    require_lock()
    ref = session_ref(args[0])
    s = resolve_session(conn, ref)
    if s["external"]:
        # Not ours: never close the user's pane/workspace or touch their files.
        conn.execute("UPDATE sessions SET status='closed', updated_at=? WHERE id=?", (now(), s["id"]))
        log_event(conn, s["task_id"], "close", f"S{s['id']} external session untracked (left running)")
        conn.commit()
        write_status(conn)
        print(f"untracked S{s['id']} (external session left running)")
        return
    wt = Path(s["worktree"])
    in_place = project(s["repo"]).get("worktrees") is False
    if in_place:
        args = [*args, "keep-worktree"]  # the project folder itself; never remove it
    blockers = landed_blockers(conn, s, git_checks=not in_place and wt.exists())
    if blockers and "force" not in args:
        report = "\n".join(f"  - {b}" for b in blockers)
        if "keep-worktree" not in args:
            die(f"S{s['id']} is not landed, so its worktree stays:\n{report}\n"
                "Resolve these, or pass 'keep-worktree' (close the session only) / 'force'.")
        print(f"note: S{s['id']} is not landed yet (worktree kept):\n{report}")
    remove_wt = "keep-worktree" not in args and wt.exists()
    record_spend(conn, s)
    if s["workspace_id"]:
        close_workspace(s["workspace_id"])
    report = []
    if remove_wt:
        repo_path = expand(project(s["repo"])["path"])
        run(["git", "-C", str(repo_path), "worktree", "remove", *(["--force"] if "force" in args else []), str(wt)])
        report.append(f"removed worktree {wt}")
    elif not in_place and wt.exists():
        report.append(f"kept worktree {wt}")
    scratch = own_scratch(s)
    if scratch and "keep-scratch" not in args:
        report.append(remove_scratch(scratch))
    conn.execute("UPDATE sessions SET status='closed', updated_at=? WHERE id=?", (now(), s["id"]))
    log_event(conn, s["task_id"], "close", f"S{s['id']} {s['agent']} closed" + "".join(f"; {r}" for r in report))
    touch_task(conn, s["task_id"])
    conn.commit()
    write_status(conn)
    print(f"closed S{s['id']}")
    for r in report:
        print(f"  {r}")


def cmd_adopt(args):
    """adopt <pane-id> <task-id> [repo=] — track an agent session Zed didn't start. Never closed by Zed."""
    if len(args) < 2:
        die("adopt <pane-id> <task-id> [repo=<name>]")
    pane_id, tid = args[0], int(args[1].lstrip("T"))
    kv = parse_kv(args[2:])
    conn = db()
    require_lock()
    get_task(conn, tid)
    a = live_agents().get(pane_id)
    if not a:
        die(f"no live agent in pane {pane_id}")
    cwd = a.get("cwd") or ""
    branch = run(["git", "-C", cwd, "branch", "--show-current"], check=False).stdout.strip() or "-"
    ts = now()
    cur = conn.execute(
        "INSERT INTO sessions(task_id,repo,base,branch,worktree,agent,workspace_id,pane_id,claude_session_id,status,external,"
        "created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,1,?,?)",
        (tid, kv.get("repo", Path(cwd).name), "-", branch, cwd, a.get("name") or pane_id, a["workspace_id"], pane_id,
         (a.get("agent_session") or {}).get("value"), "running", ts, ts))
    log_event(conn, tid, "adopt", f"S{cur.lastrowid} adopted external session in {pane_id} ({cwd})")
    conn.execute("UPDATE tasks SET status='active' WHERE id=? AND status='intake'", (tid,))
    touch_task(conn, tid)
    conn.commit()
    write_status(conn)
    print(f"S{cur.lastrowid}")


def read_screen(agent, source="visible", lines=None):
    r = run(["herdr", "agent", "read", agent, "--source", source, *(["--lines", str(lines)] if lines else [])], check=False)
    return r.stdout if r.returncode == 0 else ""


def limit_line(screen, last=25):
    """The line near the bottom of the screen that looks like Claude Code's usage-limit message, if any."""
    for line in reversed(screen.strip().splitlines()[-last:]):
        if any(re.search(p, line, re.I) for p in LIMIT_PATTERNS):
            return line.strip(" │┃●")
    return None


# ---------------------------------------------------------------- worker reports

BLOCK_START = re.compile(r"^ZED:(QUESTION|DONE|BLOCKED)\s*$")
BLOCK_END = re.compile(r"^(```|[─━╭╰❯⏵✻✢✽]|.*\besc to\b)")  # closing fence or the CLI's prompt/footer chrome
BLOCK_MAX_LINES = 80           # a marker with more text than this after it is old output, not a final report
DONE_FIELDS = ("Summary", "Branch", "PR", "QA", "Follow-ups", "Learnings")
NO_QA = re.compile(r"^\W*(none|n/?a|not (run|done|tested)|skipped|no qa|-)?\W*$", re.I)
WORKING_SCAN = 10              # seconds between looks at a working worker's screen for a new ZED block
LAPSE_GRACE = 30               # seconds a worker must stay idle without a ZED block before it is nudged
LAPSE_NUDGE = "Continue, or end with ZED:QUESTION / ZED:DONE / ZED:BLOCKED."
YOUNG_SECONDS = 180            # a worker this new may be idle only because it has not started on its brief yet


def is_young(s):
    return (datetime.now() - datetime.strptime(s["created_at"], "%Y-%m-%d %H:%M")).total_seconds() < YOUNG_SECONDS


def parse_block(screen):
    """The worker's last ZED:QUESTION / ZED:DONE / ZED:BLOCKED block on its screen, or None:
    {"kind", "text", "fingerprint", "items" (QUESTION) | "fields" (DONE)}."""
    lines = [re.sub(r"^[\s⏺●│⎿]+", "", l).rstrip() for l in (screen or "").splitlines()]
    starts = [i for i, l in enumerate(lines) if BLOCK_START.match(l)]
    if not starts:
        return None
    i = starts[-1]
    body = []
    for l in lines[i + 1:]:
        if BLOCK_END.match(l):
            break
        body.append(l)
    while body and not body[-1]:
        body.pop()
    if len(body) > BLOCK_MAX_LINES:
        return None
    kind = BLOCK_START.match(lines[i]).group(1)
    block = {"kind": kind, "text": "\n".join(body), "items": [], "fields": {}}
    block["fingerprint"] = f"{kind}:{block['text'][:200]}"
    if kind == "DONE":
        field = None
        for l in body:
            m = re.match(rf"({'|'.join(DONE_FIELDS)}):\s*(.*)$", l)
            if m:
                field = m.group(1)
                block["fields"][field] = m.group(2)
            elif field and l:
                block["fields"][field] += "\n" + l
    else:
        for l in body:
            m = re.match(r"(\d+)[.)]\s+(.*)$", l)
            if m:
                block["items"].append(m.group(2))
            elif block["items"] and l:
                block["items"][-1] += "\n" + l
        if not block["items"] and block["text"]:
            block["items"] = [block["text"]]
    return block


STATUS_DIR = PROFILE_DIR / ".cache" / "status"
STATUS_LINE = re.compile(r"^(done|needs-decision|blocked):\s*(.*)$", re.I)


def new_status_lines(s, alerts):
    """Complete lines a worker has appended to its status file (profile/.cache/status/S<id>.log) since the last
    look. The file is the primary report channel: it works in any agent state and needs no screen parsing."""
    try:
        text = (STATUS_DIR / f"S{s['id']}.log").read_text(errors="replace")
    except FileNotFoundError:
        return []
    lines = text[:text.rfind("\n") + 1].splitlines()  # a half-written last line waits for its newline
    seen = alerts.setdefault(s["id"], {})
    new, seen["status_lines"] = lines[seen.get("status_lines", 0):], len(lines)
    return new


def status_blocks(lines):
    """Fold status-file lines into blocks shaped like parse_block's:
    `needs-decision: <question>` (one line each), `blocked: <what is needed>`,
    `done: <summary>; pr=<url|none>; qa=<what was verified>`."""
    questions, out = [], []
    for line in lines:
        m = STATUS_LINE.match(line.strip())
        if not m:
            continue
        kind, text = m.group(1).lower(), m.group(2).strip()
        if kind == "needs-decision":
            questions.append(text)
        elif kind == "blocked":
            out.append({"kind": "BLOCKED", "items": [text], "fields": {}, "text": text})
        else:
            summary = re.split(r";\s*(?:pr|qa)=", text, maxsplit=1)[0].strip()
            pr, qa = re.search(r";\s*pr=([^\s;]+)", text), re.search(r";\s*qa=(.*)$", text)
            out.append({"kind": "DONE", "items": [], "text": text,
                        "fields": {"Summary": summary, "PR": pr.group(1) if pr else "", "QA": qa.group(1).strip() if qa else ""}})
    if questions:
        out.insert(0, {"kind": "QUESTION", "items": questions, "fields": {}, "text": "\n".join(questions)})
    return out


def block_known(conn, s, block):
    """Whether the bookkeeping for this block was already done (e.g. from the status file)."""
    if block["kind"] == "DONE":
        summary = block["fields"].get("Summary", "").strip()
        return bool(conn.execute("SELECT 1 FROM events WHERE task_id=? AND kind='done' AND text=?",
                                 (s["task_id"], summary)).fetchone())
    prefix = "BLOCKED: " if block["kind"] == "BLOCKED" else ""
    return all(conn.execute("SELECT 1 FROM questions WHERE session_id=? AND question=?", (s["id"], prefix + t)).fetchone()
               for t in block["items"])


def record_block(conn, s, block):
    """Do the DB bookkeeping for a worker's report (what `check-workers` did by hand) and return the
    text to put in the watcher event."""
    sid, tid = s["id"], s["task_id"]
    if block["kind"] in ("QUESTION", "BLOCKED"):
        out = []
        for text in block["items"] or ["(empty block)"]:
            if block["kind"] == "BLOCKED":
                text = f"BLOCKED: {text}"
            known = conn.execute("SELECT id FROM questions WHERE session_id=? AND question=?", (sid, text)).fetchone()
            qid = known["id"] if known else add_question(conn, tid, sid, text)
            out.append(f"Q{qid}{' (already recorded)' if known else ''}: {text}")
        return f"ZED:{block['kind']}\n" + "\n".join(out)
    f = block["fields"]
    summary = f.get("Summary", "").strip()
    if not conn.execute("SELECT 1 FROM events WHERE task_id=? AND kind='done' AND text=?", (tid, summary)).fetchone():
        log_event(conn, tid, "done", summary or "(no summary)")
    conn.execute("UPDATE sessions SET status='finished', updated_at=? WHERE id=?", (now(), sid))
    out = [f"ZED:DONE · {summary}"]
    url = re.search(r"https?://\S+", f.get("PR", ""))
    qa = f.get("QA", "").strip()
    if url:
        url = url.group(0).rstrip(".,;)")
        conn.execute("UPDATE sessions SET pr_url=?, updated_at=? WHERE id=?", (url, now(), sid))
        out.append(f"PR: {url}")
        if NO_QA.match(qa):
            out.append("⚠ PR with no real QA in its QA: line — send it back to QA before accepting (manual, directive 6)")
        else:
            conn.execute("UPDATE tasks SET status='pr_open' WHERE id=? AND status IN ('active','waiting_user','in_review')", (tid,))
    out.append(f"QA: {qa or '(missing)'}")
    if problem := zedlib.session_plan_problem(s):
        out.append(f"DONE with an incomplete plan: {problem}; send it back to finish the plan before review or QA")
    for k in ("Follow-ups", "Learnings"):
        if f.get(k) and f[k].strip().lower() not in ("none", "-"):
            out.append(f"{k}: {f[k]}")
    touch_task(conn, tid)
    return "\n".join(out)


def settle_turn(conn, s, screen, alerts, line, seq):
    """A worker's turn ended (idle/done). Returns the event text for Zed, or None when the watcher
    dealt with it: a new ZED block is recorded and surfaced; a usage limit wakes Zed once; no block at all is a
    protocol lapse, nudged by `lapse_tick` after a grace period (so a just-spawned worker that is idle only until it
    reads its brief raises nothing)."""
    seen = alerts.setdefault(s["id"], {})
    block = parse_block(read_screen(s["agent"], "recent-unwrapped", 150) or screen)
    if block and seen.get("block") != block["fingerprint"]:
        seen["block"], seen["nudges"] = block["fingerprint"], 0
        seen.pop("lapse", None)
        if block_known(conn, s, block):  # already reported from the worker's status file
            return None
        return f"{line}\n{record_block(conn, s, block)}"
    hit = limit_line(screen)
    if hit:
        if seen.get("limit") == hit:
            return None
        seen["limit"] = hit
        return f"{line} · USAGE LIMIT: {hit} · the worker is paused until it resets; tell the user"
    seen["lapse"] = {"seq": seq, "since": time.time()}
    return None


def scan_working(conn, s, alerts):
    """A worker can print a ZED block and keep working (e.g. it waits on a background workflow), so the turn
    never ends and no idle/done event fires. Every WORKING_SCAN seconds look at the screen of working workers;
    a block that differs from the last one seen and is unchanged since the previous scan (so not half-printed)
    is recorded and returned as an event."""
    seen = alerts.setdefault(s["id"], {})
    if time.time() - seen.get("scan_at", 0) < WORKING_SCAN:
        return None
    seen["scan_at"] = time.time()
    block = parse_block(read_screen(s["agent"], "recent-unwrapped", 150))
    if not block or block["fingerprint"] == seen.get("block"):
        seen.pop("pending", None)
        return None
    if seen.get("pending") != block["fingerprint"]:
        seen["pending"] = block["fingerprint"]
        return None
    seen["block"], seen["nudges"] = block["fingerprint"], 0
    seen.pop("pending")
    seen.pop("lapse", None)
    if block_known(conn, s, block):
        return None
    return f"S{s['id']} T{s['task_id']} {s['agent']} · new ZED:{block['kind']} while still working\n{record_block(conn, s, block)}"


PR_POLL_SECONDS = 300  # how often the watcher looks at a session's open PR (gh: no model tokens)
OPEN_PRS = ("SELECT * FROM sessions WHERE pr_url IS NOT NULL AND status!='closed' AND external=0 "
            "AND COALESCE(pr_state,'open')='open'")


def pr_events(conn, s, alerts):
    """Zero-token PR polling: lines for a PR that was merged or closed, got new reviews or comments, or whose
    checks started failing. The first look only records the baseline."""
    seen = alerts.setdefault(s["id"], {})
    if time.time() - seen.get("pr_at", 0) < PR_POLL_SECONDS:
        return []
    seen["pr_at"] = time.time()
    snap = pr_snapshot(s["pr_url"])
    if snap is None:
        return []
    before, seen["pr"] = seen.get("pr"), snap
    tag = f"S{s['id']} T{s['task_id']} {s['agent']} · PR {s['pr_url']}"
    out = []
    if snap["state"] != "open":
        conn.execute("UPDATE sessions SET pr_state=? WHERE id=?", (snap["state"], s["id"]))
        out.append(f"{tag} was {snap['state']} (the task is the user's to mark done; `wrap-up` when ready)")
    else:
        conn.execute("UPDATE sessions SET pr_state='open' WHERE id=? AND pr_state IS NULL", (s["id"],))
        if before and snap["reviews"] > before["reviews"]:
            out.append(f"{tag} has {snap['reviews'] - before['reviews']} new review(s)/comment(s)")
        if snap["checks"] == "failing" and (before or {}).get("checks") != "failing":
            out.append(f"{tag} has failing checks")
    for line in out:
        log_event(conn, s["task_id"], "pr", line)
    return out


def lapse_tick(s, state, seq, alerts):
    """Protocol lapse: idle with no ZED block. The first one is nudged with the standard prompt without
    waking Zed; one after a nudge is returned as an event line. A young worker's lapse is kept, not dropped: it is
    nudged once the worker is no longer young, if it is still idle in the same turn."""
    seen = alerts.setdefault(s["id"], {})
    lapse = seen.get("lapse")
    if not lapse:
        return None
    if state not in ("idle", "done") or lapse["seq"] != seq:
        seen.pop("lapse")
        return None
    if is_young(s) or time.time() - lapse["since"] < LAPSE_GRACE:
        return None
    seen.pop("lapse")
    if not seen.get("nudges"):
        seen["nudges"] = 1
        run(["herdr", "agent", "prompt", s["agent"], LAPSE_NUDGE], check=False)
        return ("nudge", f"S{s['id']} idle with no ZED block; sent the standard nudge")
    seen["nudges"] += 1
    return ("wake", f"S{s['id']} T{s['task_id']} {s['agent']} · PROTOCOL LAPSE again: idle with no ZED block after a nudge "
                    "(read its screen; it may be waiting on something or lost)")


_watcher_lock = None  # held open for the life of this watcher; the kernel drops it when the process dies


MAX_SHOWS = 3  # an un-acked wake is re-presented by `watch` until it has been shown this many times


@contextlib.contextmanager
def wake_queue():
    """The durable wake queue ({"next": n, "events": [{"id", "ts", "text", "shown", "acked"}]}), under a file lock
    because the watcher appends while Zed acks. Changes are saved on exit."""
    WAKE_QUEUE_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(WAKE_QUEUE_PATH.with_suffix(".guard"), "w") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        q = read_json(WAKE_QUEUE_PATH, {"next": 1, "events": []})
        yield q
        WAKE_QUEUE_PATH.write_text(json.dumps(q))


def queue_add(lines):
    """Append actionable events to the queue; returns them as `[E<id>] text` lines."""
    out = []
    with wake_queue() as q:
        for text in lines:
            q["events"].append({"id": q["next"], "ts": now(), "text": text, "shown": 1, "acked": False})
            out.append(f"[E{q['next']}] {text}")
            q["next"] += 1
    return out


def queue_represent():
    """Un-acked events to show again (a handling turn that crashed or hit a limit never acked them). Each is
    re-presented at most MAX_SHOWS times in total so a forgotten ack can't wake Zed forever; `zed start` lists
    them regardless."""
    with wake_queue() as q:
        again = [e for e in q["events"] if not e["acked"] and e["shown"] < MAX_SHOWS]
        for e in again:
            e["shown"] += 1
        return [f"[E{e['id']}] (again, un-acked since {e['ts']}) {e['text']}" for e in again]


def queue_pending():
    with wake_queue() as q:
        return [e for e in q["events"] if not e["acked"]]


def cmd_ack(args):
    """ack <E-id>... | ack --all — retire handled wake events (shown again by `watch` and `start` until acked)."""
    if not args:
        die("ack <E-id>... | ack --all")
    require_profile()
    require_lock()
    wanted = {int(a.lstrip("Ee")) for a in args if a != "--all"}
    with wake_queue() as q:
        hit = [e for e in q["events"] if not e["acked"] and ("--all" in args or e["id"] in wanted)]
        for e in hit:
            e["acked"] = True
        left = sum(not e["acked"] for e in q["events"])
        missing = wanted - {e["id"] for e in q["events"]}
    if missing:
        die(f"no such wake event: {', '.join(f'E{i}' for i in sorted(missing))}")
    print(f"acked {len(hit)}; {left} still un-acked")


def watcher_alive():
    """pid of a live watcher for this profile (`watch` or the Stop hook's `hook arm`), or None. Decided by an
    flock the watcher holds, so a stale pid file or a reused pid can't fool it."""
    WATCHER_LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(WATCHER_LOCK_PATH, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return read_json(WATCHER_PID_PATH, {}).get("pid") or -1
    return None


def claim_watcher():
    """Become the one watcher; False if another one holds the claim."""
    global _watcher_lock
    if _watcher_lock and not _watcher_lock.closed:
        return True  # this process already is the watcher
    WATCHER_LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    f = open(WATCHER_LOCK_PATH, "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        f.close()
        return False
    _watcher_lock = f
    WATCHER_PID_PATH.write_text(json.dumps({"pid": os.getpid(), "started": now()}))
    atexit.register(lambda: WATCHER_PID_PATH.unlink(missing_ok=True))
    return True


def cmd_watch(args):
    """Emit one line whenever a managed worker changes to a state that needs Zed's attention. Run it under the
    Monitor tool, or as `watch --once`, which exits after the first event(s) and remembers what it has reported so
    a re-armed watch only reports new changes. Exits (3) when this session loses the Zed lock."""
    once = "--once" in args
    until_idle = "--exit-when-idle" in args  # the Stop hook's watcher gives up when no work is tracked any more
    idle_ticks, tracked = 0, True
    rest = [a for a in args if not a.startswith("--")]
    interval = float(rest[0]) if rest else 3.0
    db().close()
    require_lock()
    if not claim_watcher():
        print(f"WATCH_ALREADY_RUNNING pid {watcher_alive()}: one watcher is enough; it will wake Zed.", flush=True)
        sys.exit(4)
    again = queue_represent()
    for line in again:
        print(line, flush=True)
    if once and again:
        return True
    saved = read_json(WATCH_STATE_PATH, None)
    prev = {int(k): v for k, v in saved.items()} if saved is not None else {}
    first = saved is None
    alerts_path = WATCH_STATE_PATH.with_name("watch-alerts.json")
    alerts = {int(k) if k.isdigit() else k: v for k, v in read_json(alerts_path, {}).items()}  # health alerts already reported, kept across runs
    while True:
        if not holds_lock():
            h = read_lock()
            print("LOCK LOST: " + (f"another session took over as Zed ({describe(h)})" if h else "the Zed lock was released")
                  + ". Stop acting as Zed: no watcher, relaying or commits; read-only from now on.", flush=True)
            sys.exit(3)
        events = []
        try:
            conn = db()
            sessions = conn.execute("SELECT * FROM sessions WHERE status IN ('running','waiting_user')").fetchall()
            open_prs = conn.execute(OPEN_PRS).fetchall()
            tracked = bool(sessions or open_prs)
            live = live_agents()
            for s in sessions:
                a = live.get(s["pane_id"])
                state = a["agent_status"] if a else "gone"
                key = s["id"]
                for line in health_events(conn, s, a, state, alerts):
                    events.append(line)
                for block in status_blocks(new_status_lines(s, alerts)):
                    alerts[s["id"]]["nudges"] = 0
                    alerts[s["id"]].pop("lapse", None)
                    events.append(f"S{s['id']} T{s['task_id']} {s['agent']} · status file: ZED:{block['kind']}\n"
                                  + record_block(conn, s, block))
                snapshot = {"state": state, "sequence": a.get("state_change_seq") if a else None}
                if prev.get(key) != snapshot:
                    line = None
                    if not first and state in ("idle", "done", "blocked", "unknown", "gone"):
                        line = f"S{s['id']} T{s['task_id']} {s['agent']} → {state}"
                    elif first and state in ("idle", "done", "blocked", "gone"):
                        line = f"S{s['id']} T{s['task_id']} {s['agent']} is {state} (at watch start)"
                    if line and state != "gone":
                        screen = read_screen(s["agent"])
                        if state == "blocked":
                            prompt = prompt_summary(screen)
                            if zedgates.may_auto_approve(s) and auto_approve(conn, s, screen, alerts):
                                line = None  # handled by rule; logged, no need to wake Zed
                            else:
                                line += f" · prompt: {prompt}" if prompt else ""
                        elif state in ("idle", "done"):
                            line = settle_turn(conn, s, screen, alerts, line, snapshot["sequence"])
                        hit = line and state not in ("idle", "done") and limit_line(screen)
                        if hit:
                            line += f" · possible usage limit: {hit}"
                    if line:
                        events.append(line)
                    prev[key] = snapshot
                if state == "working" and (line := scan_working(conn, s, alerts)):
                    events.append(line)
                lapse = lapse_tick(s, state, snapshot["sequence"], alerts)
                if lapse:
                    kind, text = lapse
                    if kind == "nudge":
                        log_event(conn, s["task_id"], "auto", text)
                    else:
                        events.append(text)
            for s in open_prs:
                events.extend(pr_events(conn, s, alerts))
            events += zedconductor.tick(conn, alerts, zed_cli)
            first = False
            conn.commit()
            conn.close()
        except Exception as e:  # keep the watch alive through transient failures
            print(f"watch error: {e}", file=sys.stderr, flush=True)
        for line in queue_add(events):
            print(line, flush=True)
        WATCH_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        WATCH_STATE_PATH.write_text(json.dumps(prev))
        alerts_path.write_text(json.dumps(alerts))
        if once and events:
            return True
        idle_ticks = 0 if tracked else idle_ticks + 1
        if until_idle and idle_ticks >= 5:
            return False
        time.sleep(interval)


PROMPT_LINE = re.compile(r"(\?\s*$|^\s*(Read|Bash|Edit|Write|Fetch|Update|Agent|Skill)\(|Dangerous|^\s*❯?\s*\d\.\s)")


def prompt_summary(screen):
    """The pending permission prompt in a worker's screen, condensed to one line (what it wants, the options)."""
    lines = [l.strip(" │┃") .strip() for l in (screen or "").splitlines()[-30:]]
    keep = [l for l in lines if l and PROMPT_LINE.search(l) and "Tip:" not in l]
    return " | ".join(keep)[:600]


TOOLING_DIRS = {".git", "tools", "bin", "node_modules", ".venv", "venv", "__pycache__", ".ext"}


def output_files_since(worktree, since):
    """How many files in the worktree changed after `since` (epoch), ignoring tooling, so work products
    count as progress and re-tooling doesn't."""
    if not worktree or not Path(worktree).is_dir():
        return 0
    n = 0
    for root, dirs, files in os.walk(worktree):
        dirs[:] = [d for d in dirs if d not in TOOLING_DIRS]
        n += sum(1 for f in files if "BRIEF" not in f and os.path.getmtime(os.path.join(root, f)) > since)
    return n


AUTO_APPROVE_PATH = PROFILE_DIR / "config" / "auto-approve.json"


def auto_approve(conn, s, screen, alerts):
    """Answer a routine permission prompt by rule, without waking Zed. Rules live in the profile's
    config/auto-approve.json: [{"name", "prompt" (text that must appear), "path_prefixes" (the Read/Bash
    target must start with one), "option" (text of the one-time option that must be offered), "key"}].
    A prompt already answered once that is still showing is left for Zed."""
    rules = read_json(AUTO_APPROVE_PATH, [])
    tail = "\n".join((screen or "").splitlines()[-30:])
    seen = alerts.setdefault(s["id"], {})
    if seen.get("auto_last") == tail:
        return False
    for r in rules:
        if r["prompt"] not in tail or r["option"] not in tail:
            continue
        targets = re.findall(r"(?:Read|Bash)\((.*?)\)\s*$", tail, re.M)
        prefixes = [os.path.expanduser(x) for x in r.get("path_prefixes", [])]
        targets = [os.path.normpath(t) for t in targets]  # no `..` escapes out of an allowed prefix
        if not targets or not all(any(t.startswith(x) for x in prefixes) for t in targets):
            continue
        run(["herdr", "agent", "send-keys", s["agent"], r["key"]], check=False)
        seen["auto_last"] = tail
        log_event(conn, s["task_id"], "auto", f"S{s['id']}: answered '{r['name']}' with {r['key']} for {', '.join(targets)}")
        return True
    return False


def zed_cli(args):
    """Run one `bin/zed` command as the conductor does (the lock and every gate apply as for a person): (exit code, output)."""
    r = run([sys.executable, str(ZED_HOME / "bin" / "zed"), *args], check=False)
    return r.returncode, r.stdout + r.stderr


def health_events(conn, s, a, state, alerts):
    """Deterministic checks the watcher runs on every live session: no plan progress, token use, long blocks."""
    out, seen = [], alerts.setdefault(s["id"], {})
    tag = f"S{s['id']} T{s['task_id']} {s['agent']}"
    now = datetime.now()
    started = datetime.strptime(s["created_at"], "%Y-%m-%d %H:%M")
    if state == "working":
        plans = session_plan_files(s)
        last = max([started] + [datetime.fromtimestamp(p.stat().st_mtime) for p in plans])
        idle = int((now - last).total_seconds() // 60)
        what = "no plan file yet" if not plans else "no plan progress"
        producing = idle >= STALL_MINUTES and output_files_since(s["worktree"], time.time() - STALL_MINUTES * 60) > 0
        if idle >= STALL_MINUTES and not producing and seen.get("stall") != last.isoformat():
            seen["stall"] = last.isoformat()
            out.append(f"{tag} · STALL: {what} for {idle} min while working (check for re-tooling or repeated work)")
    if state == "blocked":
        since = datetime.fromisoformat(seen.setdefault("blocked_since", now.isoformat()))
        if (now - since).total_seconds() >= 300 and not seen.get("block_reminded"):
            seen["block_reminded"] = True
            out.append(f"{tag} · still blocked after 5 min (queued prompt? read the screen again)")
    else:
        seen.pop("blocked_since", None)
        seen.pop("block_reminded", None)
    note_session_id(conn, s, a)  # the transcript's id, kept so the spend ledger can find it after the session closes
    return out


ARM_MIN_SECONDS = 15  # an arm that wakes Zed sooner than this is lost: Claude is still finishing the Stop phase
GUARD_WAIT = 6  # seconds the turn-end guard waits for the Stop hook's watcher to come up


def hook_input():
    """The JSON Claude Code sends a hook on stdin ({} when there is none)."""
    try:
        return json.loads(sys.stdin.read() or "{}") if not sys.stdin.isatty() else {}
    except ValueError:
        return {}


def arm_ran_since(ts):
    try:
        return ARM_STAMP_PATH.stat().st_mtime >= ts
    except FileNotFoundError:
        return False


def has_tracked_work():
    conn = db()
    try:
        return bool(conn.execute("SELECT COUNT(*) FROM sessions WHERE status IN ('running','waiting_user')").fetchone()[0]
                    or conn.execute(OPEN_PRS).fetchone())
    finally:
        conn.close()


def cmd_hook(args):
    """hook arm | hook stop-guard — Claude Code `Stop` hooks (see .claude/settings.json). Both act only in the
    session that holds the profile lock and only while sessions are tracked, so read-only sessions are untouched.
      arm         (asyncRewake) runs the watcher inside the hook: re-arming takes no model turn. It exits 2, which
                  wakes Zed with the events on stderr, only when there are events (or the lock is lost). One watcher
                  at a time; it gives up quietly when no work is tracked any more.
      stop-guard  blocks ending a turn with tracked work and no live watcher, once per stop (stop_hook_active)."""
    mode = args[0] if args else ""
    if mode not in ("arm", "stop-guard"):
        die("hook arm | hook stop-guard")
    data = hook_input()
    try:
        if not holds_lock() or not has_tracked_work() or (mode == "stop-guard" and data.get("stop_hook_active")):
            return
        if mode == "stop-guard":
            started = time.time()
            while not (watcher_alive() or arm_ran_since(started - 2)):  # arm may already have woken Zed with an event
                if time.time() >= started + GUARD_WAIT:
                    break
                time.sleep(0.3)
            else:
                return
            print("zed: sessions are tracked but no watcher is running, so you'd miss a worker finishing or asking. "
                  "Arm one: run `bin/zed watch --once` in the background (Bash run_in_background), then end your turn.",
                  file=sys.stderr)
            sys.exit(2)
        ARM_STAMP_PATH.parent.mkdir(parents=True, exist_ok=True)
        ARM_STAMP_PATH.touch()
        if watcher_alive():
            return
        armed_at = time.time()
        try:
            with contextlib.redirect_stdout(sys.stderr):
                woke = cmd_watch(["--once", "--exit-when-idle"])
        except SystemExit as e:  # 3: lock lost (the message is already on stderr); 4: another watcher won the race
            woke = e.code == 3
        if woke:
            time.sleep(max(0, ARM_MIN_SECONDS - (time.time() - armed_at)))
            sys.exit(2)
    except SystemExit:
        raise
    except Exception as e:  # a broken hook must never wedge a turn: report it without blocking
        print(f"zed hook {mode}: {e}", file=sys.stderr)
        sys.exit(1)


CONTEXT_BUDGET_WORDS = 4000


def start_reading():
    """What every Zed session reads besides the manual: `start` names them (Claude Code), or they are loaded as
    instructions (OpenCode)."""
    return [PROFILE_DIR / "profile.md", PROFILE_DIR / "lessons.md", ZED_HOME / "playbook.md", ZED_HOME / "failure-modes.md"]


def context_words():
    """(words per always-loaded file, budget). The budget is `context_budget_words` in the profile's
    config/settings.json (default 4000); the files are what every Zed session reads at start."""
    files = {"AGENTS.md": ZED_HOME / "AGENTS.md", "playbook.md": ZED_HOME / "playbook.md",
             "failure-modes.md": ZED_HOME / "failure-modes.md", "profile.md": PROFILE_DIR / "profile.md",
             "lessons.md": PROFILE_DIR / "lessons.md"}
    budget = read_json(PROFILE_DIR / "config" / "settings.json", {}).get("context_budget_words", CONTEXT_BUDGET_WORDS)
    return {n: len(f.read_text().split()) for n, f in files.items() if f.exists()}, budget


def context_line():
    words, budget = context_words()
    total = sum(words.values())
    detail = ", ".join(f"{n} {w}" for n, w in sorted(words.items(), key=lambda kv: -kv[1]))
    if total > budget:
        return (f"context: OVER BUDGET, {total} words of {budget} always loaded ({detail}). Prune, or move content into a "
                "skill that loads when needed (`learn` skill); don't grow these files")
    return f"context: {total} of {budget} words always loaded ({detail})"


def cmd_doctor(args):
    """doctor [--quiet] — the always-loaded context budget (the pre-commit hook runs it). Exits 1 when over."""
    words, budget = context_words()
    over = sum(words.values()) > budget
    if over or "--quiet" not in args:
        print(context_line(), file=sys.stderr if over else sys.stdout)
    sys.exit(1 if over else 0)


def cmd_paths(args):
    """Print where Zed's files are, for skills and scripts."""
    print(json.dumps({"home": str(ZED_HOME), "profile": str(PROFILE_DIR),
                      "profile_exists": (PROFILE_DIR / "profile.md").exists(),
                      "db": str(DB_PATH), "status": str(STATUS_PATH), "projects": str(PROJECTS_PATH),
                      "briefs": str(PROFILE_DIR / "briefs"), "claude": str(CLAUDE_CONFIG_PATH)}, indent=2))


BRIEF_LINES = 12  # per section; the rest is "N more omitted"


def capped(lines, limit=BRIEF_LINES):
    return lines[:limit] + ([f"  … {len(lines) - limit} more omitted"] if len(lines) > limit else [])


def render_brief(conn, live=None):
    """Only what needs the user or Zed, in a bounded digest: open questions, sessions that need a look,
    PRs waiting on review, tasks not started."""
    live = live if live is not None else live_agents()
    out = []
    qs = [f"  Q{q['id']} T{q['task_id']} ({q['asked_at']}): {q['question'].splitlines()[0][:200]}"
          for q in conn.execute("SELECT * FROM questions WHERE status='open' ORDER BY id")]
    out += ["Waiting on the user:", *(capped(qs) or ["  nothing"])]
    sess = []
    for s in conn.execute("SELECT * FROM sessions WHERE status IN ('running','waiting_user') ORDER BY id"):
        a = live.get(s["pane_id"])
        state = a["agent_status"] if a else "GONE"
        plans = session_plan_files(s)
        done, todo = plan_progress(plans[0]) if plans else (0, 0)
        note = f" · {s['hat'] or 'build'} {done}/{done + todo}{awaiting_note(plans)}" if plans else ""
        sess.append(f"  S{s['id']} T{s['task_id']} {s['agent']} {s['status']}/{state}{note}")
    out += ["Sessions running:", *(capped(sess) or ["  none"])]
    other = [f"  T{t['id']} {t['status']} {t['ticket'] or '-'} {t['title']}" for t in conn.execute(
        "SELECT * FROM tasks WHERE status IN ('pr_open','intake','parked') ORDER BY id")]
    out += ["PR open / not started / parked:", *(capped(other) or ["  none"])]
    return out


def plan_progress(plan):
    """(done, todo) of a plan file; open merge/push/raise-PR steps are counted apart by plan_awaiting, not as todo."""
    steps = zedlib.parse_plan_steps(plan.read_text())
    return sum(s["done"] for s in steps), sum(not s["done"] and not zedlib.step_exempt(s) for s in steps)


def plan_awaiting(plans):
    """How many unticked merge/push/raise-PR steps these plan files hold: work that is done but waits for the PR."""
    return sum(not st["done"] and zedlib.step_exempt(st) for plan in plans for st in zedlib.parse_plan_steps(plan.read_text()))


def awaiting_note(plans):
    n = plan_awaiting(plans)
    return f" (+{n} awaiting merge/PR)" if n else ""


def cmd_status(args):
    conn = db()
    if "--brief" in args:
        print("\n".join(render_brief(conn)))
        return
    text = render_status(conn)
    if holds_lock():
        STATUS_PATH.write_text(text)
    print(text)


def script_findings(label, script, *args, limit=6):
    """Run a bin/zed-* check for `start`: exit 0 or a failure = nothing to show; exit 1 = its lines are the findings."""
    r = run([sys.executable, str(ZED_HOME / "bin" / script), *args], check=False)
    lines = [l for l in r.stdout.splitlines() if l.strip()]
    if r.returncode != 1 or not lines:
        return []
    return [f"{label}:", *(f"  {l[:200]}" for l in lines[:limit]), *([f"  … {len(lines) - limit} more (bin/{script})"] if len(lines) > limit else [])]


def arm_watcher():
    """Start one detached `watch --once` for this profile and return its pid once it holds the watcher lock (or None)."""
    with open(PROFILE_DIR / ".cache" / "watch.log", "w") as log:
        subprocess.Popen([str(ZED_HOME / "bin" / "zed"), "watch", "--once"], stdout=log, stderr=subprocess.STDOUT,
                         start_new_session=True)
    for _ in range(20):
        time.sleep(0.25)
        if pid := watcher_alive():
            return pid
    return None


def coordinator_permissions():
    """OpenCode permission rules that let the coordinator's routine commands run without a prompt: the Bash entries of
    the allow list Claude Code uses (.claude/settings.json), so both runtimes share one list, plus the canary, which
    must reach the guard instead of waiting for an answer nobody can give. Everything else keeps OpenCode's default."""
    allowed = read_json(ZED_HOME / ".claude" / "settings.json", {}).get("permissions", {}).get("allow", [])
    commands = [m.group(1) for a in allowed if (m := re.fullmatch(r"Bash\((.+):\*\)", a))]
    commands += [str(ZED_HOME / c) for c in commands if c.startswith("bin/")] + [PRETOOL_CANARY]
    return [{"action": "shell", "resource": f"{c} *", "effect": "allow"} for c in commands]


def coordinator_kit():
    """What the coordinator's OpenCode session starts with: a config directory of its own (OPENCODE_CONFIG_DIR) holding
    the model and variant from the profile's config/opencode.json, the permission rules, the files every Zed session
    reads (loaded as instructions next to this repo's AGENTS.md) and the guard plugin; a private server; and the path
    of the record `start` checks. Under the profile's .cache, or in a temporary folder while there is no profile yet
    (onboarding copies the template to `profile/`, which must not exist before)."""
    has_profile = (PROFILE_DIR / "profile.md").exists()
    home = PROFILE_DIR / ".cache" if has_profile else Path(tempfile.mkdtemp(prefix="zed-coordinator-"))
    config_dir = zeddeny.coordinator_plugin(home / "coordinator-opencode", ZED_HOME, {"ZED_PROFILE_DIR": str(PROFILE_DIR)})
    opencode = opencode_config()
    (config_dir / "opencode.json").write_text(json.dumps({
        "$schema": "https://opencode.ai/config.json",
        "model": opencode["model"],
        "agents": {"build": {"model": f"{opencode['model']}#{opencode['variant']}"}},  # the root model keeps no variant
        "permissions": coordinator_permissions(),
        "instructions": [str(p) for p in start_reading()]}, indent=2) + "\n")
    return {"config_dir": config_dir, "record": home / "coordinator.json", "model": opencode["model"],
            "variant": opencode["variant"], "server": private_server(config_dir / "server.log")}


def open_coordinator(kit):
    """Start the coordinator's server and session and prove its guard: the server with the kit's config directory, a
    session in Zed's home with the configured model and variant, then the canary, which bin/zed-pretool must deny.
    Returns (the server process, the session id or None, "" or why this session must not act as Zed). The record is
    written only for a session whose guard is proven."""
    server = kit["server"]
    env = os.environ | {"OPENCODE_CONFIG_DIR": str(kit["config_dir"]), "OPENCODE_PASSWORD": server["password"],
                        COORDINATOR_ENV: str(kit["record"])}
    with open(server["log"], "w") as log:  # the log names a plugin that failed to load
        process = subprocess.Popen(["opencode", "serve", "--print-logs", "--log-level", "warn", "--hostname", "127.0.0.1",
                                    "--port", server["url"].rsplit(":", 1)[1]], env=env, cwd=ZED_HOME, stdout=log, stderr=subprocess.STDOUT)
    session = None
    try:
        session, problem = opencode_session(server, ZED_HOME, "zed", kit["model"], kit["variant"])
        problem = problem or opencode_canary(server, session, PRETOOL_CANARY, "coordinator guard (bin/zed-pretool)")
    except (OSError, ValueError, KeyError, TypeError) as e:
        problem = f"its OpenCode server at {server['url']} failed ({type(e).__name__}: {e}); its log: {server['log']}"
    if not problem:
        kit["record"].touch(mode=0o600)  # it holds the server's password: the watcher wakes the coordinator through it
        kit["record"].write_text(json.dumps({
            "runtime": "opencode", "session": session, "server": {"url": server["url"], "password": server["password"]},
            "server_pid": process.pid, "model": kit["model"], "variant": kit["variant"], "guard": "live", "started_at": now()}, indent=2) + "\n")
    return process, session, problem


def coordinator_record():
    """What `coordinator` recorded for the OpenCode session running this command: None unless that session's guard was
    proven and its server is still up."""
    path = os.environ.get(COORDINATOR_ENV)
    record = read_json(Path(path), None) if path else None
    if not record or record.get("guard") != "live" or record.get("session") != os.environ.get("OPENCODE_SESSION_ID"):
        return None
    try:
        os.kill(record["server_pid"], 0)
    except (OSError, KeyError, TypeError):
        return None
    return record


def cmd_coordinator(args):
    """coordinator — open Zed's own session on OpenCode (the Claude Code equivalent is `claude` in Zed's home): writes
    the session's config, starts its server, proves the guard with a canary and opens the TUI on the session. A
    session whose guard is not proven is not opened. The server stops when the TUI is closed."""
    if os.environ.get("ZED_SESSION"):
        die(f"this is worker session {os.environ['ZED_SESSION']}, not Zed: `coordinator` is for the user's own terminal.")
    if install_runtime() != "opencode":
        die(f"this install runs on Claude Code: start `claude` in {ZED_HOME}. (To run on OpenCode instead, set "
            f"\"runtime\": \"opencode\" in {PROFILE_DIR / 'config' / 'settings.json'}.)")
    if not shutil.which("opencode"):
        die("`opencode` is not installed or not on PATH")
    kit = coordinator_kit()
    for sig in (signal.SIGHUP, signal.SIGTERM):  # a closed terminal must not leave the server behind
        signal.signal(sig, lambda number, frame: sys.exit(128 + number))
    print(f"starting the coordinator on {kit['model']} ({kit['variant']}) and proving its guard: one model turn …", flush=True)
    process, session, problem = open_coordinator(kit)
    try:
        if problem:
            die(f"the coordinator was not opened: {problem}")
        tui = os.environ | {"OPENCODE_CONFIG_DIR": str(kit["config_dir"]), "OPENCODE_PASSWORD": kit["server"]["password"]}
        code = subprocess.call(["opencode", "--server", kit["server"]["url"], "--session", session], env=tui, cwd=ZED_HOME)
    finally:
        process.terminate()
        try:
            process.wait(10)
        except subprocess.TimeoutExpired:
            process.kill()
        kit["record"].unlink(missing_ok=True)
    sys.exit(code)


def cmd_runtime(args):
    """runtime [--set-installed] — print the runtime this install uses. --set-installed (bin/zed-setup) writes it to
    the profile's config/settings.json when it is not set there and exactly one of Claude Code and OpenCode is
    installed; with both installed the choice is the user's."""
    path = PROFILE_DIR / "config" / "settings.json"
    if "--set-installed" in args and (PROFILE_DIR / "profile.md").exists() and not zedlib.settings().get("runtime"):
        installed = [r for r, program in (("claude", "claude"), ("opencode", "opencode")) if shutil.which(program)]
        if len(installed) == 1:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(zedlib.settings() | {"runtime": installed[0]}, indent=2) + "\n")
            print(f"runtime set to {installed[0]} in {path} (the only one installed)")
            return
        if installed:
            print(f"Claude Code and OpenCode are both installed and an install uses one: set \"runtime\" in {path} "
                  f"(now: {install_runtime()})")
            return
    print(install_runtime())


def cmd_start(args):
    """start [--take-over] — session start in one command: claim the Zed lock, then print one bounded
    digest (lock, watcher, what needs the user, running sessions). Read it once and trust it."""
    if os.environ.get("ZED_SESSION"):  # set by spawn for every worker (hat_kit)
        die(f"this is worker session {os.environ['ZED_SESSION']}, not Zed: `start` is for the coordinator only. "
            "Follow your worker rules and brief; the coordinator manual (AGENTS.md) does not apply to you.")
    runtime = install_runtime()
    record = coordinator_record() if runtime == "opencode" else None
    if runtime == "opencode" and not record:
        die("this OpenCode session was not opened by `bin/zed coordinator`, so its guard (bin/zed-pretool) is not proven "
            "live and Zed does not act from it. Tell the user to quit and run `bin/zed coordinator`.")
    if record and me()["agent_session"] != record["session"]:  # the guard knows the lock holder by this id
        die(f"this session is {record['session']} to OpenCode but {me()['agent_session']} to herdr: the guard would not "
            "recognise the lock holder, so Zed does not act from it.")
    if not (PROFILE_DIR / "profile.md").exists():
        print(f"NEW USER: there is no profile at {PROFILE_DIR}. Run the `onboarding` skill and do nothing else until it is done."
              + (" Then tell the user to quit and run `bin/zed coordinator` again." if record else ""))
        return
    notes = []
    if zedlib.git(ZED_HOME, "branch", "--show-current").stdout.strip() == "main":
        notes.append("ON `main`: it holds core only. Zed runs on the profile's branch; switch before any commit.")
    try:
        cmd_lock(["acquire", *(["--take-over"] if "--take-over" in args else [])])
    except SystemExit as e:
        notes.append("NOT THE ACTIVE ZED: the lock is held by another live session. Read-only: no watcher, "
                     "no prompting workers, no commits. Ask the user: stay read-only or `bin/zed start --take-over`.")
        if e.code not in (1, 2):
            raise
    conn = db()
    lock = read_lock()
    out = [f"Zed home {ZED_HOME} · profile {PROFILE_DIR}",
           f"runtime: {runtime}" + (f" · session {record['session']} · guard proven live at {record['started_at']}" if record else ""),
           f"lock: {'held by this session' if holds_lock() else describe(lock) if lock else 'none'}"]
    watcher = watcher_alive()
    running = conn.execute("SELECT COUNT(*) FROM sessions WHERE status IN ('running','waiting_user')").fetchone()[0]
    if not watcher and running and holds_lock() and os.environ.get("OPENCODE_SESSION_ID"):
        watcher = arm_watcher()  # OpenCode has no blocking Stop hook to re-arm it after each turn: arm it here
    out.append(f"watcher: {'alive, pid ' + str(watcher) if watcher else 'NOT RUNNING' + (' — arm it: bin/zed watch --once (background)' if running else '')}")
    out.append(context_line())
    reading = ", ".join(str(p) for p in start_reading() if p.exists())
    out.append(f"already in your instructions: {reading}" if record else f"read now: {reading}")
    out += notes + render_brief(conn)
    if holds_lock():  # read-only sessions only report what the DB says
        out += script_findings("sessions out of step with the DB (zed-crew)", "zed-crew", "reconcile")
        out += script_findings("core commits not on main yet (zed-core-sync)", "zed-core-sync", "--check")
        out += script_findings("git guard (zed-guard)", "zed-guard", "audit")
    pending = [f"  [E{e['id']}] {e['ts']} {e['text'].splitlines()[0][:160]}" for e in queue_pending()]
    if pending:
        out += ["Un-acked wake events (handle, then `bin/zed ack E<id>…`):", *capped(pending)]
    conn.close()
    print("\n".join(out))


def cmd_help(args):
    print(__doc__)
    print("""Commands
  task add title=... [ticket=] [worktype=] [description=] [status=]
  task set <T> key=value...          (title ticket worktype description status)
  task show <T> | task list [--all]
  log <T|-> <text...> [kind=note]
  q add <T|-> <question...> [session=S] | q answer <Q> <answer...> | q list
  brief <T> repo= base= branch= [force]
                                     scaffold the brief from the task, projects.json, repo notes and plan
                                     block; leaves <FILL: …> for the model, which spawn refuses
  spawn <T> repo= base= branch= brief=<file> [name=<agent>] [from=<start-ref, default origin/<base>>]
        [model=] [effort=] [kind=]   model/effort default to claude.json; kind (default: the task's worktype)
                                     picks the effort by claude.json effort_by_kind; beyond max_running the task is queued (exit 75)
        [hat=build|review|qa]        the hat the session wears (default build);
                                     refused for a second writer on a worktree or a review/qa before the build's plan is done
        [runtime=claude|opencode]    the install's runtime by default (`runtime`); opencode takes model and variant
                                     from config/opencode.json (model= overrides), no effort=, no max_running
  session list | session set <S|agent> key=value... (status pr_url claude_session_id pane_id workspace_id base brief)
  close <S|agent> [keep-worktree] [keep-scratch] [force]
                                     (external sessions are only untracked; the landed-work test below
                                     must pass before the worktree is removed; the session's scratch
                                     folder is removed too unless it holds unique work)
  landed <S|agent>                   landed-work test: pushed, nothing uncommitted, PR merged/closed, plan
                                     complete, no open questions; prints exactly what blocks closing
  prompt <S|agent> [--redirect] <text | --file F>
                                     the way to prompt a worker: refused while it is `working` unless --redirect
  relay <Q> "<answer>" [<Q> "<answer>" …] [--redirect]
                                     the user's answers in one step: prompt each worker verbatim, record the answers,
                                     note them in the session's brief
  relay-post <S|agent> <words-file> --action "<exact action>" [--redirect] [--print]
                                     relay the user's OK to post: their words verbatim + the exact action
  gate check <sha|branch> [dir]      exit 1 unless the commit's code (profile/ ignored) has a clean review and qa by non-authors (read-only)
  merge <branch> [dir] [--override "<reason>"]
                                     `git merge --no-ff` only past the gate; --override is the user's call, logged
  adopt <pane-id> <T> [repo=]        track a session Zed didn't start (user's own)
  hook arm | hook stop-guard         Claude Stop hooks (.claude/settings.json): tokenless watcher re-arm and a
                                     turn-end guard; act only in the session holding the lock
  ack <E-id>... | ack --all          retire handled watcher events; un-acked ones are shown again by `watch`
                                     (up to 3 times) and always by `start`
  watch [interval-seconds] [--once]  run under Monitor, or `watch --once` as a background shell; exits after the first event(s)
  doctor [--quiet]                   check the always-loaded context budget (4000 words; context_budget_words in
                                     config/settings.json); exits 1 when over. The pre-commit hook runs it
  status [--brief]                   (regenerate + print STATUS.md; --brief: only what needs attention)
  start [--take-over]                (session start: claim the lock, print one bounded digest; under OpenCode only
                                     in a session opened by `coordinator`)
  coordinator                        OpenCode only: open Zed's own session with its config, guard plugin and a canary
                                     that proves the guard (Claude Code: start `claude` in Zed's home)
  runtime [--set-installed]          the runtime this install uses (`runtime` in config/settings.json)
  paths                              (Zed home, profile dir, DB/STATUS/config/briefs locations)
  lock status | lock acquire [--take-over] | lock release
                                     one active Zed per profile; without the lock only
                                     status, list, show, paths and lock work
Task states:    """ + ", ".join(TASK_STATES) + """
Session states: """ + ", ".join(SESSION_STATES))


COMMANDS = {"task": cmd_task, "log": cmd_log, "q": cmd_q, "spawn": cmd_spawn, "session": cmd_session,
            "prompt": cmd_prompt, "relay": cmd_relay, "relay-post": cmd_relay_post, "gate": cmd_gate, "merge": cmd_merge, "close": cmd_close, "adopt": cmd_adopt, "watch": cmd_watch, "status": cmd_status,
            "brief": cmd_brief, "landed": cmd_landed, "doctor": cmd_doctor, "ack": cmd_ack, "hook": cmd_hook, "paths": cmd_paths, "start": cmd_start, "coordinator": cmd_coordinator, "runtime": cmd_runtime, "lock": cmd_lock, "help": cmd_help}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        cmd_help([])
        sys.exit(0 if len(sys.argv) < 2 else 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])
