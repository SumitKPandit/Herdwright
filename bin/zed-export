#!/usr/bin/env python3
"""zed-export — versioned JSON export of Zed's task DB, as a backup or for moving to another machine.

Ported from firstmate's fm-record-export (fixed, versioned export of private records). Read-only on the DB. Every table
in the DB is exported (so tables added later are included), with the schema version, time and row counts.
The export holds the user's tasks, questions and events: keep it in the profile or somewhere private; this script
never sends it anywhere.

Usage
  zed-export export [FILE]     write the export to FILE (default: stdout); prints a one-line summary to stderr
  zed-export verify FILE       check an export is well-formed and prints its row counts; exit 0 ok, 1 not
"""
import argparse
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedlib  # noqa: E402

FORMAT = "zed-export"
VERSION = 1


def export(conn):
    names = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name")]
    tables = {n: [dict(r) for r in conn.execute(f'SELECT * FROM "{n}" ORDER BY 1')] for n in names}
    return {"format": FORMAT, "version": VERSION, "exported_at": time.strftime("%Y-%m-%d %H:%M:%S"),
            "counts": {n: len(rows) for n, rows in tables.items()}, "tables": tables}


def verify(data):
    problems = []
    if not isinstance(data, dict) or data.get("format") != FORMAT:
        return [f"not a {FORMAT} file"]
    if data.get("version") != VERSION:
        problems.append(f"unsupported version {data.get('version')!r} (this script reads {VERSION})")
    tables = data.get("tables")
    if not isinstance(tables, dict):
        return problems + ["no tables"]
    for n, rows in tables.items():
        if not isinstance(rows, list):
            problems.append(f"table {n}: rows is not a list")
        elif data.get("counts", {}).get(n) != len(rows):
            problems.append(f"table {n}: count {data.get('counts', {}).get(n)} != {len(rows)} rows")
    for needed in ("tasks", "sessions", "questions", "events"):
        if needed not in tables:
            problems.append(f"missing table {needed}")
    return problems


def main(argv=None):
    ap = argparse.ArgumentParser(prog="zed-export", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    e = sub.add_parser("export")
    e.add_argument("file", nargs="?")
    sub.add_parser("verify").add_argument("file")
    a = ap.parse_args(argv)
    if a.cmd == "export":
        conn = zedlib.db_readonly()
        if conn is None:
            print(f"zed-export: no DB at {zedlib.DB_PATH}", file=sys.stderr)
            return 2
        data = export(conn)
        text = json.dumps(data, indent=2, sort_keys=True)
        if a.file:
            Path(a.file).write_text(text + "\n")
        else:
            print(text)
        print("exported " + ", ".join(f"{n} {c}" for n, c in data["counts"].items()), file=sys.stderr)
        return 0
    try:
        data = json.loads(Path(a.file).read_text())
    except (OSError, ValueError) as err:
        print(f"zed-export: cannot read {a.file}: {err}", file=sys.stderr)
        return 1
    problems = verify(data)
    for p in problems:
        print(f"problem: {p}")
    if not problems:
        print("ok: " + ", ".join(f"{n} {c}" for n, c in data["counts"].items()))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
