#!/usr/bin/env python3
"""bb — minimal Bitbucket Cloud helper for Zed workers.

Auth: an Atlassian API token with Bitbucket scopes (read:user, read:repository, read:pullrequest,
write:pullrequest), stored in the macOS Keychain, never in a repo. Copy the token, then:
  security add-generic-password -U -s <service> -a <atlassian-email> -w "$(pbpaste)"
<service> is `bitbucket.keychain_service` in <profile>/config/settings.json (default zed-bitbucket).
Check it with:  bin/bb check

Usage
  bb whoami
  bb users <workspace/slug>... [--pages N]   (people seen on recent PRs, with UUIDs)
  bb check [workspace/slug]            (diagnose auth: HTTP status per endpoint, no secrets shown;
                                        repo defaults to bitbucket.check_repo in settings.json)
  bb pr create --title T --source BRANCH --dest BRANCH [--body-file F] [--draft] [--reviewer UUID ...]
  bb pr view <id> [--repo workspace/slug]
  bb pr list [--state OPEN] [--repo ...]
  bb pr ready <id>                     (clear draft)
Repo defaults to the `origin` remote of the current directory.
"""
import argparse
import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

API = "https://api.bitbucket.org/2.0"
ZED_HOME = Path(__file__).resolve().parent.parent
PROFILE_DIR = Path(os.environ.get("ZED_PROFILE_DIR") or ZED_HOME / "profile").expanduser().resolve()


def settings():
    path = PROFILE_DIR / "config" / "settings.json"
    return json.loads(path.read_text()).get("bitbucket", {}) if path.exists() else {}


SERVICE = settings().get("keychain_service", "zed-bitbucket")


def die(msg):
    print(f"bb: {msg}", file=sys.stderr)
    sys.exit(1)


def credentials():
    r = subprocess.run(["security", "find-generic-password", "-s", SERVICE], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"no Keychain item '{SERVICE}'. Store one with:\n"
            f"  security add-generic-password -U -s {SERVICE} -a <atlassian-email> -w \"$(pbpaste)\"")
    m = re.search(r'"acct"<blob>="([^"]*)"', r.stdout)
    token = subprocess.run(["security", "find-generic-password", "-s", SERVICE, "-w"],
                           capture_output=True, text=True).stdout.strip()
    if not m or not token:
        die("Keychain item is missing the account (email) or the token")
    return m.group(1), token


def call(method, path, body=None):
    email, token = credentials()
    req = urllib.request.Request(API + path, method=method,
                                 data=json.dumps(body).encode() if body is not None else None)
    req.add_header("Authorization", "Basic " + base64.b64encode(f"{email}:{token}".encode()).decode())
    req.add_header("Accept", "application/json")
    if body is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        die(f"{method} {path} → HTTP {e.code}\n{e.read().decode(errors='replace')}")


def probe(path, scheme):
    """Return the HTTP status for GET path using Basic (email:token) or Bearer auth."""
    email, token = credentials()
    req = urllib.request.Request(API + path)
    req.add_header("Authorization", "Basic " + base64.b64encode(f"{email}:{token}".encode()).decode()
                   if scheme == "basic" else f"Bearer {token}")
    try:
        with urllib.request.urlopen(req) as resp:
            return resp.status
    except urllib.error.HTTPError as e:
        return e.code


def check(repo):
    email, token = credentials()
    print(f"account: {email}; token length {len(token)}; "
          f"whitespace in token: {token != token.strip() or ' ' in token}")
    paths = ["/user"]
    if repo:
        paths += [f"/repositories/{repo}", f"/repositories/{repo}/pullrequests?pagelen=1"]
    for path in paths:
        print(f"{path}: basic={probe(path, 'basic')} bearer={probe(path, 'bearer')}")


def users(repos, pages):
    """List people seen as PR authors/reviewers/participants: display name, nickname, uuid."""
    seen = {}
    for repo in repos:
        url = f"/repositories/{repo}/pullrequests?state=MERGED&state=OPEN&state=DECLINED&pagelen=50"
        for _ in range(pages):
            r = call("GET", url)
            for pr in r.get("values", []):
                full = call("GET", f"/repositories/{repo}/pullrequests/{pr['id']}")
                for u in [full.get("author")] + full.get("reviewers", []) + [p["user"] for p in full.get("participants", [])]:
                    if u and u.get("uuid"):
                        seen[u["uuid"]] = (u.get("display_name"), u.get("nickname"))
            nxt = r.get("next")
            if not nxt:
                break
            url = nxt.replace(API, "")
    for uuid, (name, nick) in sorted(seen.items(), key=lambda kv: kv[1][0] or ""):
        print(f"{name}\t{nick}\t{uuid}")


def repo_from_origin():
    url = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    m = re.search(r"bitbucket\.org[:/]([^/]+)/([^/.]+?)(?:\.git)?$", url)
    if not m:
        die(f"origin is not a Bitbucket repo: {url!r}; pass --repo workspace/slug")
    return f"{m.group(1)}/{m.group(2)}"


def user_uuid(nick):
    """Bitbucket reviewers must be account UUIDs; names are not resolvable without admin scopes."""
    if nick.startswith("{"):
        return nick
    die(f"pass reviewers as Bitbucket account UUIDs ({{...}}); '{nick}' is not one. "
        "Ask Zed for the reviewer UUIDs (the profile's knowledge/people.md).")


def main():
    ap = argparse.ArgumentParser(prog="bb")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("whoami")
    ck = sub.add_parser("check")
    ck.add_argument("repo", nargs="?", help="workspace/slug to probe (default: bitbucket.check_repo)")
    us = sub.add_parser("users")
    us.add_argument("repos", nargs="+", help="workspace/slug ...")
    us.add_argument("--pages", type=int, default=1)
    pr = sub.add_parser("pr").add_subparsers(dest="pr_cmd", required=True)
    c = pr.add_parser("create")
    c.add_argument("--title", required=True)
    c.add_argument("--source", required=True)
    c.add_argument("--dest", required=True)
    c.add_argument("--body-file")
    c.add_argument("--draft", action="store_true")
    c.add_argument("--reviewer", action="append", default=[])
    c.add_argument("--repo")
    for name in ("view", "ready"):
        p = pr.add_parser(name)
        p.add_argument("id")
        p.add_argument("--repo")
    l = pr.add_parser("list")
    l.add_argument("--state", default="OPEN")
    l.add_argument("--repo")
    a = ap.parse_args()

    if a.cmd == "whoami":
        u = call("GET", "/user")
        print(f"{u.get('display_name')} ({u.get('nickname')}) {u.get('uuid')}")
        return
    if a.cmd == "users":
        users(a.repos, a.pages)
        return
    if a.cmd == "check":
        check(a.repo or settings().get("check_repo"))
        return
    repo = a.repo or repo_from_origin()
    if a.pr_cmd == "create":
        body = {"title": a.title,
                "source": {"branch": {"name": a.source}},
                "destination": {"branch": {"name": a.dest}},
                "description": open(a.body_file).read() if a.body_file else "",
                "draft": a.draft,
                "reviewers": [{"uuid": user_uuid(r)} for r in a.reviewer]}
        r = call("POST", f"/repositories/{repo}/pullrequests", body)
        print(r["links"]["html"]["href"])
    elif a.pr_cmd == "view":
        r = call("GET", f"/repositories/{repo}/pullrequests/{a.id}")
        print(json.dumps({k: r.get(k) for k in ("id", "title", "state", "draft")}
                         | {"url": r["links"]["html"]["href"],
                            "source": r["source"]["branch"]["name"],
                            "dest": r["destination"]["branch"]["name"]}, indent=2))
    elif a.pr_cmd == "ready":
        r = call("PUT", f"/repositories/{repo}/pullrequests/{a.id}", {"draft": False})
        print(f"ready: {r['links']['html']['href']}")
    elif a.pr_cmd == "list":
        r = call("GET", f"/repositories/{repo}/pullrequests?state={a.state}&pagelen=20")
        for p in r.get("values", []):
            print(f"#{p['id']} {p['source']['branch']['name']} → {p['destination']['branch']['name']}  {p['title']}")


if __name__ == "__main__":
    main()
