#!/usr/bin/env python3
"""zed-hygiene — housekeeping facts about project clones, worktrees and herdr panes, no model.

Ported from firstmate's fm-fleet-sync / fm-herdr-session-cleanup / fm-bootstrap (detect + refresh half).
Report-only by default. `--apply` does only the safe mechanical part: `git fetch --prune`, `git worktree prune`,
a fast-forward of a clone's checked-out dev base when the clone is clean and strictly behind, and removal of orphan
scratch folders that hold no unique work. It never deletes a branch or worktree that holds work, and never
touches a herdr pane.

Usage
  zed-hygiene report [--fetch] [--apply] [--json]
      per project in profile config/projects.json:
        orphan-worktree    a worktree under worktree_root that no live session owns (with dirty/unpushed counts)
        prunable-worktree  git lists a worktree whose folder is gone
        merged-branch      local branch already merged into origin/<dev_base> (safe to delete, by the user or Zed)
        gone-branch        local branch whose upstream was deleted on the remote
        scratch-leftover   a T<id>-<agent> scratch folder in a non-git project that no live session owns
                           (--apply deletes it unless a nested git repo in it has unique work)
        behind             clone's checked-out dev base is N commits behind origin
      and herdr panes still open for sessions the DB has closed. --fetch refreshes origin first (network, read-only).
      exit 0 nothing to do, 1 findings
"""
import argparse
import shutil
import sqlite3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedlib  # noqa: E402


def parse_worktrees(porcelain):
    out, cur = [], {}
    for ln in porcelain.splitlines() + [""]:
        if not ln.strip():
            if cur:
                out.append(cur)
            cur = {}
        elif ln.startswith("worktree "):
            cur["path"] = ln[9:]
        elif ln.startswith("branch "):
            cur["branch"] = ln[7:].removeprefix("refs/heads/")
        elif ln.startswith("prunable"):
            cur["prunable"] = True
    return out


def gone_branches(for_each_ref_output):
    return [ln.split()[0] for ln in for_each_ref_output.splitlines() if "[gone]" in ln]


def worktree_risk(path):
    g = lambda *a: zedlib.git(path, *a)
    dirty = len([ln for ln in g("status", "--porcelain").stdout.splitlines() if ln.strip()])
    unpushed = g("rev-list", "--count", "HEAD", "--not", "--remotes").stdout.strip()
    return dirty, int(unpushed) if unpushed.isdigit() else 0


def project_findings(name, p, root, owned, fetch, apply):
    clone = zedlib.expand(p["path"])
    if p.get("worktrees") is False or not (clone / ".git").exists():
        return [], []
    findings, actions = [], []
    if fetch or apply:
        r = zedlib.git(clone, "fetch", "--prune", "--quiet", timeout=120)
        actions.append(f"{name}: fetch --prune " + ("ok" if r.ok else f"FAILED ({r.stderr.strip()[:80]})"))
    base = p.get("dev_base")
    base_ref = f"origin/{base}" if base and zedlib.git(clone, "rev-parse", "--verify", "--quiet", f"origin/{base}").ok else None
    for wt in parse_worktrees(zedlib.git(clone, "worktree", "list", "--porcelain").stdout):
        path = Path(wt["path"])
        if wt.get("prunable"):
            findings.append(f"{name}: prunable-worktree {path}")
            continue
        if root in path.parents and str(path) not in owned:
            dirty, unpushed = worktree_risk(path)
            findings.append(f"{name}: orphan-worktree {path} ({wt.get('branch', 'detached')}; {dirty} uncommitted, {unpushed} unpushed)")
    if apply and any("prunable-worktree" in f for f in findings):
        zedlib.git(clone, "worktree", "prune")
        actions.append(f"{name}: worktree prune")
    checked_out = {w.get("branch") for w in parse_worktrees(zedlib.git(clone, "worktree", "list", "--porcelain").stdout)}
    protected = {base, "main", "master", "deploy"} | set(p.get("branches") or {})
    if base_ref:
        merged = zedlib.git(clone, "branch", "--merged", base_ref, "--format=%(refname:short)").stdout.split()
        for b in merged:
            if b not in protected and b not in checked_out:
                findings.append(f"{name}: merged-branch {b} (merged into {base_ref})")
    for b in gone_branches(zedlib.git(clone, "for-each-ref", "--format=%(refname:short) %(upstream:track)", "refs/heads").stdout):
        if b not in protected and b not in checked_out:
            findings.append(f"{name}: gone-branch {b} (upstream deleted)")
    head = zedlib.git(clone, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if base_ref and head == base:
        behind = zedlib.git(clone, "rev-list", "--count", f"{base}..{base_ref}").stdout.strip()
        ahead = zedlib.git(clone, "rev-list", "--count", f"{base_ref}..{base}").stdout.strip()
        clean = not zedlib.git(clone, "status", "--porcelain").stdout.strip()
        if behind.isdigit() and int(behind) > 0:
            findings.append(f"{name}: behind {base} by {behind} commit(s)" + ("" if clean and ahead == "0" else " (not fast-forwardable now: dirty or has local commits)"))
            if apply and clean and ahead == "0":
                r = zedlib.git(clone, "merge", "--ff-only", base_ref)
                actions.append(f"{name}: fast-forward {base} " + ("ok" if r.ok else f"FAILED ({r.stderr.strip()[:80]})"))
    return findings, actions


def scratch_findings(conn, apply):
    """Scratch folders (T<id>-<agent>) in non-git projects that no live session owns; --apply removes the ones with no unique work."""
    try:
        live = {Path(r["scratch"]) for r in conn.execute("SELECT scratch FROM sessions WHERE status!='closed' AND scratch IS NOT NULL")} if conn else set()
    except sqlite3.OperationalError:  # DB from before the scratch column existed
        live = set()
    findings, actions = [], []
    for name, p in zedlib.projects().items():
        if p.get("worktrees") is not False or not p.get("path"):
            continue
        for d in zedlib.scratch_dirs(zedlib.expand(p["path"])):
            if d in live:
                continue
            unique = zedlib.scratch_unique_work(d)
            findings.append(f"{name}: scratch-leftover {d}" + (f" (kept: {'; '.join(unique)})" if unique else ""))
            if apply and not unique:
                shutil.rmtree(d)
                actions.append(f"{name}: removed scratch {d}")
    return findings, actions


def pane_findings(conn, live):
    if conn is None:
        return []
    rows = conn.execute("SELECT id, agent, pane_id FROM sessions WHERE status='closed' AND external=0 AND pane_id IS NOT NULL").fetchall()
    return [f"S{r['id']} {r['agent']}: stale-pane {r['pane_id']} is still open for a closed session (close it in herdr)" for r in rows if r["pane_id"] in live]


def main(argv=None):
    ap = argparse.ArgumentParser(prog="zed-hygiene", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("report")
    r.add_argument("--fetch", action="store_true")
    r.add_argument("--apply", action="store_true")
    r.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    cfg = zedlib.read_json(zedlib.PROJECTS_PATH, {}) or {}
    root = zedlib.expand(cfg.get("worktree_root", "")).resolve()
    conn = zedlib.db_readonly()
    owned = {str(Path(s["worktree"]).resolve()) for s in conn.execute("SELECT worktree FROM sessions WHERE status!='closed'")} if conn else set()
    findings, actions = [], []
    for name, p in zedlib.projects().items():
        if p.get("path"):
            f, act = project_findings(name, p, root, owned, a.fetch, a.apply)
            findings += f
            actions += act
    f, act = scratch_findings(conn, a.apply)
    findings += f
    actions += act
    findings += pane_findings(conn, zedlib.live_agents())
    data = {"findings": findings, "actions": actions}
    zedlib.emit(data, a.json, lambda d: zedlib.cap_lines(d["actions"] + d["findings"], 50, 260) or ["clean: nothing to do"])
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())
