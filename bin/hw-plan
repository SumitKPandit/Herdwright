#!/usr/bin/env python3
"""hw-plan — check a worker's plan file and report its progress, no model.

The plan file (profile/briefs/T<id>-<repo>-plan.md) is a checklist of steps, each with a "done when" and a
rough time (worker rules: "Work to a plan"). Ported from the heading-reader and definition-of-done checks in
firstmate's fm-brief-heading-lib / fm-dod-lib. Read-only.
firstmate: Copyright (c) 2026 Kun Chen, MIT licence, see THIRD_PARTY_LICENSES.md.

Usage
  hw-plan lint <plan-file|T<id>> [--json]
      structure problems: no steps, a step without a 'done when', a step without a time estimate (~40 min, ~2 h),
      duplicate or out-of-order numbers, a catch-all tick that covers several steps ('1-5 done'). exit 0 clean, 1 problems, 2 no such plan
  hw-plan progress <plan-file|T<id>> [--json]
      steps done/total (open merge/push/raise-PR steps are counted apart as 'awaiting'), the next step, estimated minutes remaining, and whether the current step has run past
      twice its estimate since the plan was last updated (the rule that says stop and tell Herdwright). exit 0 on track, 1 overrun
  hw-plan split <design.md> [--out DIR] [--json]
      turn a design assignment's plan into one brief skeleton per build unit. A unit is a heading
      `### Unit <id>: <title>` (any level 2-4; id like A, 3 or 1.2) followed by `- Label: value` lines:
        Scope, Files (comma separated), Done when, Estimate (like ~2 h), Depends on (unit ids, or none)
      Checks the units (all fields present, dependencies exist, no cycle) and warns when two units that can run at
      the same time touch the same file. Prints the units by wave (wave 0 can start now); with --out writes
      <id>-<slug>.md skeletons there, shaped like templates/brief.md with `<FILL: ...>` for what Herdwright adds.
      exit 0 ok (warnings allowed) · 1 problems, nothing written · 2 no such file
"""
import argparse
import re
import sqlite3
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import hwlib  # noqa: E402

DONE_WHEN = re.compile(r"done when", re.I)
ESTIMATE = re.compile(r"~\s*(\d+(?:\.\d+)?)\s*(min|m|h|hr|hrs|hour|hours)\b", re.I)


def find_plan(ref):
    if re.fullmatch(r"T\d+", ref):
        conn = hwlib.db_readonly()
        try:  # the task's build plan: that of its latest build or fix session
            if conn and (plan := hwlib.gate_plan(conn, int(ref[1:]))):
                return plan
        except sqlite3.Error:  # a DB from before sessions.plan
            pass
        found = sorted(f for f in hwlib.BRIEFS_DIR.glob(f"{ref}-*-plan.md") if not hwlib.READER_PLAN.fullmatch(f.name))
        return found[0] if found else None
    p = Path(ref)
    return p if p.exists() else None


def estimate_minutes(text):
    m = ESTIMATE.search(text)
    if not m:
        return None
    n = float(m.group(1))
    return int(n * 60) if m.group(2).lower().startswith("h") else int(n)


def parse(text):
    steps = hwlib.parse_plan_steps(text)
    # a step's own text continues on indented lines until the next checklist item or a heading
    for st, nxt in zip(steps, steps[1:] + [None]):
        start = text.index(st["line"])
        end = text.index(nxt["line"], start + 1) if nxt else len(text)
        st["full"] = re.split(r"\n#{1,6} |\n\n\S", text[start:end])[0]
        st["est_min"] = estimate_minutes(st["full"])
    return steps


def lint(steps):
    problems = []
    if not steps:
        return ["no checklist steps found ('- [ ] 1. ...')"]
    seen = set()
    first = steps[0]["n"]  # plans may start at 0 or 1
    for i, st in enumerate(steps, first):
        if st["n"] in seen:
            problems.append(f"step {st['n']}: duplicate number")
        seen.add(st["n"])
        if st["n"] != i:
            problems.append(f"step {st['n']}: out of order (expected {i})")
        if not DONE_WHEN.search(st["full"]):
            problems.append(f"step {st['n']}: no 'Done when'")
        if hwlib.step_catch_all(st):
            problems.append(f"step {st['n']}: a catch-all tick ('1-5 done'): one checklist line per step, each with its own 'Done when'")
        if st["est_min"] is None:
            problems.append(f"step {st['n']}: no time estimate (like '~40 min')")
    return problems


def progress(steps, plan_mtime, now=None):
    now = now or time.time()
    todo = [s for s in steps if not s["done"] and not hwlib.step_exempt(s)]
    awaiting = sum(not s["done"] and hwlib.step_exempt(s) for s in steps)
    cur = todo[0] if todo else None
    age = int((now - plan_mtime) // 60)
    out = {"done": sum(s["done"] for s in steps), "total": len(steps) - awaiting, "awaiting": awaiting, "next": cur["text"][:120] if cur else None,
           "remaining_est_min": sum(s["est_min"] or 0 for s in todo), "minutes_since_update": age, "overrun": False}
    if cur and cur["est_min"] and age > 2 * cur["est_min"]:
        out["overrun"] = f"step {cur['n']} estimated {cur['est_min']} min, {age} min since the plan last changed"
    return out


UNIT_HEAD = re.compile(r"^#{2,4}\s+Unit\s+([\w.]+)\s*[:.\u2014-]\s*(.+?)\s*$", re.I | re.M)
UNIT_FIELD = re.compile(r"^\s*[-*]\s+(Scope|Files|Done when|Estimate|Depends on)\s*:\s*(.*)$", re.I)
UNIT_REQUIRED = ("scope", "done when", "estimate", "depends on")


def parse_units(text):
    """[{'id', 'title', 'scope', 'files': [...], 'done_when', 'estimate', 'est_min', 'deps': [...]}] in document order."""
    heads = list(UNIT_HEAD.finditer(text))
    units = []
    for h, nxt in zip(heads, heads[1:] + [None]):
        body = text[h.end():nxt.start() if nxt else len(text)]
        body = re.split(r"\n#{1,4} (?!Unit\b)", body)[0]  # the next non-unit heading ends the unit
        fields, last = {}, None
        for line in body.splitlines():
            m = UNIT_FIELD.match(line)
            if m:
                last = m.group(1).lower()
                fields[last] = m.group(2).strip()
            elif last and line.strip() and line.startswith((" ", "\t")):
                fields[last] += " " + line.strip()  # indented continuation of the previous field
        deps = [d.strip() for d in re.split(r"[,;]", fields.get("depends on", "")) if d.strip()]
        units.append({"id": h.group(1), "title": h.group(2), "scope": fields.get("scope"), "done_when": fields.get("done when"),
                      "files": [f.strip().strip("`") for f in fields.get("files", "").split(",") if f.strip()],
                      "estimate": fields.get("estimate"), "est_min": estimate_minutes(fields.get("estimate") or ""),
                      "deps": [] if [d.lower() for d in deps] == ["none"] else deps, "_fields": fields})
    return units


def check_units(units):
    """(problems, warnings, waves): waves[unit id] = longest dependency chain below it (0 = can start now)."""
    problems, warnings, ids = [], [], [u["id"] for u in units]
    if not units:
        return ["no units found ('### Unit A: title' followed by '- Scope: ...' lines)"], [], {}
    for dup in sorted({i for i in ids if ids.count(i) > 1}):
        problems.append(f"unit {dup}: duplicate id")
    for u in units:
        for field in UNIT_REQUIRED:
            if not u["_fields"].get(field):
                problems.append(f"unit {u['id']}: no '{field.capitalize()}'")
        if u["_fields"].get("estimate") and u["est_min"] is None:
            problems.append(f"unit {u['id']}: estimate needs a form like '~2 h' or '~40 min'")
        for d in u["deps"]:
            if d not in ids:
                problems.append(f"unit {u['id']}: depends on unknown unit '{d}'")
    if problems:
        return problems, warnings, {}
    deps, waves = {u["id"]: u["deps"] for u in units}, {}

    def wave(uid, trail=()):
        if uid in trail:
            raise ValueError(" -> ".join((*trail[trail.index(uid):], uid)))
        if uid not in waves:
            waves[uid] = 1 + max((wave(d, (*trail, uid)) for d in deps[uid]), default=-1)
        return waves[uid]

    try:
        for uid in deps:
            wave(uid)
    except ValueError as e:
        return [f"dependency cycle: {e}"], warnings, {}

    def ancestors(uid):
        seen, todo = set(), list(deps[uid])
        while todo:
            d = todo.pop()
            if d not in seen:
                seen.add(d)
                todo += deps[d]
        return seen
    for i, a in enumerate(units):
        for b in units[i + 1:]:
            shared = sorted(set(a["files"]) & set(b["files"]))
            if shared and a["id"] not in ancestors(b["id"]) and b["id"] not in ancestors(a["id"]):
                warnings.append(f"units {a['id']} and {b['id']} can run at the same time but both touch {', '.join(shared)}")
    return problems, warnings, waves


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "unit"


def skeleton(unit, design_name):
    deps = ", ".join(f"unit {d}" for d in unit["deps"]) or "none (can start now)"
    return f"""# Brief — unit {unit['id']} · {unit['title']}

Skeleton from {design_name}. Herdwright: `bin/hw task add`, then `bin/hw brief` or paste this into the task's brief and fill the rest.

## Goal
{unit['scope']}

## Context
- Repo: <FILL: repo>   Base / PR target: <FILL: branch>
- Files this unit touches: {', '.join(unit['files']) or 'not listed'}
- Depends on: {deps}
- Related repos / sessions: <FILL: or "none">

## Decisions already made by the user
- <FILL: each confirmed decision, verbatim, or "none yet">

## Known open points (do not assume; ask if they matter)
- <FILL: what is still unknown, or "none known">

## QA
- <FILL: how, and the environment / login>

## Plan
- Before any other work, write the plan file Herdwright names: a checklist (`- [ ] step: done when ...`) with a rough time per step.
- Estimate for this unit: {unit['estimate']}

## Definition of done
- {unit['done_when']}
- QA done, self-review done, committed and PR raised per the user's rules.
- Finish with an HW:DONE block.
"""


def cmd_split(a):
    path = Path(a.design)
    if not path.is_file():
        print(f"hw-plan: no such file: {a.design}", file=sys.stderr)
        return 2
    units = parse_units(path.read_text())
    problems, warnings, waves = check_units(units)
    written = []
    if not problems and a.out:
        out = Path(a.out)
        out.mkdir(parents=True, exist_ok=True)
        for u in units:
            f = out / f"{u['id']}-{slug(u['title'])}.md"
            f.write_text(skeleton(u, path.name))
            written.append(str(f))
    public = [{k: v for k, v in u.items() if k != "_fields"} | {"wave": waves.get(u["id"])} for u in units]
    data = {"units": public, "problems": problems, "warnings": warnings, "written": written}

    def render(d):
        if d["problems"]:
            return [f"{path.name}: {len(d['problems'])} problem(s)"] + ["  - " + p for p in d["problems"]]
        lines = [f"{path.name}: {len(d['units'])} unit(s)"]
        for u in sorted(d["units"], key=lambda u: u["wave"]):
            lines.append(f"  wave {u['wave']}  {u['id']}: {u['title']} (~{u['est_min']} min)"
                         + (f"  after {', '.join(u['deps'])}" if u["deps"] else ""))
        return lines + ["  ! " + w for w in d["warnings"]] + [f"  wrote {w}" for w in d["written"]]
    hwlib.emit(data, a.json, render)
    return 1 if problems else 0


def load(ref):
    p = find_plan(ref)
    if not p:
        print(f"hw-plan: no plan file for {ref}", file=sys.stderr)
        return None, None
    return p, parse(p.read_text())


def main(argv=None):
    ap = argparse.ArgumentParser(prog="hw-plan", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for n in ("lint", "progress"):
        p = sub.add_parser(n)
        p.add_argument("plan")
        p.add_argument("--json", action="store_true")
    split = sub.add_parser("split")
    split.add_argument("design")
    split.add_argument("--out")
    split.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    if a.cmd == "split":
        return cmd_split(a)
    path, steps = load(a.plan)
    if path is None:
        return 2
    if a.cmd == "lint":
        problems = lint(steps)
        hwlib.emit({"plan": str(path), "problems": problems}, a.json,
                    lambda d: [f"{path.name}: " + ("ok" if not problems else f"{len(problems)} problem(s)")] + ["  - " + p for p in hwlib.cap_lines(problems, 20)])
        return 1 if problems else 0
    pr = progress(steps, path.stat().st_mtime)
    hwlib.emit(pr, a.json, lambda d: [f"{path.name}: {d['done']}/{d['total']} done{f" (+{d['awaiting']} awaiting merge/PR)" if d["awaiting"] else ""}, ~{d['remaining_est_min']} min estimated left"
                                       + (f"; next: {d['next']}" if d["next"] else "; complete")]
                + ([f"  ! OVERRUN: {d['overrun']}"] if d["overrun"] else []))
    return 1 if pr["overrun"] else 0


if __name__ == "__main__":
    sys.exit(main())
