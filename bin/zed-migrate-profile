#!/usr/bin/env python3
"""zed-migrate-profile — one-off: move a pre-split Zed checkout's personal files into profile/.

Before the core/profile split, the user's data lived at the repo root (knowledge/, config/,
db/, STATUS.md, briefs/) and some of their facts were written into core files. This moves the
files into profile/ (with `git mv` where tracked, so history follows), fixes the paths inside
them, writes the facts that were removed from core files into the profile, and regenerates
STATUS.md from the existing task DB. Idempotent: rerunning only does what's still left.

Run it on the profile branch (never on main), with no `bin/zed watch` running against the
checkout. Nothing is committed; review with `git status` and commit yourself.

Usage: bin/zed-migrate-profile [checkout-dir]   (default: this script's checkout)

This script carries the pre-split user's facts (LEGACY_* below), so it is personal: delete it
from main once the migration is done.
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# Files moved as-is (source relative to the checkout → destination under profile/).
FILE_MOVES = {
    "knowledge/user.md": "profile.md",
    "knowledge/lessons.md": "lessons.md",
    "knowledge/conventions.md": "rules.md",
    "STATUS.md": "STATUS.md",
}
# Directories whose files move under profile/<dest>, keeping their relative paths.
DIR_MOVES = {"knowledge": "knowledge", "config": "config", "db": "db", "briefs": "briefs"}
# Legacy files replaced by a regenerated version instead of moved.
DROPPED = ["knowledge/README.md"]

# Path fixes inside moved files: (file under profile/, old text, new text). Each is applied only
# while the old text is present, so reruns are no-ops.
TEXT_FIXES = [
    ("rules.md", "Check `repos/<repo>.md` for how to run", "Check `{{PROFILE}}/knowledge/repos/<repo>.md` for how to run"),
    ("rules.md", "the reviewers listed in `people.md`", "the reviewers listed in `{{PROFILE}}/knowledge/people.md`"),
    ("rules.md", "`<ZED_HOME>/bin/bb pr create", "`{{ZED_HOME}}/bin/bb pr create"),
    ("rules.md", "(`bin/bb --help`)", "(`{{ZED_HOME}}/bin/bb --help`)"),
    ("profile.md", "(see `mention.md`)", "(see `knowledge/mention.md`)"),
    ("knowledge/mention.md", "Conventions (branches, commits, PRs, QA): see `conventions.md`.",
     "Conventions (branches, commits, PRs, QA): see `../rules.md`."),
]

MARKER = "<!-- added by zed-migrate-profile: facts that lived in core files before the split -->"

# Facts about the pre-split user that were removed from core files (CLAUDE.md, README.md,
# bin/bb, the new-task skill, the T2 brief). Appended once, below MARKER.
LEGACY_PROFILE_APPEND = f"""
{MARKER}

## Accounts and tools
- GitHub: `skpstg` via `gh`.
- Bitbucket Cloud, workspace `criticalmedianyc` (cm_api, cm_db, cm_lib): Atlassian API token with
  scopes read:user, read:repository, read:pullrequest, write:pullrequest, stored in macOS Keychain
  item `zed-bitbucket` with the user's Atlassian email as account. Verify: `bin/bb check`.
- Jira (project `MENT`) and Confluence via the claude.ai Atlassian MCP server.

## Zed housekeeping
- Profile branch: `profile/sumit`.
- Before the split: "commit after meaningful changes and push to `origin`
  (git@github.com:skpstg/zed.git)". Where `profile/sumit` is pushed is to be confirmed by the user.
- Commit message format in the Zed repo: `ZED | Description in imperative mood`
  (T2 brief, 2026-10-26; earlier commits used `Zed: <what>`).
- Worker worktrees live under `~/codebase/mention/.worktrees/<repo>/` (`worktree_root` in
  `config/projects.json`).
"""
LEGACY_LESSONS_APPEND = f"""
{MARKER}
- **Intake specifics.** Ticket IDs are Jira `MENT-…`. The base branch for `cm-fe` / `cm-api` is a
  release branch that changes: check recent PRs (`gh pr list -R AirPR/cm-fe --state all -L 10`;
  cm-api is on Bitbucket) and confirm with the user.
"""
LEGACY_SETTINGS = {"bitbucket": {"keychain_service": "zed-bitbucket", "check_repo": "criticalmedianyc/cm_api"}}

KNOWN_DESCRIPTIONS = {
    "mention.md": ("Product/architecture: apps, repos, branches, how repos relate", "Zed (for briefs)"),
    "people.md": ("Team members, reviewers, account handles", "Zed + workers raising PRs"),
}


def die(msg):
    print(f"zed-migrate-profile: {msg}", file=sys.stderr)
    sys.exit(1)


def git(root, *args, check=True):
    r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)} failed:\n{r.stdout}{r.stderr}")
    return r


def tracked(root, rel):
    return git(root, "ls-files", "--error-unmatch", rel, check=False).returncode == 0


def move(root, rel, dest_rel):
    src, dest = root / rel, root / dest_rel
    if not src.exists():
        return
    if dest.exists():
        if src.read_bytes() == dest.read_bytes():
            if tracked(root, rel):
                git(root, "rm", "-q", "--cached", rel)
            src.unlink()
            print(f"removed duplicate {rel}")
            return
        die(f"both {rel} and {dest_rel} exist and differ; resolve by hand, then rerun")
    dest.parent.mkdir(parents=True, exist_ok=True)
    if tracked(root, rel):
        git(root, "mv", rel, dest_rel)
    else:
        shutil.move(src, dest)
    print(f"moved {rel} → {dest_rel}")


def remove_empty_dirs(path):
    if not path.is_dir():
        return
    for child in path.iterdir():
        if child.is_dir():
            remove_empty_dirs(child)
    if not any(path.iterdir()):
        path.rmdir()


def append_once(path, text):
    if not path.exists():
        die(f"{path} is missing; cannot append the legacy facts")
    content = path.read_text()
    if MARKER not in content:
        path.write_text(content.rstrip("\n") + "\n" + text)
        print(f"appended legacy facts to {path.name}")


def write_index(profile):
    path = profile / "knowledge" / "README.md"
    if path.exists():
        return
    rows = [("../profile.md", "Who the user is, accounts, preferences, Zed housekeeping", "Zed"),
            ("../rules.md", "The user's rules for workers (appended to every worker's system prompt)", "Zed + every worker"),
            ("../lessons.md", "How this user wants Zed to operate", "Zed")]
    for f in sorted((profile / "knowledge").glob("*.md")):
        if f.name != "README.md":
            what, who = KNOWN_DESCRIPTIONS.get(f.name, ("(describe)", "Zed"))
            rows.append((f.name, what, who))
    rows += [("repos/<repo>.md", "Practical how-to per repo: setup, running, test logins, QA paths, gotchas", "Workers on that repo"),
             ("../config/projects.json", "Machine-readable repo list: paths, hosts, base branches", "`bin/zed`"),
             ("../config/settings.json", "Tool settings (Bitbucket Keychain item, test repo)", "`bin/bb`")]
    lines = ["# Knowledge index", "",
             "Zed reads this index at session start and opens files when relevant. How to add to it:",
             "the `learn` skill.", "", "| File | What goes in it | Who reads it |", "|---|---|---|"]
    lines += [f"| `{f}` | {what} | {who} |" for f, what, who in rows]
    path.write_text("\n".join(lines) + "\n")
    print("wrote knowledge/README.md (index)")


def main():
    root = Path(sys.argv[1] if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent).resolve()
    if not (root / "bin" / "zed").exists():
        die(f"{root} is not a Zed checkout")
    branch = git(root, "branch", "--show-current").stdout.strip()
    if branch == "main":
        die("refusing to run on main (main is core only); switch to the profile branch first")
    profile = root / "profile"

    for rel, dest in FILE_MOVES.items():
        move(root, rel, f"profile/{dest}")
    for rel in DROPPED:
        if (root / rel).exists():
            if tracked(root, rel):
                git(root, "rm", "-q", "-f", rel)
            else:
                (root / rel).unlink()
            print(f"removed {rel} (regenerated as profile/knowledge/README.md)")
    for rel, dest in DIR_MOVES.items():
        src = root / rel
        if src.is_dir():
            for f in sorted(p for p in src.rglob("*") if p.is_file()):
                if f.name.endswith(("-journal", "-wal", "-shm")) or f.name == ".DS_Store":
                    continue
                move(root, str(f.relative_to(root)), f"profile/{dest}/{f.relative_to(src)}")
            remove_empty_dirs(src)
    if not (profile / "profile.md").exists():
        die("profile/profile.md is missing after the moves; is this a pre-split checkout?")

    for rel, old, new in TEXT_FIXES:
        path = profile / rel
        if path.exists() and old in path.read_text():
            path.write_text(path.read_text().replace(old, new))
            print(f"fixed a path in {rel}")
    append_once(profile / "profile.md", LEGACY_PROFILE_APPEND)
    append_once(profile / "lessons.md", LEGACY_LESSONS_APPEND)
    settings = profile / "config" / "settings.json"
    if not settings.exists():
        settings.parent.mkdir(parents=True, exist_ok=True)
        settings.write_text(json.dumps(LEGACY_SETTINGS, indent=2) + "\n")
        print("wrote config/settings.json")
    write_index(profile)
    (profile / "briefs").mkdir(exist_ok=True)
    if not any((profile / "briefs").iterdir()):
        (profile / "briefs" / ".gitkeep").touch()

    env = dict(os.environ, ZED_PROFILE_DIR=str(profile))
    r = subprocess.run([str(root / "bin" / "zed"), "status"], env=env, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"bin/zed status failed after migration:\n{r.stderr}")
    print("regenerated profile/STATUS.md from profile/db/zed.db")
    print("\nDone. Review `git status`, then commit on this branch (profile-only paths and the removed legacy paths).")


if __name__ == "__main__":
    main()
