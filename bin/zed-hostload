#!/usr/bin/env python3
"""zed-hostload — is this Mac healthy enough to start another worker? Memory, swap and agent RSS, no model.

An RSS and swap thrashing guard plus host-headroom check for macOS (memory_pressure, vm_stat, sysctl, ps).
Read-only and fail-open: if a reading is
unavailable the status is UNKNOWN and the exit code is 0, never a false alarm. The recommendation is text for the
user, never a command. Counting workers is `max_running` in runtimes.json; this guards memory.

Usage
  zed-hostload check [--json] [--warn-free-pct 20] [--crit-free-pct 8] [--warn-swap-gb 4] [--crit-swap-gb 8]
      status OK | WARNING | CRITICAL | UNKNOWN. exit 0 OK/UNKNOWN, 1 WARNING (spawn with care), 2 CRITICAL (do not spawn)
"""
import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedlib  # noqa: E402

AGENT_COMMS = ("claude", "copilot", "herdr", "node")


def parse_vm_stat(text, total_bytes):
    """Free percentage estimate from vm_stat: (free + inactive + speculative + purgeable) pages / all pages."""
    m = re.search(r"page size of (\d+) bytes", text)
    if not m or not total_bytes:
        return None
    page = int(m.group(1))
    pages = {k: int(v) for k, v in re.findall(r"^Pages ([a-z ]+?):\s+(\d+)\.", text, re.M)}
    avail = sum(pages.get(k, 0) for k in ("free", "inactive", "speculative", "purgeable"))
    return round(100 * avail * page / total_bytes)


def parse_memory_pressure(text):
    m = re.search(r"free percentage:\s*(\d+)%", text)
    return int(m.group(1)) if m else None


def parse_swapusage(text):
    m = re.search(r"used = ([\d.]+)([MG])", text)
    if not m:
        return None
    return float(m.group(1)) / (1024 if m.group(2) == "M" else 1)


def parse_ps(text):
    """[(pid, rss_kb, comm_basename)] from `ps -axo pid=,rss=,comm=`."""
    out = []
    for ln in text.splitlines():
        parts = ln.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            out.append((int(parts[0]), int(parts[1]), parts[2].rsplit("/", 1)[-1]))
    return out


def summarize_processes(procs):
    agents = [p for p in procs if p[2] in AGENT_COMMS]
    by = {}
    for _, rss, comm in agents:
        by[comm] = by.get(comm, 0) + rss
    top = sorted(procs, key=lambda p: -p[1])[:5]
    return {"agent_rss_gb": round(sum(r for _, r, _ in agents) / 1048576, 2),
            "agents": {k: round(v / 1048576, 2) for k, v in sorted(by.items())},
            "top": [f"{c} {r / 1048576:.1f} GB" for _, r, c in top]}


def assess(free_pct, swap_gb, t):
    reasons = []
    status = "OK"
    if free_pct is None and swap_gb is None:
        return "UNKNOWN", ["no memory readings available"]
    if free_pct is not None:
        if free_pct < t.crit_free_pct:
            status, _ = "CRITICAL", reasons.append(f"free memory {free_pct}% < {t.crit_free_pct}%")
        elif free_pct < t.warn_free_pct:
            status, _ = "WARNING", reasons.append(f"free memory {free_pct}% < {t.warn_free_pct}%")
    if swap_gb is not None:
        if swap_gb >= t.crit_swap_gb:
            status, _ = "CRITICAL", reasons.append(f"swap used {swap_gb:.1f} GB >= {t.crit_swap_gb} GB")
        elif swap_gb >= t.warn_swap_gb and status != "CRITICAL":
            status, _ = "WARNING", reasons.append(f"swap used {swap_gb:.1f} GB >= {t.warn_swap_gb} GB")
    return status, reasons


def read_host():
    def sh(*cmd):
        r = zedlib.run_bounded(list(cmd), timeout=10)
        return r.stdout if r.ok else ""
    total = sh("sysctl", "-n", "hw.memsize").strip()
    free = parse_memory_pressure(sh("memory_pressure", "-Q"))
    if free is None:
        free = parse_vm_stat(sh("vm_stat"), int(total) if total.isdigit() else 0)
    return free, parse_swapusage(sh("sysctl", "vm.swapusage")), parse_ps(sh("ps", "-axo", "pid=,rss=,comm="))


ADVICE = {"OK": "room for another worker", "WARNING": "memory is getting tight; start further workers only if needed",
          "CRITICAL": "do not start another worker until memory frees up (close idle workers first)",
          "UNKNOWN": "could not read memory; not blocking"}
EXIT = {"OK": 0, "UNKNOWN": 0, "WARNING": 1, "CRITICAL": 2}


def cmd_check(a, reader=read_host):
    free, swap, procs = reader()
    status, reasons = assess(free, swap, a)
    data = {"status": status, "free_pct": free, "swap_used_gb": None if swap is None else round(swap, 2),
            "reasons": reasons, "recommendation": ADVICE[status], **summarize_processes(procs)}
    zedlib.emit(data, a.json, lambda d: [
        f"{d['status']}: {d['recommendation']}",
        f"  free {d['free_pct'] if d['free_pct'] is not None else '?'}% · swap {d['swap_used_gb'] if d['swap_used_gb'] is not None else '?'} GB · "
        f"agents {d['agent_rss_gb']} GB RSS ({', '.join(f'{k} {v}' for k, v in d['agents'].items()) or 'none'})",
        *[f"  ! {r}" for r in d["reasons"]], "  top: " + ", ".join(d["top"])])
    return EXIT[status]


def main(argv=None):
    ap = argparse.ArgumentParser(prog="zed-hostload", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("--json", action="store_true")
    c.add_argument("--warn-free-pct", type=int, default=20)
    c.add_argument("--crit-free-pct", type=int, default=8)
    c.add_argument("--warn-swap-gb", type=float, default=4)
    c.add_argument("--crit-swap-gb", type=float, default=8)
    return cmd_check(ap.parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
