#!/usr/bin/env python3
"""zed-pretool — pre-tool check that keeps the Zed coordinator from doing the work itself. It runs as a Claude Code
PreToolUse hook and, under OpenCode, from the coordinator's plugin (zeddeny.coordinator_plugin), which sends the same
payload with OpenCode's own tool names (shell, edit, write, patch, subagent).

Ported from firstmate's fm-subagent-pretool-check / fm-cd-pretool-check / fm-primary-scope-lib. Prime directive 1:
engineering work is delegated to worker sessions; the coordinator only does bookkeeping in Zed's own repo.
firstmate: Copyright (c) 2026 Kun Chen, MIT licence, see THIRD_PARTY_LICENSES.md.

It acts ONLY in the session that holds the profile's Zed lock (the hook payload's session_id must equal the
lock's agent session). Workers, read-only sessions and every other tool call pass untouched. It is fail-open: a
parse problem or an unexpected payload allows the call.

For the coordinator it denies:
  * Edit / Write / NotebookEdit of a file outside Zed's home, the profile and the temp dirs
  * Bash: git commit/push/rebase/merge/cherry-pick/reset/revert/add/apply/am/tag/stash in a repo outside Zed's home,
    a persistent top-level `cd` outside Zed's home (it silently changes where later commands run), writes
    (`>`, `>>`, rm, mv, cp, touch, mkdir, tee, sed -i, perl -i) to paths outside the allowed roots
  * Agent / Workflow tools (delegate with `bin/zed spawn`; pass --allow-subagents to permit them)
Reads are never blocked. One call is denied in every session: a shell command starting with `zed-pretool-canary`,
which `bin/zed coordinator` uses to prove the OpenCode plugin is live before the session may act as Zed.

Register in .claude/settings.json (hooks.PreToolUse, matcher "*") with command `bin/zed-pretool`.
Test a payload:  echo '<json>' | zed-pretool --explain
"""
import argparse
import json
import os
import re
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zeddeny  # noqa: E402
import zedlib  # noqa: E402
from zedshell import FILE_WRITERS, GIT_WRITE, REDIRECTS, git_target, inside, split_commands, tokens  # noqa: E402


def allowed_roots(zed_home=None, profile=None):
    roots = [zed_home or zedlib.ZED_HOME, profile or zedlib.PROFILE_DIR, Path(tempfile.gettempdir()), Path("/tmp"), Path("/private/tmp"),
             Path("/dev/null"), Path("/dev/stdout"), Path("/dev/stderr")]  # discarding output is not a write
    return [Path(os.path.realpath(r)) for r in roots]


def lock_holder_session(lock_path=None):
    lock = zedlib.read_json(lock_path or zedlib.PROFILE_DIR / ".cache" / "zed.lock", {}) or {}
    return lock.get("agent_session") or lock.get("claude_session")


def bash_problem(cmd, cwd, roots):
    try:
        cmds = split_commands(tokens(cmd))
    except ValueError:
        return None  # unbalanced quotes etc.: fail open
    for words, top in cmds:
        words = [w for w in words if not re.fullmatch(r"\w+=.*", w)] if words and re.fullmatch(r"\w+=.*", words[0]) else words
        if not words:
            continue
        if words[0] == "cd" and top and len(words) > 1 and words[1] != "-" and not inside(words[1], roots, cwd):
            return f"don't `cd` into {words[1]}: it silently changes where later commands run. Use absolute paths or `git -C` for reads, and delegate changes to a worker (bin/zed spawn)."
        if words[0] == "git":
            sub, target = git_target(words, cwd)
            if sub in GIT_WRITE and not inside(target, roots, cwd):
                return f"`git {sub}` in {target}: project repos are changed only by workers (bin/zed spawn). Zed commits only in its own repo."
        for i, w in enumerate(words):
            if w in REDIRECTS and i + 1 < len(words) and not words[i + 1].startswith("&") and not inside(words[i + 1], roots, cwd):
                return f"writing to {words[i + 1]} is outside Zed's repo/profile/tmp: that is a worker's job."
        name = Path(words[0]).name
        in_place = name in ("sed", "perl") and any(re.fullmatch(r"-\w*i\w*", w) or w.startswith("-i") for w in words[1:])
        if name in FILE_WRITERS or in_place:
            for w in words[1:]:
                if not w.startswith("-") and (os.path.isabs(os.path.expanduser(w)) or w.startswith("~")) and not inside(w, roots, cwd):
                    return f"`{name}` on {w}: outside Zed's repo/profile/tmp. Project files are changed by workers (bin/zed spawn)."
    return None


CANARY_COMMAND = "zed-pretool-canary"  # no such program: the call exists only to be denied
SUBAGENT_TOOLS = zeddeny.SUBAGENT_TOOLS | {"workflow"}


def decide(payload, holder=None, roots=None, allow_subagents=False):
    """Reason to deny this tool call, or None to allow it. Tool names are compared in lower case, so Claude Code's
    (`Bash`, `Edit`) and OpenCode's (`shell`, `edit`, `patch`) are checked alike."""
    tool, inp, cwd = str(payload.get("tool_name", "")).lower(), payload.get("tool_input") or {}, payload.get("cwd") or os.getcwd()
    shell = tool in zeddeny.SHELL_TOOLS and isinstance(inp, dict)
    if shell and str(inp.get("command", "")).split()[:1] == [CANARY_COMMAND]:
        return f"canary: `{inp['command'].strip()}` is denied in every session, so the coordinator guard is live"
    holder = holder if holder is not None else lock_holder_session()
    if not holder or payload.get("session_id") != holder:
        return None  # not the coordinator
    roots = roots or allowed_roots()
    if tool in zeddeny.EDIT_TOOLS:
        for path in zeddeny.edit_paths(inp):
            if not inside(path, roots, cwd):
                return f"{path} is outside Zed's repo, profile and temp dirs. Zed does not edit project files: put it in a brief and spawn a worker (bin/zed spawn)."
    elif shell:
        if inp.get("workdir"):  # OpenCode's shell runs in `workdir`, relative to the session's directory
            cwd = os.path.join(cwd, os.path.expanduser(inp["workdir"]))
        return bash_problem(inp.get("command", ""), cwd, roots)
    elif tool in SUBAGENT_TOOLS and not allow_subagents:
        return "Zed delegates engineering work to worker sessions in herdr (bin/zed spawn), not to in-process subagents."
    return None


def main(argv=None):
    ap = argparse.ArgumentParser(prog="zed-pretool", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--allow-subagents", action="store_true")
    ap.add_argument("--explain", action="store_true", help="print the decision in words instead of hook JSON")
    a = ap.parse_args(argv)
    try:
        reason = decide(json.load(sys.stdin), allow_subagents=a.allow_subagents)
    except Exception:  # fail open: a guard bug must never brick the coordinator
        return 0
    if a.explain:
        print(f"deny: {reason}" if reason else "allow")
    elif reason:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": f"zed-pretool: {reason}"}}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
