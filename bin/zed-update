#!/usr/bin/env python3
"""zed-update — report and apply core updates from `main` onto the profile branch, no model.

Ported from firstmate's fm-update / fm-ff-lib. Zed's rule (CLAUDE.md): get core updates with `git merge main`
after updating main. This does exactly that, safely: it refuses on `main`, with uncommitted changes, or when a
trial merge would conflict. It never pushes.

Usage
  zed-update check [--no-fetch] [--remote origin] [--json]
      commits on main (after fetching it) that this branch does not have yet; exit 0 up to date, 1 updates waiting
  zed-update apply [--remote origin]
      fast-forward local main from the remote, then merge main into the current branch; exit 0 merged / up to date,
      2 refused (reason printed)
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zedlib  # noqa: E402

HOME = zedlib.ZED_HOME


def g(*args, timeout=120):
    return zedlib.git(HOME, *args, timeout=timeout)


def state(remote, fetch):
    notes = []
    if fetch:
        r = g("fetch", "--quiet", remote, "main:main") if g("symbolic-ref", "--short", "HEAD").stdout.strip() != "main" else g("fetch", "--quiet", remote, "main")
        if not r.ok:
            notes.append(f"fetch failed: {(r.stderr or r.stdout).strip()[:120]}")
    branch = g("symbolic-ref", "--short", "-q", "HEAD").stdout.strip()
    pending = g("log", "--format=%h %s", "HEAD..main").stdout.splitlines() if g("rev-parse", "--verify", "--quiet", "main").ok else []
    dirty = bool(g("status", "--porcelain").stdout.strip())
    conflict = None
    if pending:
        mt = g("merge-tree", "--write-tree", "HEAD", "main")
        conflict = mt.returncode == 1
    return {"branch": branch, "pending": pending, "dirty": dirty, "would_conflict": conflict, "notes": notes}


def refusal(st):
    if st["branch"] == "main":
        return "on main: core updates are merged into the profile branch, never into main"
    if not st["branch"]:
        return "detached HEAD"
    if st["dirty"]:
        return "uncommitted changes: commit or discard them first"
    if st["would_conflict"]:
        return "a trial merge conflicts; merge main by hand"
    return None


def cmd_check(a):
    st = state(a.remote, not a.no_fetch)
    zedlib.emit(st, a.json, lambda d: (
        [f"{len(d['pending'])} core commit(s) on main not in {d['branch'] or 'HEAD'}"
         + ("; merge would conflict" if d["would_conflict"] else "")]
        + ["  " + ln for ln in zedlib.cap_lines(d["pending"], 15)] if d["pending"] else [f"up to date with main ({d['branch']})"]) + ["  note: " + n for n in d["notes"]])
    return 1 if st["pending"] else 0


def cmd_apply(a):
    st = state(a.remote, True)
    why = refusal(st)
    if why:
        print(f"zed-update: refused: {why}", file=sys.stderr)
        return 2
    if not st["pending"]:
        print(f"up to date with main ({st['branch']})")
        return 0
    r = g("merge", "--no-edit", "main")
    if not r.ok:
        g("merge", "--abort")
        print(f"zed-update: merge failed and was aborted: {(r.stderr or r.stdout).strip()[:200]}", file=sys.stderr)
        return 2
    print(f"merged {len(st['pending'])} core commit(s) from main into {st['branch']}")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="zed-update", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("--no-fetch", action="store_true")
    c.add_argument("--json", action="store_true")
    for p in (c, sub.add_parser("apply")):
        p.add_argument("--remote", default="origin")
    a = ap.parse_args(argv)
    return {"check": cmd_check, "apply": cmd_apply}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
