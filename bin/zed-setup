#!/bin/sh
# zed-setup — check Zed's prerequisites and install its git guard hooks. Safe to re-run.
cd "$(dirname "$0")/.." || exit 1
missing=0
for tool in herdr git gh python3; do
  if command -v "$tool" >/dev/null 2>&1; then
    echo "ok       $tool"
  else
    echo "MISSING  $tool"; missing=1
  fi
done
# An install runs on one runtime, Claude Code or OpenCode: one of them is enough.
runtimes=0
for runtime in claude opencode; do
  if command -v "$runtime" >/dev/null 2>&1; then
    echo "ok       $runtime ($("$runtime" --version 2>/dev/null | head -n 1))"; runtimes=$((runtimes + 1))
  fi
done
if [ "$runtimes" -eq 0 ]; then
  echo "MISSING  a runtime: claude (Claude Code) or opencode (OpenCode)"; missing=1
fi

current=$(git config --get core.hooksPath)
if [ -n "$current" ] && [ "$current" != hooks ]; then
  echo "WARNING  core.hooksPath is '$current'; not changing it. Zed's guard hooks are in hooks/." >&2
else
  for h in .git/hooks/*; do
    case "$h" in *.sample|'.git/hooks/*') ;; *) [ -f "$h" ] && echo "note     $h will no longer run (core.hooksPath=hooks)";; esac
  done
  git config core.hooksPath hooks && echo "ok       git guard hooks installed (core.hooksPath=hooks)"
fi

profile="${ZED_PROFILE_DIR:-$PWD/profile}"  # where bin/zed looks for it
if [ -f "$profile/profile.md" ]; then
  echo "ok       profile present at $profile (branch: $(git branch --show-current))"
  echo "runtime  $(ZED_PROFILE_DIR="$profile" bin/zed runtime --set-installed)"
else
  echo "note     no profile yet: start Zed here (inside herdr) and it will onboard you: 'claude' on Claude Code,"
  echo "         'bin/zed coordinator' on OpenCode (now: $(ZED_PROFILE_DIR="$profile" bin/zed runtime))"
fi
exit $missing
