#!/usr/bin/env python3
"""zed-deny — PreToolUse hook that enforces a hat's policy (the `deny` block of its capabilities.json).

Runs as a Claude Code hook (`--settings`; spawn writes the file). It acts only in a
session that has ZED_HAT in its environment; every other session passes untouched. It reads the hook
JSON on stdin and, to deny, writes the reason to stderr and exits 2 (Claude Code blocks on that and shows the reason
to the model). An unknown hat allows the call (no policy); any other internal error denies it (fails closed).

It denies, per the hat: edits matching `deny.edit` (`**` = nothing in the worktree), shell commands starting with a
`deny.commands` prefix, shell writes (redirects, rm/mv/cp/tee..., sed -i) to a denied path, git writes in the worktree
for a hat that may not edit (the worktree, and the checkout holding the profile), subagents when `subagents` is `none`;
`deny.except` globs stay writable inside a denied area (review/qa: their plan,
findings draft and status log); a command starting with a `deny.gated` prefix (`gh pr create`) runs only once
`bin/zed gate check HEAD` passes.
Not caught: a worker that deliberately routes around the hook through another program: a script that writes files
itself (python -c ...), or under OpenCode the server's terminal route or a server it starts. The guard prevents
mistakes; it is not a sandbox. `bin/zed-guard` still guards git.

Test:  echo '{"tool_name":"Bash","tool_input":{"command":"gh pr comment 1"}}' | ZED_HAT=review zed-deny --explain
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import zeddeny  # noqa: E402
import zedemployee as emp  # noqa: E402
import zedlib  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(prog="zed-deny", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--explain", action="store_true", help="print the decision in words and exit 0")
    a = ap.parse_args(argv)
    hat = os.environ.get("ZED_HAT")
    if not hat:
        return 0
    try:
        manifest = emp.load_manifest(hat)
    except emp.HatError:
        return 0  # an unknown hat has no policy to enforce
    try:
        payload = json.load(sys.stdin)
        worktree = os.environ.get("ZED_WORKTREE") or payload.get("cwd") or os.getcwd()
        reason = zeddeny.decide(payload, manifest, worktree, zedlib.PROFILE_DIR)
    except Exception as e:  # fail closed: a call the hook cannot read is not allowed
        reason = f"the call could not be checked ({type(e).__name__}: {e}), so it is denied"
    if a.explain:
        print(f"deny: {reason}" if reason else "allow")
        return 0
    if reason:
        print(f"zed-deny: {reason}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
