#!/usr/bin/env python3
"""hw-review — the mechanical half of a code review, and a check on the findings draft. No model, read-only.

Usage
  hw-review prep <pr-url> [--json]
  hw-review prep --dir PATH --base BRANCH [--json]      a local branch (any host): `git diff BASE...HEAD` in PATH
  hw-review prep --diff FILE [--json]                    a saved unified diff
      the facts section of a review: diff stats; source files changed with no test change; added lines that look
      like debug leftovers (console.log, print(, debugger, breakpoint, TODO/FIXME, commented-out code); new
      dependencies; migrations; functions with a large change; secret-looking added lines (name and place only,
      never the value); CI state (PR url only, via hw-pr). The checks that read the diff are heuristics: they say
      where to look, the reviewer decides. exit 0 facts printed, 2 the diff could not be read
  hw-review check-draft <file> [--json]
      refuses a review draft that has a finding without `file:line`, a severity or a suggested change, a blocker
      without its ground, no verdict, a verdict that contradicts the findings, or anything addressed to a PR (the
      draft is for Herdwright, never posted). Only an objective failure is a blocker, so each one names its ground:
      `requirement` (where the repository has tests, a requirement without a passing test; or a failing required
      check), `bug` (a logic bug shown with a failing input) or `rule <n>` (a code rule that fails its check). Whether
      the ground is true, and whether rule <n> exists, is the reviewer's judgement; that it is named is checked.
      Draft shape:
        - [blocker] path/file.py:42 what is wrong. Ground: requirement | bug | rule <n>. Fix: the change that would fix it
        - [should-fix|nit] path/file.py:10 what would improve. Fix: the change
        Verdict: clean | blockers
      exit 0 ok, 1 problems listed, 2 no such file
"""
import argparse
import json
import re
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import hwlib  # noqa: E402

BIN = Path(__file__).resolve().parent
LARGE_CHANGE_LINES = 50     # changed lines inside one function (from the hunk header) before it is flagged
SHOW = 12                   # items listed per fact before "N more"

TEST_PATH = re.compile(r"(^|/)(tests?|__tests__|spec|specs|e2e|cypress)/|[._-](test|spec)\.\w+$|(^|/)test_[^/]+$|_test\.\w+$", re.I)
NON_SOURCE = re.compile(r"\.(md|txt|rst|json|ya?ml|toml|lock|svg|png|jpe?g|gif|ico|css|scss|snap|csv)$|\.d\.ts$|(^|/)Dockerfile[\w.-]*$|(^|/)(docs?|fixtures?)/|(^|/)\.", re.I)
MIGRATION_PATH = re.compile(r"(^|/)(migrations?|alembic|flyway|db/migrate)/|\.sql$", re.I)
DEP_FILES = {"package.json": "npm", "requirements.txt": "pip", "pyproject.toml": "python", "Pipfile": "pip",
             "go.mod": "go", "Cargo.toml": "cargo", "pom.xml": "maven", "build.gradle": "gradle", "Gemfile": "gem"}
DEBUG_PATTERNS = [
    ("console.log", re.compile(r"\bconsole\.(log|debug)\s*\(")),
    ("print(", re.compile(r"(?<![\w.])print\s*\(")),
    ("debugger", re.compile(r"\bdebugger\b|\bbreakpoint\s*\(\)|\bpdb\.set_trace\s*\(|\bimport pdb\b")),
    ("TODO/FIXME", re.compile(r"\b(TODO|FIXME|XXX|HACK)\b")),
]
COMMENTED_CODE = re.compile(r"^\s*(//|#)\s*(?:[\w.\[\]]+\s*=[^=]|(?:if|for|while|return|import|from|def|class|const|let|var)\b.*[:;{(]\s*$|[\w.]+\(.*\)\s*;?\s*$)")
SHEBANG_OR_DIRECTIVE = re.compile(r"^\s*#(!|\s*(noqa|type:|pragma|region|endregion|eslint|prettier|pylint|fmt:|isort))", re.I)


def parse_diff(diff):
    """[{'path', 'added': [(line_no, text)], 'removed': [text], 'funcs': {name: changed lines}, 'new': bool, 'deleted': bool}]."""
    files, cur, new_line, func = [], None, 0, None
    for raw in diff.splitlines():
        if raw.startswith("diff --git "):
            m = re.match(r"diff --git a/(.*) b/(.*)$", raw)
            cur = {"path": m.group(2) if m else raw[11:], "added": [], "removed": [], "funcs": {}, "new": False, "deleted": False}
            files.append(cur)
            func = None
        elif cur is None:
            continue
        elif raw.startswith("new file mode"):
            cur["new"] = True
        elif raw.startswith("deleted file mode"):
            cur["deleted"] = True
        elif raw.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@ ?(.*)$", raw)
            new_line, func = (int(m.group(1)), m.group(2).strip() or None) if m else (0, None)
        elif raw.startswith("+++") or raw.startswith("---"):
            continue
        elif raw.startswith("+"):
            cur["added"].append((new_line, raw[1:]))
            new_line += 1
            if func:
                cur["funcs"][func] = cur["funcs"].get(func, 0) + 1
        elif raw.startswith("-"):
            cur["removed"].append(raw[1:])
            if func:
                cur["funcs"][func] = cur["funcs"].get(func, 0) + 1
        elif raw.startswith(" "):
            new_line += 1
    return files


def is_test(path):
    return bool(TEST_PATH.search(path))


def is_source(path):
    return not is_test(path) and not NON_SOURCE.search(path) and not MIGRATION_PATH.search(path)


def files_without_test(files):
    """Source files changed with no test change next to them: no test file in the diff at all, or none whose name
    mentions this file's stem (user_service.py ~ test_user_service.py, UserService.test.ts)."""
    tests = [Path(f["path"]).stem.lower().replace("test_", "").replace("_test", "").replace(".test", "").replace(".spec", "")
             for f in files if is_test(f["path"])]
    out = []
    for f in files:
        if not is_source(f["path"]) or f["deleted"]:
            continue
        stem = Path(f["path"]).stem.lower()
        if not any(stem in t or t in stem for t in tests if t):
            out.append(f["path"])
    return out


def debug_leftovers(files):
    out = []
    for f in files:
        if is_test(f["path"]) or f["path"].endswith((".md", ".rst", ".txt")):
            continue
        for n, text in f["added"]:
            kind = next((name for name, rx in DEBUG_PATTERNS if rx.search(text)), None)
            if not kind and COMMENTED_CODE.match(text) and not SHEBANG_OR_DIRECTIVE.match(text):
                kind = "commented-out code"
            if kind:
                out.append({"file": f["path"], "line": n, "kind": kind, "text": text.strip()[:100]})
    return out


def dep_name(line, manager):
    line = line.strip()
    if manager == "npm":
        m = re.match(r'"(@?[\w./-]+)"\s*:\s*"[^"]*"\s*,?$', line)
        return m.group(1) if m and not re.match(r'(name|version|description|main|scripts?|license|private|type)$', m.group(1)) else None
    m = re.match(r"([A-Za-z0-9_.-]+)\s*(?:[=<>~!^\[;].*|=\s*.*)?$", line)
    if manager == "go":
        m = re.match(r"(?:require\s+)?([\w.-]+\.[\w./-]+)\s+v[\w.+-]+", line)
    return m.group(1) if m and not line.startswith(("#", "[", "//")) else None


def new_dependencies(files):
    out = []
    for f in files:
        manager = DEP_FILES.get(Path(f["path"]).name)
        if not manager and not re.fullmatch(r"requirements[\w.-]*\.txt", Path(f["path"]).name):
            continue
        manager = manager or "pip"
        added = {dep_name(t, manager) for _, t in f["added"]} - {None}
        removed = {dep_name(t, manager) for t in f["removed"]} - {None}
        out += [{"file": f["path"], "name": n, "manager": manager} for n in sorted(added - removed)]
    return out


def large_changes(files):
    return [{"file": f["path"], "function": name, "changed": n} for f in files if not is_test(f["path"])
            for name, n in sorted(f["funcs"].items()) if n >= LARGE_CHANGE_LINES]


def secrets(files):
    out = []
    for f in files:
        for n, text in f["added"]:
            kind = hwlib.find_secret(text)
            if kind:
                out.append({"file": f["path"], "line": n, "kind": kind})  # never the value
    return out


def analyze(diff):
    files = parse_diff(diff)
    return {"files": len(files), "added": sum(len(f["added"]) for f in files), "removed": sum(len(f["removed"]) for f in files),
            "biggest": [{"file": f["path"], "added": len(f["added"]), "removed": len(f["removed"])}
                        for f in sorted(files, key=lambda f: -(len(f["added"]) + len(f["removed"])))[:5]],
            "tests_changed": [f["path"] for f in files if is_test(f["path"])],
            "source_without_test": files_without_test(files),
            "debug_leftovers": debug_leftovers(files),
            "new_dependencies": new_dependencies(files),
            "migrations": [f["path"] for f in files if MIGRATION_PATH.search(f["path"])],
            "large_changes": large_changes(files),
            "secrets": secrets(files)}


def render_facts(d):
    def listing(title, items, fmt):
        if not items:
            return [f"{title}: none"]
        return [f"{title}: {len(items)}"] + ["  " + fmt(i) for i in items[:SHOW]] + ([f"  ... {len(items) - SHOW} more"] if len(items) > SHOW else [])
    lines = [f"Diff: {d['files']} file(s), +{d['added']} -{d['removed']}; tests changed: {len(d['tests_changed'])}"]
    lines += ["  largest: " + ", ".join(f"{b['file']} (+{b['added']} -{b['removed']})" for b in d["biggest"])] if d["biggest"] else []
    lines += listing("Source files with no test change (heuristic: no changed test file names them)", d["source_without_test"], str)
    lines += listing("Debug leftovers in added lines", d["debug_leftovers"], lambda i: f"{i['file']}:{i['line']} {i['kind']}: {i['text']}")
    lines += listing("New dependencies", d["new_dependencies"], lambda i: f"{i['file']}: {i['name']} ({i['manager']})")
    lines += listing("Migrations", d["migrations"], str)
    lines += listing(f"Functions with {LARGE_CHANGE_LINES}+ changed lines (from hunk headers)", d["large_changes"],
                     lambda i: f"{i['file']}: {i['function']} ({i['changed']} lines)")
    lines += listing("Secret-looking added lines (values not shown)", d["secrets"], lambda i: f"{i['file']}:{i['line']} {i['kind']}")
    ci = d.get("ci")
    lines += [f"CI: {ci}"] if ci else []
    return hwlib.cap_lines(lines, limit=100)


def load_hw_pr():
    return SourceFileLoader("hw_pr", str(BIN / "hw-pr")).load_module()


def fetch_diff(url):
    """The PR's diff text, through `gh`."""
    hw_pr = load_hw_pr()
    try:
        hw_pr.require_github_pr_url(url)
    except hw_pr.PrLookupError as e:
        raise RuntimeError(str(e))
    r = hwlib.run_bounded(["gh", "pr", "diff", url], timeout=90)
    if not r.ok:
        raise RuntimeError(f"gh pr diff failed: {(r.stderr or r.stdout).strip()[:300]}")
    return r.stdout


def ci_line(url):
    hw_pr = load_hw_pr()
    try:
        return hw_pr.render_state(hw_pr.fetch(url))[0]
    except Exception as e:  # CI is one fact among many; a failed lookup must not hide the rest
        return f"unknown ({e})"


def cmd_prep(a):
    ci = None
    try:
        if a.diff:
            diff = Path(a.diff).read_text()
        elif a.dir:
            if not a.base:
                raise RuntimeError("--dir needs --base")
            r = hwlib.git(a.dir, "diff", f"{a.base}...HEAD", timeout=60)
            if not r.ok:
                raise RuntimeError(f"git diff failed: {r.stderr.strip()[:300]}")
            diff = r.stdout
        elif a.pr:
            diff, ci = fetch_diff(a.pr), ci_line(a.pr)
        else:
            raise RuntimeError("give a PR url, --dir and --base, or --diff FILE")
    except (RuntimeError, OSError) as e:
        print(f"hw-review: {e}", file=sys.stderr)
        return 2
    facts = analyze(diff)
    if ci:
        facts["ci"] = ci
    hwlib.emit(facts, a.json, render_facts)
    return 0


SEVERITIES = ("blocker", "should-fix", "nit")
FINDING = re.compile(r"^\s*(?:[-*]|\d+[.)])\s*\[(?P<sev>[^\]]*)\]\s*(?P<rest>.*)$")
LOCATION = re.compile(r"[\w@./\\-]+\.\w+:\d+")
GROUND = re.compile(r"\bground(?:\*\*)?\s*:\s*(?:\*\*)?\s*(?:requirement|bug|rule\s+\d+)\b", re.I)  # the objective failures that may block
SUGGESTION = re.compile(r"\b(fix|suggest(?:ion|ed)?|change to|replace with|instead)\s*:", re.I)
VERDICT = re.compile(r"^\s*(?:\*\*)?verdict(?:\*\*)?\s*:\s*(?:\*\*)?(\S+?)(?:\*\*)?\s*$", re.I)
OUTWARD = re.compile(r"\bgh\s+pr\b|/pulls?/\d+/(?:reviews|comments)|^\s*/(?:approve|lgtm)\b", re.I | re.M)


def check_draft(text):
    """{'problems': [...], 'findings': n, 'verdict': 'clean'|'blockers'|None}; no problems means the draft is ready for Herdwright."""
    problems, findings, current = [], [], None
    for n, line in enumerate(text.splitlines(), 1):
        m = FINDING.match(line)
        if m:
            current = {"line": n, "sev": m.group("sev").strip().lower(), "text": m.group("rest")}
            findings.append(current)
        elif current and line.strip() and line.startswith((" ", "\t")):
            current["text"] += " " + line.strip()   # an indented continuation belongs to the finding above
        else:
            current = None
    for f in findings:
        where = f"finding on line {f['line']}"
        if f["sev"] not in SEVERITIES:
            problems.append(f"{where}: severity must be one of {', '.join(SEVERITIES)} (got '{f['sev'] or 'empty'}')")
        if not LOCATION.search(f["text"]):
            problems.append(f"{where}: no file:line (like app/guard.py:42)")
        if f["sev"] == "blocker" and not GROUND.search(f["text"]):
            problems.append(f"{where}: a blocker names its ground (write 'Ground: requirement', 'Ground: bug' or 'Ground: rule <n>')")
        if not SUGGESTION.search(f["text"]):
            problems.append(f"{where}: no suggested change (write 'Fix: ...')")
    verdicts = [(n, m.group(1).lower()) for n, m in ((n, VERDICT.match(ln)) for n, ln in enumerate(text.splitlines(), 1)) if m]
    verdict = None
    if not verdicts:
        problems.append("no verdict (write 'Verdict: clean' or 'Verdict: blockers')")
    elif len(verdicts) > 1:
        problems.append(f"{len(verdicts)} verdict lines; write exactly one")
    elif verdicts[0][1] not in ("clean", "blockers"):
        problems.append(f"verdict must be 'clean' or 'blockers' (got '{verdicts[0][1]}')")
    else:
        verdict = verdicts[0][1]
        has_blocker = any(f["sev"] == "blocker" for f in findings)
        if verdict == "clean" and has_blocker:
            problems.append("verdict is clean but a finding is a blocker")
        if verdict == "blockers" and not has_blocker:
            problems.append("verdict is blockers but no finding is a blocker")
    for n, line in enumerate(text.splitlines(), 1):
        if OUTWARD.search(line):
            problems.append(f"line {n}: addressed to a PR or reviewer tool ({line.strip()[:60]}); the draft is for Herdwright, never posted")
    return {"problems": problems, "findings": len(findings), "verdict": verdict}


def cmd_check_draft(a):
    path = Path(a.file)
    if not path.is_file():
        print(f"hw-review: no such file: {a.file}", file=sys.stderr)
        return 2
    result = check_draft(path.read_text())
    hwlib.emit(result, a.json, lambda d: [f"{path.name}: " + ("ok" if not d["problems"] else f"{len(d['problems'])} problem(s)")
                                           + f" ({d['findings']} finding(s), verdict {d['verdict'] or 'missing'})"]
                + ["  - " + p for p in hwlib.cap_lines(d["problems"], 20)])
    return 1 if result["problems"] else 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="hw-review", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    prep = sub.add_parser("prep")
    prep.add_argument("pr", nargs="?")
    prep.add_argument("--dir")
    prep.add_argument("--base")
    prep.add_argument("--diff")
    prep.add_argument("--json", action="store_true")
    chk = sub.add_parser("check-draft")
    chk.add_argument("file")
    chk.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    return cmd_prep(a) if a.cmd == "prep" else cmd_check_draft(a)


if __name__ == "__main__":
    sys.exit(main())
