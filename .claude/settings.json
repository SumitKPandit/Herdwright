{
  "permissions": {
    "allow": [
      "Bash(bin/zed:*)",
      "Bash(./bin/zed:*)",
      "Bash(bin/zed-setup:*)",
      "Bash(herdr agent:*)",
      "Bash(herdr pane read:*)",
      "Bash(herdr pane list:*)",
      "Bash(herdr workspace list:*)",
      "Bash(herdr status:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/zed hook stop-guard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/zed hook arm",
            "asyncRewake": true,
            "timeout": 28800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/zed-pretool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
