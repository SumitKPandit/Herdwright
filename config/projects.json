{
  "code_root": "~/codebase/mention",
  "worktree_root": "~/codebase/mention/.worktrees",
  "jira_project": "MENT",
  "repos": {
    "onclusive-core-client": {
      "path": "~/codebase/mention/onclusive-core-client",
      "app": "360",
      "role": "360 frontend",
      "host": "github",
      "dev_base": "main",
      "branches": {
        "main": "staging; base for new dev",
        "deploy": "production",
        "feat/mfe-unified-shell": "360 integration with unified-fe"
      }
    },
    "green-lantern": {
      "path": "~/codebase/mention/green-lantern",
      "app": "360",
      "role": "360 backend",
      "host": "github",
      "dev_base": "velocity-build",
      "branches": {
        "velocity-build": "staging; base for new dev",
        "velocity-deploy": "production"
      }
    },
    "cm-reports": {
      "path": "~/codebase/mention/cm-reports",
      "app": "shared",
      "role": "reports module shared by CM and 360",
      "host": "github",
      "dev_base": null,
      "branches": {
        "main": "linked into cm-fe for CM reports",
        "medusa": "consumed by 360; dist built and pushed into onclusive-core-client"
      },
      "dev_base_rule": "CM change \u2192 main; 360 change \u2192 medusa (then dist goes into onclusive-core-client)"
    },
    "cm-fe": {
      "path": "~/codebase/mention/cm-fe",
      "app": "cm",
      "role": "CM frontend",
      "host": "github",
      "dev_base": "releases/v4.44.1",
      "dev_base_rule": "releases/vX.Y.Z; confirm current one from recent PRs",
      "branches": {}
    },
    "cm-api": {
      "path": "~/codebase/mention/cm-api",
      "app": "cm",
      "role": "CM backend",
      "host": "bitbucket",
      "dev_base": "releases/v6.2.1",
      "dev_base_rule": "releases/vX.Y.Z; confirm current one from recent PRs",
      "branches": {}
    },
    "cm_db": {
      "path": "~/codebase/mention/cm_db",
      "app": "cm",
      "role": "DB procedures used by cm-api",
      "host": "bitbucket",
      "dev_base": "master",
      "branches": {}
    },
    "unified-fe": {
      "path": "~/codebase/mention/unified-fe",
      "app": "unified",
      "role": "microfrontend shell bringing CM and 360 together",
      "host": "github",
      "dev_base": "main",
      "branches": {
        "main": "base for new dev"
      }
    },
    "cm-lib": {
      "path": "~/codebase/mention/cm-lib/master",
      "app": "cm",
      "role": "business rules library used by cm-api (Python)",
      "host": "bitbucket",
      "dev_base": "master",
      "branches": {}
    },
    "claim": {
      "path": "~/codebase/mention/claim",
      "app": "platform",
      "role": "CLAIM: Auth0 user/account/identity management service",
      "host": "github",
      "dev_base": "main",
      "branches": {}
    },
    "gum": {
      "path": "~/codebase/mention/gum",
      "app": "platform",
      "role": "GUM: global Auth0 user management service",
      "host": "github",
      "dev_base": "main",
      "branches": {}
    },
    "prompt-library": {
      "path": "~/codebase/mention/prompt-library",
      "app": "tooling",
      "role": "team agentic-engineering prompts/skills",
      "host": "github",
      "dev_base": "main",
      "branches": {}
    },
    "zed": {
      "path": "~/codebase/zed",
      "app": "zed",
      "role": "Zed itself (this assistant's repo)",
      "host": "github",
      "dev_base": "main",
      "branches": {
        "main": "core: shareable capabilities only (planned)"
      }
    }
  },
  "non_git_folders": {
    "unified-mention": "~/codebase/mention/unified-mention (plans for the single Mention app)",
    "iac": "~/codebase/mention/iac (360 infra research for DR plan)"
  }
}
