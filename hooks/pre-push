#!/bin/sh
# Herdwright guard (installed by bin/hw-setup): never push a main whose tree contains profile/
# (e.g. after a fast-forward onto a profile branch, which no commit hook sees).
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ -n "$(git ls-tree -d "$local_sha" profile)" ]; then
    echo "hw guard: refusing to push $local_ref to main: its tree contains profile/ (main is core only)." >&2
    exit 1
  fi
done
exit 0
